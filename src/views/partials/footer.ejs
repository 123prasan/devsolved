<style>
    .footer {
        margin-top: auto;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: radial-gradient(100% 100% at 50% 100%, rgba(255, 255, 255, 0.02) 0%, transparent 100%);
        padding: 80px 24px 32px;
        font-family: 'Inter', sans-serif;
    }

    .footer-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .footer-top {
        display: grid;
        grid-template-columns: 320px 1fr;
        gap: 64px;
        margin-bottom: 64px;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 600;
        letter-spacing: -0.3px;
        color: #FFFFFF;
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .brand-logo:hover {
        opacity: 0.8;
    }

    .brand-logo .brand-logo-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        display: block;
        transition: transform 0.2s ease;
    }

    .brand-logo:hover .brand-logo-img {
        transform: scale(1.05);
    }

    .brand-tagline {
        font-size: 14px;
        color: #A1A1AA;
        line-height: 1.6;
    }

    .social-links {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 8px;
    }

    .social-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        color: #A1A1AA;
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        text-decoration: none;
    }

    .social-link:hover {
        color: #FFFFFF;
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-2px);
    }

    .footer-links {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
    }

    .link-column {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .link-heading {
        font-size: 13px;
        font-weight: 600;
        color: #FFFFFF;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .link-item {
        font-size: 14px;
        color: #A1A1AA;
        text-decoration: none;
        transition: color 0.2s ease;
        width: fit-content;
    }

    .link-item:hover {
        color: #FFFFFF;
    }

    .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 32px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .copyright {
        font-size: 13px;
        color: #62626C;
    }

    @media (max-width: 960px) {
        .footer-top {
            grid-template-columns: 1fr;
            gap: 48px;
        }

        .footer-brand {
            max-width: 400px;
        }
    }

    @media (max-width: 640px) {
        .footer {
            padding: 64px 20px 24px;
        }

        .footer-links {
            grid-template-columns: repeat(2, 1fr);
            gap: 40px 24px;
        }
    }

    @media (max-width: 480px) {
        .footer-links {
            grid-template-columns: 1fr;
        }
    }
</style>

<footer class="footer">
    <div class="footer-container">
        <div class="footer-top">
            <div class="footer-brand">
                <a href="/" class="brand-logo" aria-label="DevSolved Home">
                    <img src="/images/devsolved.svg" alt="DevSolved Logo" class="brand-logo-img">
                    <span>DevSolved</span>
                </a>
                <p class="brand-tagline">Document your war stories, share exact solutions, and help the community solve
                    the un-Googleable problems.</p>
                <div class="social-links">
                    <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-link"
                        aria-label="GitHub">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                            <path d="M9 18c-4.51 2-5-2-7-2" />
                        </svg>
                    </a>
                    <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-link"
                        aria-label="Twitter">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z" />
                        </svg>
                    </a>
                    <a href="#" class="social-link" aria-label="Discord">
                        <i data-lucide="message-square" style="width: 20px;"></i>
                    </a>
                    <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-link"
                        aria-label="LinkedIn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                            <rect width="4" height="12" x="2" y="9" />
                            <circle cx="4" cy="4" r="2" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="footer-links">
                <div class="link-column">
                    <h4 class="link-heading">Platform</h4>
                    <a href="/" class="link-item">Explore Feed</a>
                    <a href="/write" class="link-item">Write Incident</a>
                    <a href="/tags" class="link-item">Trending Tags</a>
                    <a href="/leaderboard" class="link-item">Top Solvers</a>
                </div>
                <div class="link-column">
                    <h4 class="link-heading">Resources</h4>
                    <a href="/docs" class="link-item">Documentation</a>
                    <a href="/api-docs" class="link-item">Developer API</a>
                    <a href="/guidelines" class="link-item">Writing Guidelines</a>
                    <a href="/help" class="link-item">Help Center</a>
                </div>
                <div class="link-column">
                    <h4 class="link-heading">Legal</h4>
                    <a href="/privacy" class="link-item">Privacy Policy</a>
                    <a href="/terms" class="link-item">Terms of Service</a>
                    <a href="/cookies" class="link-item">Cookie Policy</a>
                    <a href="/security" class="link-item">Security</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p class="copyright">&copy; <%= new Date().getFullYear() %> DevSolved Inc. All rights reserved.</p>
        </div>
    </div>
</footer>