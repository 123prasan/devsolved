                            onclick="insertMarkdown('link', 'reply-input-<%= comment._id %>', event)"
                            title="Insert Link"></i>
                          <i data-lucide="image"
                            onclick="insertMarkdown('image', 'reply-input-<%= comment._id %>', event)"
                            title="Embed Image"></i>
