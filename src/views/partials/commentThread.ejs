<% /* Time Formatter */ const timeAgo=(date)=> {
  const seconds = Math.floor((new Date() - new Date(date)) / 1000);
  let interval = seconds / 31536000;
  if (interval > 1) return Math.floor(interval) + ' years ago';
  interval = seconds / 2592000;
  if (interval > 1) return Math.floor(interval) + ' months ago';
  interval = seconds / 86400;
  if (interval > 1) return Math.floor(interval) + ' days ago';
  interval = seconds / 3600;
  if (interval > 1) return Math.floor(interval) + ' hours ago';
  interval = seconds / 60;
  if (interval > 1) return Math.floor(interval) + ' minutes ago';
  return 'just now';
  };
  /* High-Fidelity Markdown & Mention Renderer for Discussion Threads */
  const renderRichComment = (text) => {
  if (!text) return '';
  let html = text.replace(/&/g, '&amp;').replace(/</g, '&lt;' ).replace( />/g, '&gt;');
  html = html.replace(/```([^`]+)```/g, `
  <pre class="ds-comment-pre"><code>$1</code></pre>`);
  html = html.replace(/`([^`]+)`/g, `<code class="ds-inline-code">$1</code>`);
  html = html.replace(/!\[([^\]]*)\]\(([^\)]+)\)/g, `<div class="ds-comment-img-container"><img src="$2" alt="$1"
      class="ds-comment-img" loading="lazy" /><span class="ds-comment-img-alt">$1</span></div>`);
  html = html.replace(/\[([^\]]+)\]\(([^\)]+)\)/g, `<a href="$2" target="_blank" rel="noopener noreferrer"
    class="ds-comment-link">$1 <i data-lucide="external-link"
      style="width:12px;height:12px;display:inline-block;margin-left:2px;vertical-align:-1px;"></i></a>`);
  html = html.replace(/\*\*([^\*]+)\*\*/g, `<strong>$1</strong>`);
  html = html.replace(/\*([^\*]+)\*/g, `<em>$1</em>`);
  html = html.replace(/__([^_]+)__/g, `<u>$1</u>`);
  html = html.replace(/@([a-zA-Z0-9_-]+)/g, `<a href="/u/$1" class="ds-mention-pill">@$1</a>`);
  html = html.replace(/\[Status: Investigating\]/gi, `<span class="ds-status-pill ds-status-investigating"><i
      data-lucide="alert-circle"
      style="width:13px;height:13px;display:inline-block;margin-right:4px;vertical-align:-2px;"></i>Status:
    Investigating</span>`);
  html = html.replace(/\[Status: Resolved\]/gi, `<span class="ds-status-pill ds-status-resolved"><i
      data-lucide="check-circle"
      style="width:13px;height:13px;display:inline-block;margin-right:4px;vertical-align:-2px;"></i>Status:
    Resolved</span>`);
  html = html.replace(/\[Root Cause Verified\]/gi, `<span class="ds-status-pill ds-status-verified"><i
      data-lucide="shield-check"
      style="width:13px;height:13px;display:inline-block;margin-right:4px;vertical-align:-2px;"></i>Root Cause
    Verified</span>`);
  html = html.replace(/\[High Severity\]/gi, `<span class="ds-status-pill ds-status-severity"><i
      data-lucide="alert-triangle"
      style="width:13px;height:13px;display:inline-block;margin-right:4px;vertical-align:-2px;"></i>High
    Severity</span>`);
  html = html.replace(/\[Fix Deployed\]/gi, `<span class="ds-status-pill ds-status-deployed"><i data-lucide="zap"
      style="width:13px;height:13px;display:inline-block;margin-right:4px;vertical-align:-2px;"></i>Fix
    Deployed</span>`);
  return html.trim();
  };
  %>

