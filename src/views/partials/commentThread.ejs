            src="<%= user.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(user.displayName || user.username)}&background=random` %>"
            class="ds-avatar" style="width: 40px; height: 40px; flex-shrink: 0;" alt="Your Avatar">
          <% } %>
            <div class="ds-editor-container" style="flex: 1; margin-bottom: 0;">
              <textarea id="root-comment-input" class="ds-editor-textarea" placeholder="Add comment..."></textarea>
              <div class="ds-editor-toolbar">
                <div class="ds-toolbar-icons">
                  <i data-lucide="bold" onclick="insertMarkdown('bold', 'root-comment-input', event)" title="Bold"></i>
                  <i data-lucide="italic" onclick="insertMarkdown('italic', 'root-comment-input', event)"
                    title="Italic"></i>
                  <i data-lucide="underline" onclick="insertMarkdown('underline', 'root-comment-input', event)"
                    title="Underline"></i>
                  <span style="color: var(--ds-border-faint);">|</span>
                  <i data-lucide="paperclip" onclick="insertMarkdown('link', 'root-comment-input', event)"
                    title="Insert Link"></i>
                  <i data-lucide="image" onclick="insertMarkdown('image', 'root-comment-input', event)"
                    title="Embed Image"></i>
                  <i data-lucide="tag" onclick="insertMarkdown('badge', 'root-comment-input', event)"
                    title="Insert Status Badge"></i>
                  <i data-lucide="at-sign" onclick="insertMarkdown('mention', 'root-comment-input', event)"
                    title="Mention SRE / Developer"></i>
                </div>
                <button onclick="submitReply(null, '<%= post._id %>')" class="ds-btn-submit">Submit</button>
              </div>
            </div>
      </div>

      <!-- Header -->
      <div class="ds-header-row">
        <h2 class="ds-header-title">
          Discussions <span class="ds-count-badge">
            <%= comments ? comments.length : 0 %>
          </span>
        </h2>
        <div class="ds-sort-dropdown">
          <i data-lucide="arrow-up-down" style="width: 14px;"></i> Most recent <i data-lucide="chevron-down"
            style="width: 16px;"></i>
        </div>
      </div>

      <!-- Inject the recursive template -->
      <div class="ds-comments-tree">
        <% if (comments && comments.length> 0) { %>
          <%- include('commentThread', { comments, post, user, isRoot: false }) %>
            <% } %>
      </div>

    </div>

    <% } else { %>

      <% /* --- RECURSIVE COMMENT LOOP --- */ %>
        <% comments.forEach(comment=> { %>
          <div class="ds-comment-thread" id="comment-<%= comment._id %>">

            <div class="ds-comment-node">

              <!-- Avatar -->
              <a href="/u/<%= comment.author.username %>">
                <img
                  src="<%= comment.author.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(comment.author.displayName || comment.author.username)}&background=random` %>"
                  class="ds-avatar" alt="Avatar">
              </a>

              <div class="ds-comment-content">

