      }

      .ds-action-item svg,
      .ds-action-item i {
        width: 16px;
        height: 16px;
        display: inline-block;
        vertical-align: middle;
      }

      /* Active State (Orange like the image) */
      .ds-action-item.ds-active {
        color: #FFFFFF;
      }

      .ds-action-item.ds-active svg {
        fill: #FFFFFF;
      }

      /* --- FLAWLESS CSS THREADING CURVES --- */
      .ds-replies {
        position: relative;
        margin-top: 16px;
        /* 18px centers on parent 36px avatar. 26px provides horizontal space */
        margin-left: 18px;
        padding-left: 26px;
      }

      /* 1. The Perfect Horizontal Curve for EACH child */
      .ds-replies>.ds-comment-thread::before {
        content: '';
        position: absolute;
        /* Reaches up to previous sibling or parent */
        top: -24px;
        /* Stops EXACTLY at the middle of this child's avatar (36px / 2 = 18px) */
        height: 42px;
        left: -26px;
        width: 26px;
        border-left: 2px solid var(--ds-line-color);
        border-bottom: 2px solid var(--ds-line-color);
        border-bottom-left-radius: 12px;
        z-index: 1;
        transition: border-color 0.2s;
      }

      /* 2. The Vertical Trunk connecting siblings (hides on the last child) */
      .ds-replies>.ds-comment-thread:not(:last-child)::after {
        content: '';
        position: absolute;
        /* Starts from the middle of this child's avatar */
        top: 18px;
        /* Stops exactly at bottom to avoid overlap with next sibling's curve */
        bottom: 0px;
        left: -26px;
        border-left: 2px solid var(--ds-line-color);
        z-index: 1;
        transition: border-color 0.2s;
      }

      /* Light up on hover */
      .ds-comment-thread:hover>.ds-comment-node~.ds-replies>.ds-comment-thread::before,
      .ds-comment-thread:hover>.ds-comment-node~.ds-replies>.ds-comment-thread:not(:last-child)::after {
