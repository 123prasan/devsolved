                <div class="ds-comment-actions">

                  <!-- Upvote (Orange if active) -->
                  <button
                    class="ds-action-item ds-upvote-btn <%= user && comment.upvotedBy && comment.upvotedBy.some(id => id.toString() === user._id.toString()) ? 'ds-active' : '' %>"
