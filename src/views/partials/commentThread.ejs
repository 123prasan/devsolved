                        <div style="display: flex; gap: 12px; align-items: center;">
                          <button onclick="closeReplyForm('<%= comment._id %>')"
                            style="background:transparent; border:none; color:var(--ds-text-muted); cursor:pointer; font-weight: 500; font-size: 14px;">Cancel</button>
                          <button onclick="submitReply('<%= comment._id %>', '<%= post._id %>')"
                            class="ds-btn-submit">Submit</button>
                        </div>
                      </div>
                    </div>
                    <% } else { %>
                      <div style="font-size: 14px; color: var(--ds-text-muted); padding-top: 8px;">
                        <a href="/login" style="color: var(--ds-text-primary); font-weight: 600;">Log in</a> to reply.
                      </div>
                      <% } %>
                </div>

              </div>
            </div>

            <!-- Nested Replies Container -->
            <% if (comment.replies && comment.replies.length> 0) { %>
              <div class="ds-replies">
                <%- include('commentThread', { comments: comment.replies, post: post, user: user, isRoot: false }) %>
              </div>
              <% } %>

          </div>
          <% }) %>

            <% } %>

              <% if (typeof isRoot !=='undefined' && isRoot) { %>
                <script>
                  function insertMarkdown(type, targetId, event) {
                    if (event && event.stopPropagation) event.stopPropagation();
                    const el = document.getElementById(targetId);
                    if (!el) return;

                    // Close any open popovers first
                    document.querySelectorAll('.ds-popover-menu').forEach(p => p.remove());

                    let start = el.selectionStart || 0;
                    let end = el.selectionEnd || 0;
                    let text = el.value;
                    let selectedText = text.substring(start, end);
                    let before = text.substring(0, start);
                    let after = text.substring(end, text.length);

                    let replacement = '';
                    let cursorOffset = 0;

                    if (type === 'link') {
                      const url = prompt("Enter destination link URL:", "https://");
                      if (!url || url === "https://") return;
                      const label = prompt("Link label (optional):", selectedText || "Reference Link") || "Link";
                      replacement = `[${label}](${url})`;
                      el.value = before + replacement + after;
                      el.focus();
                      el.setSelectionRange(start + replacement.length, start + replacement.length);
                      return;
                    }

                    if (type === 'image') {
                      const sampleImg = "/images/og-default.png";
                      const url = prompt("Enter Image URL (or click OK for sample architecture diagram):", sampleImg);
                      if (!url) return;
                      const alt = prompt("Caption / description for this image:", selectedText || "Architecture Diagram") || "Diagram";
                      replacement = `\n![${alt}](${url})\n`;
                      el.value = before + replacement + after;
                      el.focus();
                      el.setSelectionRange(start + replacement.length, start + replacement.length);
                      return;
                    }

                    if (type === 'badge' || type === 'emoji') {
                      const toolbar = event ? (event.currentTarget ? event.currentTarget.closest('.ds-editor-toolbar') : null) : null;
                      if (!toolbar) return;
                      const popover = document.createElement('div');
                      popover.className = 'ds-popover-menu';
                      popover.style.display = 'block';
                      popover.style.width = '220px';
                      popover.style.padding = '8px';
                      const badges = ['[Status: Investigating]', '[Status: Resolved]', '[Root Cause Verified]', '[High Severity]', '[Fix Deployed]'];
                      let listHtml = '<div style="display:flex; flex-direction:column; gap:6px;">';
                      badges.forEach(bg => {
                        listHtml += `<button type="button" class="ds-badge-btn" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); color:#fff; font-size:12px; font-weight:600; padding:6px 10px; border-radius:6px; cursor:pointer; text-align:left; transition:all 0.2s;">${bg}</button>`;
                      });
                      listHtml += '</div>';
                      popover.innerHTML = listHtml;
                      toolbar.appendChild(popover);

                      popover.querySelectorAll('.ds-badge-btn').forEach(btn => {
                        btn.addEventListener('click', (e) => {
                          e.stopPropagation();
                          const tagText = btn.innerText + ' ';
                          el.value = el.value.substring(0, el.selectionStart) + tagText + el.value.substring(el.selectionStart);
                          popover.remove();
                          el.focus();
                        });
                      });
                      return;
                    }

                    if (type === 'mention') {
                      const toolbar = event ? (event.currentTarget ? event.currentTarget.closest('.ds-editor-toolbar') : null) : null;
                      if (!toolbar) return;
                      const popover = document.createElement('div');
                      popover.className = 'ds-popover-menu';
                      popover.style.display = 'block';
                      popover.style.left = '80px';
                      popover.style.bottom = '40px';
                      popover.style.width = '250px';
                      popover.style.padding = '8px';

                      popover.innerHTML = `
                        <div style="padding:4px 4px 8px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:6px;">
                          <input type="text" placeholder="Search SRE username..." class="ds-mention-search-input" style="width:100%;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;padding:6px 10px;font-size:12px;outline:none;" />
                        </div>
                        <div class="ds-mention-results" style="max-height:180px;overflow-y:auto;display:flex;flex-direction:column;gap:2px;">
                          <div style="color:#71717A;font-size:12px;padding:8px;text-align:center;">Loading engineers...</div>
                        </div>
                      `;
                      toolbar.appendChild(popover);
                      const searchInput = popover.querySelector('.ds-mention-search-input');
                      const resultsContainer = popover.querySelector('.ds-mention-results');
                      setTimeout(() => searchInput.focus(), 50);

                      const loadUsers = async (query = '') => {
                        try {
                          const res = await fetch('/api/users/search?q=' + encodeURIComponent(query));
                          const data = await res.json();
                          if (data.success && data.users && data.users.length > 0) {
                            resultsContainer.innerHTML = data.users.map((u, i) => `
                              <button type="button" class="ds-mention-item ${i === 0 ? 'ds-autocomplete-selected' : ''}" data-username="${u.username}" style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;width:100%;text-align:left;cursor:pointer;border:none;background:${i === 0 ? 'rgba(59,130,246,0.2)' : 'transparent'};">
                                <img src="${u.avatarUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(u.displayName || u.username) + '&background=random'}" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;border:1px solid rgba(255,255,255,0.1);" />
                                <strong style="color:#60A5FA;font-size:13px;">@${u.username}</strong>
                                <span style="color:#71717A;font-size:11px;margin-left:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:80px;">${u.role || u.displayName || 'SRE'}</span>
                              </button>
                            `).join('');

                            resultsContainer.querySelectorAll('.ds-mention-item').forEach(btn => {
                              btn.addEventListener('click', (e) => {
                                e.stopPropagation();
                                const usernameTag = '@' + btn.getAttribute('data-username') + ' ';
                                el.value = el.value.substring(0, el.selectionStart) + usernameTag + el.value.substring(el.selectionStart);
                                popover.remove();
                                el.focus();
                              });
                            });
                          } else {
                            resultsContainer.innerHTML = '<div style="color:#71717A;font-size:12px;padding:12px 8px;text-align:center;">No engineers found</div>';
                          }
                        } catch (err) {
                          resultsContainer.innerHTML = '<div style="color:#EF4444;font-size:12px;padding:8px;text-align:center;">Error loading users</div>';
                        }
                      };

                      loadUsers();

                      searchInput.addEventListener('input', (e) => {
                        loadUsers(e.target.value.trim());
                      });

                      searchInput.addEventListener('click', (e) => e.stopPropagation());
                      return;
                    }

                    if (type === 'bold') {
                      if (selectedText) {
                        replacement = `**${selectedText}**`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + replacement.length, start + replacement.length);
                      } else {
                        replacement = `**bold text**`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + 2, start + 2 + "bold text".length);
                      }
                    } else if (type === 'italic') {
                      if (selectedText) {
                        replacement = `*${selectedText}*`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + replacement.length, start + replacement.length);
                      } else {
                        replacement = `*italic text*`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + 1, start + 1 + "italic text".length);
                      }
                    } else if (type === 'underline') {
                      if (selectedText) {
                        replacement = `__${selectedText}__`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + replacement.length, start + replacement.length);
                      } else {
                        replacement = `__underlined text__`;
                        el.value = before + replacement + after;
                        el.focus();
                        el.setSelectionRange(start + 2, start + 2 + "underlined text".length);
                      }
                    }
                  }

                  document.addEventListener('click', () => {
                    document.querySelectorAll('.ds-popover-menu').forEach(p => p.remove());
                  });

                  function openReplyForm(commentId) {
                    const form = document.getElementById('reply-form-' + commentId);
                    if (form) {
                      form.style.display = 'block';
                      if (typeof lucide !== 'undefined') lucide.createIcons();
                      const input = document.getElementById('reply-input-' + commentId);
                      if (input) setTimeout(() => input.focus(), 50);
                    }
                  }

                  function closeReplyForm(commentId) {
                    const form = document.getElementById('reply-form-' + commentId);
                    if (form) form.style.display = 'none';
                  }

                  async function submitReply(parentCommentId, postId) {
                    const inputId = parentCommentId ? 'reply-input-' + parentCommentId : 'root-comment-input';
                    const textarea = document.getElementById(inputId);
                    if (!textarea) return;

                    const content = textarea.value.trim();
                    if (!content) {
                      if (typeof showToast === 'function') showToast('Comment content cannot be empty.', 'error');
                      else alert('Please enter a comment.');
                      return;
                    }

                    try {
                      const res = await fetch(`/api/posts/${postId}/comments`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content, parentCommentId: parentCommentId || null })
                      });
                      if (res.status === 401 || res.status === 403) {
                        window.location.href = '/login';
                        return;
                      }
                      const data = await res.json();
                      if (data.success) {
                        textarea.value = '';
                        if (parentCommentId) closeReplyForm(parentCommentId);
                        if (typeof showToast === 'function') showToast('Comment transmitted successfully!', 'success');
                        setTimeout(() => window.location.reload(), 600);
                      } else {
                        if (typeof showToast === 'function') showToast('Error: ' + (data.message || 'Failed to post comment'), 'error');
                        else alert(data.message || 'Failed to post comment');
                      }
                    } catch (err) {
                      console.error('Failed to submit comment:', err);
                    }
                  }

                  async function toggleCommentUpvote(commentId) {
                    try {
                      const res = await fetch(`/api/comments/${commentId}/upvote`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                      });
                      if (res.status === 401 || res.status === 403) {
                        window.location.href = '/login';
                        return;
                      }
                      const data = await res.json();
                      if (data.success) {
                        const countSpan = document.getElementById('upvotes-' + commentId);
                        if (countSpan) countSpan.innerText = data.upvotes;
                        const btn = countSpan ? countSpan.closest('.ds-upvote-btn') : null;
                        if (btn) {
                          if (data.hasUpvoted) btn.classList.add('ds-active');
                          else btn.classList.remove('ds-active');
                        }
                      }
                    } catch (err) {
                      console.error('Failed to upvote comment:', err);
                    }
                  }

                  // ── Real-time Searchable @Mention Autocomplete on Input ─────────────
                  document.addEventListener('input', async (e) => {
                    if (!e.target || !e.target.classList || !e.target.classList.contains('ds-editor-textarea')) return;
                    const el = e.target;
                    const cursorPos = el.selectionStart;
                    const textBeforeCursor = el.value.substring(0, cursorPos);

                    const match = textBeforeCursor.match(/(?:^|\s)@([a-zA-Z0-9_-]*)$/);
                    const container = el.closest('.ds-editor-container');
                    let existingAutocomplete = container ? container.querySelector('.ds-live-autocomplete') : null;

                    if (!match) {
                      if (existingAutocomplete) existingAutocomplete.remove();
                      return;
                    }

                    const query = match[1].toLowerCase();
                    if (!container) return;

                    if (!existingAutocomplete) {
                      existingAutocomplete = document.createElement('div');
                      existingAutocomplete.className = 'ds-popover-menu ds-live-autocomplete';
                      existingAutocomplete.style.display = 'block';
                      existingAutocomplete.style.left = '16px';
                      existingAutocomplete.style.top = '10px';
                      existingAutocomplete.style.width = '260px';
                      existingAutocomplete.style.zIndex = '1000';
                      existingAutocomplete.style.padding = '8px';
                      container.style.position = 'relative';
                      container.appendChild(existingAutocomplete);
                    }

                    try {
                      const res = await fetch('/api/users/search?q=' + encodeURIComponent(query));
                      const data = await res.json();
                      if (data.success && data.users && data.users.length > 0) {
                        existingAutocomplete.innerHTML = `
                          <div style="font-size:11px;color:#A1A1AA;padding:2px 6px 6px;border-bottom:1px solid rgba(255,255,255,0.08);margin-bottom:4px;display:flex;justify-content:space-between;">
                            <span style="font-weight:600;color:#60A5FA;">Mention SRE</span>
                            <span style="color:#71717A;">↑↓ / Enter</span>
                          </div>
                          <div style="display:flex;flex-direction:column;gap:2px;max-height:180px;overflow-y:auto;">
                        ` + data.users.map((u, index) => `
                          <button type="button" class="ds-mention-item ${index === 0 ? 'ds-autocomplete-selected' : ''}" data-username="${u.username}" style="display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;width:100%;text-align:left;cursor:pointer;border:none;background:${index === 0 ? 'rgba(59,130,246,0.2)' : 'transparent'};">
                            <img src="${u.avatarUrl || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(u.displayName || u.username) + '&background=random'}" style="width:22px;height:22px;border-radius:50%;flex-shrink:0;border:1px solid rgba(255,255,255,0.1);" />
                            <strong style="color:#60A5FA;font-size:13px;">@${u.username}</strong>
                            <span style="color:#71717A;font-size:11px;margin-left:auto;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:90px;">${u.role || u.displayName || ''}</span>
                          </button>
                        `).join('') + `</div>`;

                        existingAutocomplete.querySelectorAll('.ds-mention-item').forEach(btn => {
                          btn.addEventListener('click', (ev) => {
                            ev.preventDefault();
                            ev.stopPropagation();
                            const username = btn.getAttribute('data-username');
                            const replaceRegex = /(?:^|\s)@([a-zA-Z0-9_-]*)$/;
                            const m = textBeforeCursor.match(replaceRegex);
                            if (m) {
                              const matchIndex = textBeforeCursor.lastIndexOf('@');
                              const newTextBefore = el.value.substring(0, matchIndex) + '@' + username + ' ';
                              const newTextAfter = el.value.substring(cursorPos);
                              el.value = newTextBefore + newTextAfter;
                              el.focus();
                              el.selectionStart = el.selectionEnd = newTextBefore.length;
                            }
                            existingAutocomplete.remove();
                          });
                        });
                      } else {
                        existingAutocomplete.innerHTML = '<div style="color:#71717A;font-size:12px;padding:8px;text-align:center;">No matching developers found</div>';
                      }
                    } catch (err) {
                      console.error('Error fetching autocomplete:', err);
                    }
                  });

                  // Keyboard Navigation (Arrows + Enter/Tab) for Live Autocomplete
                  document.addEventListener('keydown', (e) => {
                    if (!e.target || !e.target.classList || !e.target.classList.contains('ds-editor-textarea')) return;
                    const container = e.target.closest('.ds-editor-container');
                    const autocomplete = container ? container.querySelector('.ds-live-autocomplete') : null;
                    if (!autocomplete || autocomplete.style.display === 'none') return;

                    const items = Array.from(autocomplete.querySelectorAll('.ds-mention-item'));
                    if (!items.length) return;

                    let selectedIdx = items.findIndex(item => item.classList.contains('ds-autocomplete-selected'));

                    if (e.key === 'ArrowDown') {
                      e.preventDefault();
                      if (selectedIdx >= 0) {
                        items[selectedIdx].style.background = 'transparent';
                        items[selectedIdx].classList.remove('ds-autocomplete-selected');
                      }
                      selectedIdx = (selectedIdx + 1) % items.length;
                      items[selectedIdx].classList.add('ds-autocomplete-selected');
                      items[selectedIdx].style.background = 'rgba(59, 130, 246, 0.2)';
                    } else if (e.key === 'ArrowUp') {
                      e.preventDefault();
                      if (selectedIdx >= 0) {
                        items[selectedIdx].style.background = 'transparent';
                        items[selectedIdx].classList.remove('ds-autocomplete-selected');
                      }
                      selectedIdx = (selectedIdx - 1 + items.length) % items.length;
                      items[selectedIdx].classList.add('ds-autocomplete-selected');
                      items[selectedIdx].style.background = 'rgba(59, 130, 246, 0.2)';
                    } else if (e.key === 'Enter' || e.key === 'Tab') {
                      if (selectedIdx >= 0 && autocomplete) {
                        e.preventDefault();
                        items[selectedIdx].click();
                      }
                    } else if (e.key === 'Escape') {
                      autocomplete.remove();
                    }
                  });

                  document.addEventListener('DOMContentLoaded', () => {
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                  });
                  if (typeof lucide !== 'undefined') lucide.createIcons();
                </script>
                <% } %>