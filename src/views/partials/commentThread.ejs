      }

      /* --- Comments Header --- */
      .ds-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--ds-border-faint);
      }

      .ds-header-title {
