          opacity: 0;
          transform: translateY(5px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>

    <div class="ds-comments-wrapper">

      <!-- Top Level Input Editor -->
      <div style="display: flex; gap: 16px; margin-bottom: 40px; animation: fadeIn 0.4s ease-out forwards;">
