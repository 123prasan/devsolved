<style>
    /* Premium Material Dark Theme - Strict Black & White Mode */
    :root {
        --bg-base: #000000;
        --bg-surface: #121214;
        --bg-nav: rgba(10, 10, 12, 0.85);
        --bg-hover: rgba(255, 255, 255, 0.08);
        --bg-active: rgba(255, 255, 255, 0.12);
        --border-faint: #27272A;
        --border-hover: #3F3F46;

        --text-primary: #FFFFFF;
        --text-secondary: #A1A1AA;
        --text-muted: #71717A;

        /* White & Black Premium Button Theme */
        --brand-primary: #FFFFFF;
        --brand-hover: #E4E4E7;
        --brand-text: #000000;

        --shadow-1: 0 1px 2px 0 rgba(0, 0, 0, 0.4), 0 1px 3px 1px rgba(0, 0, 0, 0.2);
        --shadow-modal: 0 24px 38px 3px rgba(0, 0, 0, 0.6), 0 9px 46px 8px rgba(0, 0, 0, 0.5);
        --font-google: 'Inter', 'Google Sans', 'Roboto', sans-serif;
    }

    body {
        background-color: var(--bg-base);
        color: var(--text-primary);
        font-family: var(--font-google);
        margin: 0;
    }

    /* ── Header Base ───────────────────────────────────────────────────────── */
    .header {
        position: sticky;
        top: 0;
        width: 100%;
        background: var(--bg-nav);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border-faint);
        z-index: 1000;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .header-inner {
        max-width: 1280px;
        margin: 0 auto;
        height: 64px;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
    }

    /* ── Header Left & Brand ───────────────────────────────────────────────── */
    .header-left {
        justify-self: start;
        display: flex;
        align-items: center;
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.2px;
        color: var(--text-primary);
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .brand:hover {
        opacity: 0.85;
    }

    .brand-logo-img {
        width: 28px;
        height: 28px;
        object-fit: contain;
        display: block;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .brand:hover .brand-logo-img {
        transform: scale(1.05);
    }

    /* ── Header Center (Navigation) ────────────────────────────────────────── */
    .header-center {
        justify-self: center;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-link {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        padding: 8px 16px;
        border-radius: 20px;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .nav-link:hover {
        color: var(--text-primary);
        background: var(--bg-hover);
    }

    .nav-link.active {
        color: var(--brand-primary);
        background: var(--bg-active);
        font-weight: 600;
    }

    /* ── Header Right (Actions) ────────────────────────────────────────────── */
    .header-right {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-pill {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg-surface);
        border: 1px solid var(--border-faint);
        padding: 7px 14px;
        border-radius: 24px;
        cursor: pointer;
        color: var(--text-secondary);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        user-select: none;
    }

    .search-pill:hover {
        border-color: var(--border-hover);
        color: var(--text-primary);
        background: var(--bg-hover);
    }

    .search-text {
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
    }

    .search-kbd {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        background: var(--bg-hover);
        padding: 2px 6px;
        border-radius: 4px;
        color: var(--text-muted);
        margin-left: 4px;
        border: 1px solid var(--border-faint);
    }

    .btn-icon {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
        position: relative;
        text-decoration: none;
    }

    .btn-icon:hover, .btn-icon.active {
        background: var(--bg-hover);
        color: var(--text-primary);
    }

    .notification-badge {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 8px;
        height: 8px;
        background: #EA4335;
        border-radius: 50%;
        border: 2px solid var(--bg-nav);
    }

    /* Premium White & Secondary Buttons */
    .btn-write {
        background: var(--brand-primary);
        color: var(--brand-text);
        border: 1px solid var(--brand-primary);
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
    }

    .btn-write:hover {
        background: var(--brand-hover);
        border-color: var(--brand-hover);
        transform: scale(1.02);
        box-shadow: 0 0 16px rgba(255, 255, 255, 0.25);
    }

    .btn-secondary {
        color: var(--text-primary);
        background: transparent;
        border: 1px solid var(--border-faint);
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
        white-space: nowrap;
    }

    .btn-secondary:hover {
        background: var(--bg-hover);
        border-color: var(--border-hover);
    }

    /* ── User Dropdown ─────────────────────────────────────────────────────── */
    .user-menu-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .avatar-btn {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid var(--border-faint);
        background: var(--bg-hover);
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
        outline: none;
        overflow: hidden;
    }

    .avatar-btn img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .avatar-btn:hover,
    .avatar-btn:focus {
        border-color: var(--brand-primary);
        transform: scale(1.05);
    }

    .dropdown-menu {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        background: #121216;
        border: 1px solid var(--border-faint);
        border-radius: 14px;
        width: 240px;
        padding: 8px 0;
        box-shadow: 0 12px 36px rgba(0, 0, 0, 0.85);
        opacity: 0;
        pointer-events: none;
        transform: translateY(-10px) scale(0.98);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1100;
    }

    .dropdown-menu.show {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    .dropdown-header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--border-faint);
        margin-bottom: 6px;
    }

    .dropdown-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
    }

    .dropdown-email {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
        font-family: 'JetBrains Mono', monospace;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 10px 16px;
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, padding-left 0.2s;
        text-align: left;
        text-decoration: none;
        box-sizing: border-box;
    }

    .dropdown-item:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
        padding-left: 20px;
    }

    /* ── Mobile Menu System (Premium Obsidian UI) ───────────────────────────── */
    .mobile-menu-toggle {
        display: none;
        background: transparent;
        border: 1px solid var(--border-faint);
        color: var(--text-secondary);
        cursor: pointer;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
    }

    .mobile-menu-toggle:hover {
        background: var(--bg-hover);
        color: var(--text-primary);
        border-color: var(--border-hover);
    }

    .mobile-menu {
        position: fixed;
        inset: 0;
        top: 64px;
        background: rgba(10, 10, 14, 0.96);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        z-index: 990;
        padding: 20px 20px 32px;
        display: flex;
        flex-direction: column;
        opacity: 0;
        pointer-events: none;
        transform: translateY(12px);
        transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        overflow-y: auto;
        box-sizing: border-box;
    }

    .mobile-menu.show {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }

    .mobile-menu-scroll {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 20px;
        padding-bottom: 24px;
    }

    .mobile-group-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-faint);
        border-radius: 18px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .mobile-section-title {
        font-size: 11px;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.8px;
        margin-bottom: 12px;
        padding-left: 4px;
    }

    .mobile-nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 15px;
        font-weight: 600;
        color: var(--text-secondary);
        padding: 10px 12px;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-nav-link:hover,
    .mobile-nav-link.active {
        color: var(--text-primary);
        background: var(--bg-hover);
        transform: translateX(4px);
    }

    .mobile-icon-box {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-faint);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
        flex-shrink: 0;
        transition: all 0.2s;
    }

    .mobile-nav-link:hover .mobile-icon-box {
        background: rgba(255, 255, 255, 0.12);
        border-color: var(--border-hover);
    }

    .mobile-actions {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-top: auto;
    }

    .mobile-profile-card {
        background: var(--bg-surface);
        border: 1px solid var(--border-faint);
        border-radius: 18px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .mobile-profile-left {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .mobile-profile-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mobile-profile-name {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mobile-profile-email {
        font-size: 12px;
        color: var(--text-muted);
        font-family: 'JetBrains Mono', monospace;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mobile-logout-btn {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: #EF4444;
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .mobile-logout-btn:hover {
        background: #EF4444;
        color: #FFFFFF;
        box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
    }

    /* ── Search Modal Styles (Raycast / Spotlight Obsidian Edition) ─────────── */
    .search-overlay {
        position: fixed;
        inset: 0;
        background: rgba(5, 5, 8, 0.75);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 11vh 20px 20px;
        z-index: 2000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .search-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    .search-modal {
        background: #111115;
        border: 1px solid rgba(255, 255, 255, 0.12);
        width: 100%;
        max-width: 700px;
        border-radius: 24px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.95), 0 0 0 1px rgba(255, 255, 255, 0.05);
        display: flex;
        flex-direction: column;
        overflow: hidden;
        transform: scale(0.96) translateY(-16px);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        max-height: 78vh;
    }

    .search-overlay.active .search-modal {
        transform: scale(1) translateY(0);
    }

    .search-header {
        display: flex;
        align-items: center;
        padding: 16px 22px;
        border-bottom: 1px solid var(--border-faint);
        background: rgba(255, 255, 255, 0.02);
        gap: 14px;
        flex-shrink: 0;
    }

    .search-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        color: #FFFFFF;
    }

    .search-input {
        flex: 1;
        background: transparent;
        border: none;
        color: var(--text-primary);
        font-family: var(--font-google);
        font-size: 17px;
        font-weight: 500;
        outline: none;
        width: 100%;
    }

    .search-input::placeholder {
        color: rgba(255, 255, 255, 0.35);
        font-weight: 400;
    }

    .search-clear-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        cursor: pointer;
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, transform 0.2s;
    }

    .search-clear-btn:hover {
        color: var(--text-primary);
        transform: scale(1.1);
    }

    .esc-hint {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        color: var(--text-secondary);
        background: var(--bg-surface, #18181d);
        padding: 4px 9px;
        border-radius: 8px;
        border: 1px solid var(--border-faint);
        letter-spacing: 0.5px;
    }

    /* Completely Hide Side Scrollbar While Remaining Scrollable */
    .search-content {
        padding: 18px 20px;
        overflow-y: auto;
        flex: 1;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* Internet Explorer & Edge */
    }

    .search-content::-webkit-scrollbar {
        display: none; /* WebKit / Chrome / Safari */
    }

    .search-section {
        margin-bottom: 22px;
    }

    .search-section:last-child {
        margin-bottom: 4px;
    }

    .search-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        padding: 0 4px;
    }

    .search-section-title {
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-muted);
        letter-spacing: 0.8px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    /* Responsive 2-column grid for trending tags on desktop */
    .search-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }

    .search-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .search-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 11px 14px;
        border-radius: 14px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        color: var(--text-secondary);
        text-decoration: none;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .search-item:hover,
    .search-item.active {
        background: rgba(255, 255, 255, 0.07);
        border-color: rgba(255, 255, 255, 0.14);
        color: #FFFFFF;
        transform: translateX(4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .search-item-icon {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-faint);
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--text-primary);
        transition: all 0.2s;
    }

    .search-item:hover .search-item-icon {
        background: #FFFFFF;
        color: #000000;
        border-color: #FFFFFF;
        box-shadow: 0 0 16px rgba(255, 255, 255, 0.3);
    }

    .search-item-title {
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-item-meta {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-arrow-hint {
        width: 16px;
        height: 16px;
        color: var(--text-muted);
        opacity: 0;
        transform: translateX(-4px);
        transition: all 0.2s;
    }

    .search-item:hover .search-arrow-hint {
        opacity: 1;
        transform: translateX(0);
        color: #FFFFFF;
    }

    .search-action-pill {
        font-size: 12px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.06);
        padding: 5px 11px;
        border-radius: 20px;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s;
        border: 1px solid var(--border-faint);
        flex-shrink: 0;
    }

    .search-item:hover .search-action-pill {
        background: #FFFFFF;
        color: #000000;
        border-color: #FFFFFF;
    }

    .search-see-all-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border-faint);
        color: #FFFFFF;
        padding: 10px 20px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
    }

    .search-see-all-btn:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.3);
        transform: scale(1.02);
    }

    .search-loader {
        text-align: center;
        padding: 40px 24px;
        color: var(--text-muted);
        font-size: 14px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
    }

    /* Docked Footer */
    .search-footer {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 12px 22px;
        border-top: 1px solid var(--border-faint);
        background: rgba(0, 0, 0, 0.3);
        font-size: 12px;
        color: var(--text-secondary);
        flex-shrink: 0;
    }

    .search-footer-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .kbd-badge {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        background: var(--bg-surface, #1b1b22);
        color: var(--text-primary);
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid var(--border-faint);
    }

    /* ── Responsive Breakpoints ────────────────────────────────────────────── */
    @media (max-width: 960px) {
        .header-center {
            display: none;
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
        }
    }

    @media (max-width: 768px) {
        .header-inner {
            padding: 0 16px;
            height: 60px;
        }

        .header-right {
            gap: 8px;
        }

        /* Hide only desktop-specific elements on phone, NEVER hide Write button or Search bar */
        .desktop-only,
        .desktop-auth-btn,
        .btn-icon,
        .user-menu-wrapper {
            display: none !important;
        }

        /* Keep Write Button and Search Pill strictly visible on phone */
        .btn-write {
            display: inline-flex !important;
            padding: 6px 14px;
            font-size: 13px;
        }

        .search-pill {
            display: inline-flex !important;
            padding: 6px 12px;
            gap: 6px;
            background: var(--bg-surface);
            border-radius: 20px;
        }

        .search-kbd {
            display: none !important;
        }

        .mobile-menu-toggle {
            display: flex !important;
        }

        .search-overlay {
            padding-top: 0;
            background: var(--bg-base, #000000);
            backdrop-filter: none;
        }

        .search-modal {
            max-width: 100%;
            height: 100dvh;
            max-height: 100dvh;
            border-radius: 0;
            border: none;
            box-shadow: none;
        }

        .search-grid-2 {
            grid-template-columns: 1fr;
        }

        .search-footer {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .header-inner {
            padding: 0 12px;
        }

        .brand {
            gap: 8px;
            font-size: 17px;
        }

        .brand-logo-img {
            width: 24px;
            height: 24px;
        }

        .header-right {
            gap: 6px;
        }

        .search-pill {
            padding: 6px 10px;
            gap: 4px;
        }

        .search-text {
            font-size: 12px;
        }

        .btn-write {
            padding: 6px 12px;
            font-size: 12px;
            gap: 5px;
        }

        .mobile-menu-toggle {
            width: 36px;
            height: 36px;
        }
    }

    @media (max-width: 370px) {
        .search-text {
            display: none;
        }
        .search-pill {
            padding: 8px;
            width: 36px;
            height: 36px;
            justify-content: center;
            border-radius: 50%;
        }
    }
</style>

