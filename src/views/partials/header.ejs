                autocomplete="off" spellcheck="false">
            <button class="search-clear-btn" id="searchClearBtn" onclick="typeof clearSearchInput === 'function' ? clearSearchInput() : null" style="display:none;" title="Clear search">
                <i data-lucide="x-circle" style="width: 18px; height: 18px;"></i>
            </button>
            <span class="esc-hint">ESC</span>
            <button class="mobile-close-search-btn" onclick="closeSearch()" aria-label="Close search" style="display:none; background:transparent; border:none; color:var(--text-secondary); cursor:pointer; padding:6px;">
                <i data-lucide="x"></i>
            </button>
