<!-- ── Javascript Logic ────────────────────────────────────────────────────── -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // --- 1. Dropdown & Mobile Menu Logic ---
        const avatarBtn = document.getElementById('avatarBtn');
        const userMenu = document.getElementById('userMenu');

        if (avatarBtn && userMenu) {
            avatarBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                userMenu.classList.toggle('show');
            });
            document.addEventListener('click', (e) => {
                if (userMenu.classList.contains('show') && !userMenu.contains(e.target)) {
                    userMenu.classList.remove('show');
                }
            });
        }

        const mobileToggle = document.getElementById('mobileToggle');
        const mobileMenu = document.getElementById('mobileMenu');
        const menuIcon = document.getElementById('menuIcon');
        let isMenuOpen = false;

        if (mobileToggle) {
            mobileToggle.addEventListener('click', () => {
                isMenuOpen = !isMenuOpen;
                if (isMenuOpen) {
                    mobileMenu.classList.add('show');
                    menuIcon.setAttribute('data-lucide', 'x');
                    document.body.style.overflow = 'hidden';
                } else {
                    mobileMenu.classList.remove('show');
                    menuIcon.setAttribute('data-lucide', 'menu');
                    document.body.style.overflow = '';
                }
                if (typeof lucide !== 'undefined') {
                    lucide.createIcons({ nameAttr: 'data-lucide', attrs: { class: 'lucide' } });
                }
            });
        }

        // --- 2. Search Logic, Debounce & API Calls ---
        const searchOverlay = document.getElementById('searchOverlay');
        const searchInput = document.getElementById('searchInput');
        const searchContent = document.getElementById('searchContent');
        const searchClearBtn = document.getElementById('searchClearBtn');
        const mobileCloseBtn = document.querySelector('.mobile-close-search-btn');
        const escHint = document.querySelector('.esc-hint');

        let searchTimer;
        let trendingCache = null;

        // Toggle elements for mobile view in search modal
        if (window.innerWidth <= 768) {
            if (mobileCloseBtn) mobileCloseBtn.style.display = 'block';
            if (escHint) escHint.style.display = 'none';
        }

        function updateClearBtn() {
            if (!searchClearBtn) return;
            if (searchInput && searchInput.value.trim().length > 0) {
                searchClearBtn.style.display = 'flex';
            } else {
                searchClearBtn.style.display = 'none';
            }
        }

        window.clearSearchInput = function () {
            if (!searchInput) return;
            searchInput.value = '';
            updateClearBtn();
            if (trendingCache) renderTrending(trendingCache);
            searchInput.focus();
        };

        // Fetch Trending Tags
        async function loadTrending() {
            if (trendingCache) return trendingCache;
            try {
                const res = await fetch('/api/tags/trending');
                const data = await res.json();
                trendingCache = data.success ? (data.tags || []) : [];
            } catch (e) {
                trendingCache = [];
            }
            return trendingCache;
        }

        // Render Trending Tags HTML
        function renderTrending(tags) {
            if (!tags || tags.length === 0) {
                searchContent.innerHTML = '<div class="search-loader">Start typing to search incidents...</div>';
                return;
            }
            searchContent.innerHTML = `
                <div class="search-section">
                    <div class="search-section-header">
                        <span class="search-section-title"><i data-lucide="trending-up" style="width:14px; color:#10B981;"></i> Trending Topics</span>
                        <span style="font-size:11px; color:var(--text-muted); font-family: 'JetBrains Mono', monospace;">Live stats</span>
                    </div>
                    <div class="search-grid-2">
                        ${tags.slice(0, 8).map(tag => `
                            <a href="/?tag=${encodeURIComponent(tag.name)}" class="search-item">
                                <div class="search-item-icon"><i data-lucide="hash" style="width:16px;"></i></div>
                                <div style="min-width:0; flex:1;">
                                    <div class="search-item-title">#${tag.displayName || tag.name}</div>
                                    <div class="search-item-meta">${tag.incidentCount || 0} incident${(tag.incidentCount || 0) !== 1 ? 's' : ''}</div>
                                </div>
                                <i data-lucide="chevron-right" class="search-arrow-hint"></i>
                            </a>
                        `).join('')}
                    </div>
                </div>
                <div class="search-section">
                    <div class="search-section-header">
                        <span class="search-section-title"><i data-lucide="zap" style="width:14px; color:#F59E0B;"></i> Quick Navigation</span>
                    </div>
                    <div class="search-list">
                        <a href="/write" class="search-item">
                            <div class="search-item-icon" style="color:#F59E0B;"><i data-lucide="file-pen" style="width:16px;"></i></div>
                            <div style="min-width:0; flex:1;">
                                <div class="search-item-title">Write New Incident Report</div>
                                <div class="search-item-meta">Share a war story or postmortem solution</div>
                            </div>
                            <div class="search-action-pill">Create <i data-lucide="plus" style="width:14px;"></i></div>
                        </a>
                        <a href="/leaderboard" class="search-item">
                            <div class="search-item-icon" style="color:#FCD34D;"><i data-lucide="podium" style="width:16px;"></i></div>
                            <div style="min-width:0; flex:1;">
                                <div class="search-item-title">War Stories Leaderboard</div>
                                <div class="search-item-meta">Explore top investigators & reputation titans</div>
                            </div>
                            <div class="search-action-pill">View <i data-lucide="arrow-up-right" style="width:14px;"></i></div>
                        </a>
                    </div>
                </div>`;
            if (typeof lucide !== 'undefined') lucide.createIcons();
        }

        // Open/Close Handlers
        window.openSearch = async function () {
            if (!searchOverlay) return;
            if (isMenuOpen) mobileToggle.click(); // close mobile menu if open

            searchOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            setTimeout(() => searchInput.focus(), 100);
            updateClearBtn();

            // Load trending on first open or if input is empty
            if (!searchInput || searchInput.value.trim().length < 2) {
                searchContent.innerHTML = '<div class="search-loader"><i data-lucide="loader-2" style="width:20px; color:var(--brand-primary); animation: spin 1s linear infinite;"></i> <span>Loading trending topics...</span></div>';
                if (typeof lucide !== 'undefined') lucide.createIcons();
                const tags = await loadTrending();
                renderTrending(tags);
            }
        }

        window.closeSearch = function () {
            if (!searchOverlay) return;
            searchOverlay.classList.remove('active');
            searchInput.value = '';
            updateClearBtn();
            searchInput.blur();
            document.body.style.overflow = '';
        }

        searchOverlay.addEventListener('click', (e) => {
            if (e.target === searchOverlay) closeSearch();
        });

        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                openSearch();
            }
            if (e.key === 'Escape' && searchOverlay.classList.contains('active')) {
                closeSearch();
            }
        });

        // Enter key submission
        searchInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                const q = searchInput.value.trim();
                if (q.length >= 2) {
                    closeSearch();
                    window.location.href = '/search?q=' + encodeURIComponent(q);
                }
            }
        });

        // Live Search Input Logic
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimer);
            updateClearBtn();
            const q = searchInput.value.trim();

            if (q.length < 2) {
                // Show trending again if input is cleared
                if (trendingCache) renderTrending(trendingCache);
                return;
            }

            searchContent.innerHTML = '<div class="search-loader"><i data-lucide="loader-2" style="width:20px; color:var(--brand-primary); animation: spin 1s linear infinite;"></i> <span>Searching incidents and war stories...</span></div>';
            if (typeof lucide !== 'undefined') lucide.createIcons();

            searchTimer = setTimeout(async () => {
                try {
                    const res = await fetch(`/api/search?q=${encodeURIComponent(q)}&limit=8`);
                    const data = await res.json();

                    if (!data.results || data.results.length === 0) {
                        searchContent.innerHTML = `
                            <div class="search-loader" style="padding:40px 20px;">
                                <div style="width:44px; height:44px; border-radius:12px; background:rgba(255,255,255,0.05); border:1px solid var(--border-faint); display:flex; align-items:center; justify-content:center; color:var(--text-muted);">
                                    <i data-lucide="search-x" style="width:22px;"></i>
                                </div>
                                <div style="font-size:15px; font-weight:700; color:var(--text-primary);">No matching incidents found for "${q}"</div>
                                <div style="font-size:13px; color:var(--text-muted);">Try different abbreviations, error codes, or search across all war stories.</div>
                            </div>
                            <div style="text-align:center; padding: 0 16px 20px;">
                                <a href="/search?q=${encodeURIComponent(q)}" class="search-see-all-btn">
                                    <i data-lucide="search" style="width:15px;"></i>
                                    <span>Search all community discussions for "${q}"</span>
                                </a>
                            </div>`;
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                        return;
                    }

                    searchContent.innerHTML = `
                        <div class="search-section">
                            <div class="search-section-header">
                                <span class="search-section-title"><i data-lucide="file-text" style="width:14px;"></i> Incidents & Solutions</span>
                                <span style="font-size:11px; font-family:'JetBrains Mono', monospace; color:var(--text-muted);">${data.results.length} result${data.results.length !== 1 ? 's' : ''}</span>
                            </div>
                            <div class="search-list">
                                ${data.results.map(post => `
                                    <a href="/incidents/${post.slug}" class="search-item" style="align-items:flex-start;">
                                        <div class="search-item-icon" style="margin-top:2px; ${post.status === 'resolved' ? 'color:#10B981; background:rgba(16,185,129,0.08); border-color:rgba(16,185,129,0.2);' : 'color:#F59E0B; background:rgba(245,158,11,0.08); border-color:rgba(245,158,11,0.2);'}">
                                            <i data-lucide="${post.status === 'resolved' ? 'check-circle-2' : 'alert-triangle'}" style="width:18px;"></i>
                                        </div>
                                        <div style="min-width:0; flex:1;">
                                            <div style="display:flex; align-items:center; gap:8px; margin-bottom:3px;">
                                                <span class="search-item-title" style="margin:0; font-size:14px;">${post.title}</span>
                                            </div>
                                            <div class="search-item-meta">
                                                <span style="color: ${post.status === 'resolved' ? '#10B981' : '#F59E0B'}; font-weight:700;">${post.status === 'resolved' ? 'Resolved' : 'Investigating'}</span> · 
                                                ${(post.tags || []).map(t => '#' + (t.name || t)).slice(0, 3).join(' ')}
                                            </div>
                                        </div>
                                        <div class="search-action-pill" style="margin-top:2px;">View <i data-lucide="arrow-up-right" style="width:14px;"></i></div>
                                    </a>
                                `).join('')}
                            </div>
                        </div>
                        <div style="padding: 12px 0 6px; text-align:center;">
                            <a href="/search?q=${encodeURIComponent(q)}" class="search-see-all-btn">
                                <span>Explore all results for "<strong>${q}</strong>"</span>
                                <i data-lucide="arrow-right" style="width:16px;"></i>
                            </a>
                        </div>`;
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                } catch (e) {
                    searchContent.innerHTML = '<div class="search-loader">Search unavailable at this time. Please try again.</div>';
                }
            }, 350);
        });
    });
</script>