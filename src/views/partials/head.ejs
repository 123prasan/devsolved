<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>
    <%= typeof title !=='undefined' ? title : 'DevSolved' %>
</title>
<link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png">
<link rel="manifest" href="/images/site.webmanifest">
<meta name="description"
    content="<%= typeof description !== 'undefined' ? description : 'DevSolved – Developer war stories, documented.' %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

<% if (typeof canonicalUrl !=='undefined' ) { %>
    <link rel="canonical" href="<%= canonicalUrl %>">
    <% } %>

        <!-- Open Graph -->
        <meta property="og:site_name" content="DevSolved">
        <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'DevSolved' %>">
        <meta property="og:description"
            content="<%= typeof description !== 'undefined' ? description : 'Developer war stories, documented.' %>">
        <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
        <% if (typeof canonicalUrl !=='undefined' ) { %>
            <meta property="og:url" content="<%= canonicalUrl %>">
            <% } %>
                <% if (typeof ogType !=='undefined' && ogType==='article' ) { %>
                    <% if (typeof publishedTime !=='undefined' ) { %>
                        <meta property="article:published_time" content="<%= publishedTime %>">
                        <% } %>
                            <% if (typeof authorUrl !=='undefined' ) { %>
                                <meta property="article:author" content="<%= authorUrl %>">
                                <% } %>
                                    <% } %>
                                        <meta property="og:image"
                                            content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://devsolved.com/images/og-default.png' %>">

                                        <!-- Twitter Cards -->
                                        <meta name="twitter:card" content="summary_large_image">
                                        <meta name="twitter:title"
                                            content="<%= typeof title !== 'undefined' ? title : 'DevSolved' %>">
                                        <meta name="twitter:description"
                                            content="<%= typeof description !== 'undefined' ? description : 'Developer war stories, documented.' %>">
                                        <meta name="twitter:image"
                                            content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://devsolved.com/images/og-default.png' %>">

                                        <!-- Schema.org JSON-LD -->
                                        <% if (typeof structuredData !=='undefined' ) { %>
                                            <script type="application/ld+json">
<%- JSON.stringify(structuredData) %>
</script>
                                            <% } %>

                                                <!-- Google Sitelinks Search Box Schema -->
                                                <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "DevSolved",
  "url": "https://devsolved.com/",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://devsolved.com/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

                                                <!-- Google Organization Schema for Logo -->
                                                <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DevSolved",
  "url": "https://devsolved.com/",
  "logo": "https://devsolved.com/images/android-chrome-512x512.png",
  "sameAs": [
    "https://github.com/123prasan/devsolved"
  ]
}
</script>

                                                <!-- Preload Google Fonts -->
                                                <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" as="style">
                                                
                                                <!-- Google Fonts -->
                                                <link rel="preconnect" href="https://fonts.googleapis.com">
                                                <link rel="dns-prefetch" href="//fonts.gstatic.com">
                                                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
                                                <link
                                                    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
                                                    rel="stylesheet">

                                                <!-- Lucide Icons -->
                                                <script src="https://unpkg.com/lucide@latest"></script>

                                                <!-- DotLottie Web Player (only on pages that use it) -->
                                                <% if (typeof useLottie !=='undefined' && useLottie) { %>
                                                    <script
                                                        src="https://unpkg.com/@dotlottie/player-component@latest/dist/dotlottie-player.mjs"
                                                        type="module"></script>
                                                    <% } %>

                                                        <!-- Anime.js (only on pages that use it) -->
                                                        <% if (typeof useAnime !=='undefined' && useAnime) { %>
                                                            <script
                                                                src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
                                                            <% } %>

                                                                <!-- Global Styles -->
                                                                <link rel="preload" href="/css/global.css" as="style">
                                                                <link rel="stylesheet" href="/css/global.css">