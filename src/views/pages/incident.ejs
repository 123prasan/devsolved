                                <script>
                                    // ── Upvote toggle ──
                                    var upvoted = false;
                                    var upvoteCount = 142;
                                    function toggleUpvote() {
                                        upvoted = !upvoted;
                                        upvoteCount = upvoted ? upvoteCount + 1 : upvoteCount - 1;
                                        var btn = document.getElementById('upvote-btn');
                                        var label = document.getElementById('upvote-label');
                                        var count = document.getElementById('upvote-count');
                                        var icon = document.getElementById('upvote-icon');
                                        label.textContent = upvoted ? 'Upvoted' : 'Upvote';
                                        count.textContent = upvoteCount;
                                        if (upvoted) {
                                            btn.classList.add('active-upvote');
                                            icon.setAttribute('fill', 'currentColor');
                                        } else {
                                            btn.classList.remove('active-upvote');
                                            icon.setAttribute('fill', 'none');
                                        }
                                    }

                                    // ── Bookmark toggle ──
                                    var bookmarked = false;
                                    function toggleBookmark() {
                                        bookmarked = !bookmarked;
                                        var btn = document.getElementById('bookmark-btn');
                                        var label = document.getElementById('bookmark-label');
                                        var icon = document.getElementById('bookmark-icon');
                                        label.textContent = bookmarked ? 'Saved' : 'Save';
                                        if (bookmarked) {
                                            btn.classList.add('active-bookmark');
                                            icon.setAttribute('fill', 'currentColor');
                                        } else {
                                            btn.classList.remove('active-bookmark');
                                            icon.setAttribute('fill', 'none');
                                        }
                                    }

                                    // ── Like toggle ──
                                    function toggleLike(btn, initial) {
                                        var span = btn.querySelector('span');
                                        var icon = btn.querySelector('svg');
                                        var liked = btn.dataset.liked === '1';
                                        var count = parseInt(span.textContent, 10);
                                        if (liked) {
                                            btn.dataset.liked = '0';
                                            span.textContent = count - 1;
                                            btn.style.color = '';
                                            icon.setAttribute('fill', 'none');
                                        } else {
                                            btn.dataset.liked = '1';
                                            span.textContent = count + 1;
                                            btn.style.color = '#D0BCFF';
                                            icon.setAttribute('fill', 'currentColor');
                                        }
                                    }

                                    // ── Scroll to section ──
                                    function scrollTo(id) {
                                        var el = document.getElementById(id);
                                        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                    }

                                    // ── Copy terminal ──
                                    function copyTerminal(btn, id) {
                                        var el = document.getElementById(id);
                                        var lines = el.querySelectorAll('.terminal-line');
                                        var text = Array.from(lines).map(function (l) {
                                            var t = l.textContent;
                                            if (l.classList.contains('terminal-command')) return '$ ' + t;
                                            return t;
                                        }).join('\n');
                                        navigator.clipboard.writeText(text).then(function () {
                                            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;stroke:#6DD58C"><polyline points="20 6 9 17 4 12"/></svg> Copied';
                                            setTimeout(function () {
                                                btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';
                                            }, 2000);
                                        });
                                    }

                                    // ── Copy code ──
                                    function copyCode(btn, id) {
                                        var el = document.getElementById(id);
                                        var text = el.innerText.replace(/^\d+\s*/gm, '');
                                        navigator.clipboard.writeText(text).then(function () {
                                            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;stroke:#6DD58C"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
                                            setTimeout(function () {
                                                btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy';
                                            }, 2000);
                                        });
                                    }

                                    // ── Jump nav scroll spy ──
                                    var navIds = ['symptom', 'investigation', 'root-cause', 'resolution-steps', 'resolution', 'timeline', 'lessons-learned', 'discussion'];
                                    var total = navIds.length;

                                    function updateNav() {
                                        var active = navIds[0];
                                        for (var i = navIds.length - 1; i >= 0; i--) {
                                            var el = document.getElementById(navIds[i]);
                                            if (el) {
                                                var rect = el.getBoundingClientRect();
                                                if (rect.top <= 100) { active = navIds[i]; break; }
                                            }
                                        }
                                        navIds.forEach(function (id) {
                                            var btn = document.getElementById('nav-' + id);
                                            if (btn) btn.classList.toggle('active', id === active);
                                        });
                                        var idx = navIds.indexOf(active);
                                        var label = document.getElementById('nav-progress-label');
                                        var fill = document.getElementById('nav-progress-fill');
                                        if (label) label.textContent = 'Section ' + (idx + 1) + ' of ' + total;
                                        if (fill) fill.style.width = ((idx + 1) / total * 100) + '%';
                                    }

                                    window.addEventListener('scroll', updateNav, { passive: true });
                                    updateNav();
                                </script>

                                <script>
                                    const postId = '<%= post._id %>';

                                    // Upvote Logic
                                    const upvoteBtn = document.getElementById('upvoteBtn');
                                    if (upvoteBtn) {
                                        upvoteBtn.addEventListener('click', async () => {
                                            const countEls = document.querySelectorAll('#upvoteCount');
                                            try {
                                                const res = await fetch(`/api/posts/${postId}/upvote`, { method: 'POST', credentials: 'include' });
                                                if (res.status === 401) { window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname); return; }
                                                const data = await res.json();
                                                if (data.success) {
                                                    countEls.forEach(el => el.textContent = data.upvotes);
                                                    upvoteBtn.classList.toggle('active-upvote', data.hasUpvoted);
                                                    const icon = document.getElementById('upvote-icon');
                                                    const label = document.getElementById('upvote-label');
                                                    icon.setAttribute('fill', data.hasUpvoted ? 'currentColor' : 'none');
                                                    label.textContent = data.hasUpvoted ? 'Upvoted' : 'Upvote';
                                                }
                                            } catch (e) { console.error(e) }
                                        });
                                    }

                                    // Save Logic
                                    const saveBtn = document.getElementById('saveBtn');
                                    if (saveBtn) {
                                        saveBtn.addEventListener('click', async () => {
                                            try {
                                                const res = await fetch(`/api/posts/${postId}/save`, { method: 'POST', credentials: 'include' });
                                                if (res.status === 401) { window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname); return; }
                                                const data = await res.json();
                                                if (data.success) {
                                                    saveBtn.classList.toggle('active-bookmark', data.hasSaved);
                                                    const icon = document.getElementById('bookmark-icon');
                                                    const label = document.getElementById('bookmark-label');
                                                    icon.setAttribute('fill', data.hasSaved ? 'currentColor' : 'none');
                                                    label.textContent = data.hasSaved ? 'Saved' : 'Save';
                                                }
                                            } catch (e) { console.error(e) }
                                        });
                                    }

                                    // Jump Nav updates
                                    var navIds = [];
        <% sections.forEach(sec => { %>
                                        navIds.push('<%= sec.id %>');
        <% }) %>
                                        navIds.push('discussion');

                                    function updateNavDynamic() {
                                        var active = navIds[0];
                                        for (var i = navIds.length - 1; i >= 0; i--) {
                                            var el = document.getElementById(navIds[i]);
                                            if (el) {
                                                var rect = el.getBoundingClientRect();
                                                if (rect.top <= 150) { active = navIds[i]; break; }
                                            }
                                        }
                                        navIds.forEach(function (id) {
                                            var btn = document.getElementById('nav-' + id);
                                            if (btn) btn.classList.toggle('active', id === active);
                                        });
                                        var idx = navIds.indexOf(active);
                                        var label = document.getElementById('nav-progress-label');
                                        var fill = document.getElementById('nav-progress-fill');
                                        if (label) label.textContent = 'Section ' + (idx + 1) + ' of ' + navIds.length;
                                        if (fill) fill.style.width = ((idx + 1) / navIds.length * 100) + '%';
                                    }

                                    window.addEventListener('scroll', updateNavDynamic, { passive: true });
                                    setTimeout(updateNavDynamic, 100);
                                </script>

                                <!-- Syntax Highlighting -->
                                <script
                                    src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.8.0/highlight.min.js"></script>
                                <script>hljs.highlightAll();</script>
                                <script>
                                    function linkGitHubPR(postId) {
                                        const prUrl = prompt("🔗 Enter verified GitHub Pull Request or commit URL that resolved this outage:\n(Example: https://github.com/kubernetes/kubernetes/pull/112450)");
                                        if (!prUrl || prUrl.trim() === "") return;

                                        const gitRegex = /git(hub|lab)\.com\/([^\/]+)\/([^\/]+)\/(pull|merge_requests|commit|commits)\/([a-zA-Z0-9]+)/i;
                                        if (!gitRegex.test(prUrl.trim())) {
                                            alert("⚠️ PR Verification Failed: You must provide an official GitHub or GitLab Pull Request or commit URL (e.g., https://github.com/org/repo/pull/123).");
                                            return;
                                        }

                                        const btn = document.getElementById('btnLinkPr');
                                        if (btn) btn.innerHTML = "⌛ Verifying commit signature & diff...";

                                        fetch(`/api/posts/${postId}/link-pr`, {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ prUrl: prUrl.trim() })
                                        })
                                            .then(res => res.json())
                                            .then(data => {
                                                if (data.success) {
                                                    if (btn) {
                                                        btn.outerHTML = `
                            <button onclick="openDiffModal('${postId}')" class="chip" style="background: rgba(35, 134, 54, 0.2); color: #48c774; border: 1px solid rgba(35, 134, 54, 0.4); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; cursor: pointer;">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                                </svg>
                                🔍 View Verified Fix Diff (PR)
                            </button>`;
                                                    }
                                                    // Render floating celebration toast
                                                    const toast = document.createElement('div');
                                                    toast.style.cssText = "position: fixed; bottom: 30px; right: 30px; background: #000; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.8); color: #FFF; padding: 16px 24px; border-radius: 12px; z-index: 10000; font-family: sans-serif; display: flex; align-items: center; gap: 12px;";
                                                    toast.innerHTML = `<span style="font-size: 20px;">🎉</span><div><div style="font-weight: 700; color: #6DD58C;">Verified PR Accepted! +25 Rep</div><div style="font-size: 13px; color: #CCC;">${data.message}</div></div>`;
                                                    document.body.appendChild(toast);
                                                    setTimeout(() => {
                                                        toast.style.transition = "opacity 0.5s";
                                                        toast.style.opacity = "0";
                                                        setTimeout(() => toast.remove(), 500);
                                                    }, 4500);

                                                    // Automatically open diff modal to celebrate verification!
                                                    setTimeout(() => openDiffModal(postId), 600);
                                                } else {
                                                    alert(data.message || "Verification failed: Invalid Pull Request.");
                                                    if (btn) btn.innerHTML = "➕ Link GitHub PR (+25 Rep 🔥)";
                                                }
                                            })
                                            .catch(err => {
                                                console.error(err);
                                                alert("Error communicating with telemetry server.");
                                                if (btn) btn.innerHTML = "➕ Link GitHub PR (+25 Rep 🔥)";
                                            });
                                    }
                                </script>

                                <!-- 🔗 Embed Widget Modal -->
                                <div id="embedModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 100000; align-items: center; justify-content: center; padding: 20px;">
                                    <div style="background: #121214; border: 1px solid #27272A; border-radius: 20px; width: 100%; max-width: 500px; display: flex; flex-direction: column; box-shadow: 0 25px 60px rgba(0,0,0,0.95); overflow: hidden;">
                                        <div style="padding: 20px 24px; border-bottom: 1px solid #27272A; display: flex; align-items: center; justify-content: space-between; background: #0A0A0C;">
                                            <h3 style="font-size: 16px; font-weight: 600; color: #FFF; margin: 0;">Embed Incident</h3>
                                            <button onclick="closeEmbedModal()" style="background: transparent; border: none; color: #A1A1AA; font-size: 26px; cursor: pointer; padding: 0 8px; line-height: 1;">&times;</button>
                                        </div>
                                        <div style="padding: 24px;">
                                            <p style="color: #A1A1AA; font-size: 14px; margin-bottom: 16px; line-height: 1.5;">Copy the HTML below to embed this postmortem on your company blog, Notion, or internal docs.</p>
                                            <textarea id="embedCode" readonly style="width: 100%; height: 100px; background: #09090B; border: 1px solid #27272A; border-radius: 8px; color: #3B82F6; font-family: monospace; font-size: 13px; padding: 12px; resize: none; margin-bottom: 16px;"><iframe src="<%= canonicalUrl.replace('/incidents/' + post.slug, '') %>/embed/incidents/<%= post.slug %>" width="100%" height="220" frameborder="0" style="border: 1px solid #27272a; border-radius: 12px;"></iframe></textarea>
                                            <button onclick="copyEmbedCode()" style="width: 100%; background: #FAFAFA; color: #09090B; border: none; padding: 12px; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px;">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                Copy Embed Code
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <script>
                                    function openEmbedModal() {
                                        const modal = document.getElementById('embedModal');
                                        modal.style.display = 'flex';
                                    }
                                    function closeEmbedModal() {
                                        const modal = document.getElementById('embedModal');
                                        modal.style.display = 'none';
                                    }
                                    function copyEmbedCode() {
                                        const code = document.getElementById('embedCode');
                                        code.select();
                                        document.execCommand('copy');
                                        const btn = event.currentTarget;
                                        const oldHtml = btn.innerHTML;
                                        btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Copied!`;
                                        btn.style.background = '#10B981';
                                        btn.style.color = '#fff';
                                        setTimeout(() => {
                                            btn.innerHTML = oldHtml;
                                            btn.style.background = '#FAFAFA';
                                            btn.style.color = '#09090B';
                                        }, 2000);
                                    }
                                </script>

                                <!-- 🔍 In-App GitHub Diff Preview Modal -->
                                <div id="prDiffModal"
                                    style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(8px); z-index: 100000; align-items: center; justify-content: center; padding: 20px;">
                                    <div
                                        style="background: #121214; border: 1px solid #27272A; border-radius: 20px; width: 100%; max-width: 860px; max-height: 85vh; display: flex; flex-direction: column; box-shadow: 0 25px 60px rgba(0,0,0,0.95); overflow: hidden;">
                                        <!-- Modal Header -->
                                        <div
                                            style="padding: 20px 24px; border-bottom: 1px solid #27272A; display: flex; align-items: center; justify-content: space-between; background: #0A0A0C;">
                                            <div
                                                style="display: flex; align-items: center; gap: 12px; overflow: hidden;">
                                                <div
                                                    style="background: rgba(138, 43, 226, 0.2); border: 1px solid rgba(138, 43, 226, 0.4); padding: 5px 10px; border-radius: 20px; color: #D0BCFF; font-size: 11px; font-weight: 700; font-family: 'JetBrains Mono', monospace; display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                                                    <span
                                                        style="width: 8px; height: 8px; border-radius: 50%; background: #9B51E0; display: inline-block;"></span>
                                                    VERIFIED PR DIFF
                                                </div>
                                                <h3 id="diffTitle"
                                                    style="font-size: 15px; font-weight: 600; color: #FFF; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                                    Loading Fix Diff...</h3>
                                            </div>
                                            <div style="display: flex; align-items: center; gap: 12px; flex-shrink: 0;">
                                                <a id="diffExternalLink" href="#" target="_blank"
                                                    style="background: #27272A; color: #FFF; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px; transition: background 0.2s;">
                                                    Open in GitHub ↗
                                                </a>
                                                <button onclick="closeDiffModal()"
                                                    style="background: transparent; border: none; color: #A1A1AA; font-size: 26px; cursor: pointer; padding: 0 8px; line-height: 1;">&times;</button>
                                            </div>
                                        </div>

                                        <!-- Modal Metadata Bar -->
                                        <div
                                            style="padding: 12px 24px; background: #18181B; border-bottom: 1px solid #27272A; display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: #A1A1AA;">
                                            <div>Author: <strong id="diffAuthor"
                                                    style="color: #FFF;">@developer</strong></div>
                                            <div
                                                style="display: flex; align-items: center; gap: 16px; font-family: 'JetBrains Mono', monospace;">
                                                <span id="diffState" style="color: #6DD58C; font-weight: 700;">●
                                                    MERGED</span>
                                                <span id="diffAdditions" style="color: #6DD58C; font-weight: 600;">+0
                                                    lines</span>
                                                <span id="diffDeletions" style="color: #F2B8B5; font-weight: 600;">-0
                                                    lines</span>
                                            </div>
                                        </div>

                                        <!-- Modal Code Diff Box (Authentic GitHub Dark Pro Theme) -->
                                        <div
                                            style="padding: 20px; overflow-y: auto; flex-grow: 1; font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 13px; line-height: 1.6; background: #010409;">
                                            <div id="diffContent"
                                                style="border: 1px solid #30363D; border-radius: 10px; overflow: hidden; background: #0D1117; box-shadow: 0 4px 20px rgba(0,0,0,0.4);">
                                                <!-- Dynamically tinted diff lines will render here -->
                                            </div>
                                        </div>

                                        <!-- Modal Footer -->
                                        <div
                                            style="padding: 14px 24px; border-top: 1px solid #30363D; background: #0E1117; display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: #8B949E;">
                                            <span>🛡️ Verified code patch against production repository
                                                architecture.</span>
                                            <button onclick="copyDiffSnippet()"
                                                style="background: #21262D; border: 1px solid #363B42; color: #E6EDF3; padding: 6px 16px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 600; transition: all 0.2s;">📋
                                                Copy Patch</button>
                                        </div>
                                    </div>
                                </div>

                                <script>
                                    let activeDiffText = "";

                                    function openDiffModal(postId) {
                                        const modal = document.getElementById('prDiffModal');
                                        if (!modal) return;
                                        modal.style.display = 'flex';
                                        document.getElementById('diffTitle').textContent = 'Loading verified telemetry diff...';
                                        document.getElementById('diffContent').innerHTML = '<div style="padding: 40px; text-align: center; color: #3FB950; font-family: \'JetBrains Mono\', monospace;">⌛ Fetching raw commit patch from GitHub repository...</div>';

                                        fetch(`/api/posts/${postId}/pr-diff`)
                                            .then(res => res.json())
                                            .then(data => {
                                                if (data.success && data.metadata) {
                                                    const meta = data.metadata;
                                                    document.getElementById('diffTitle').textContent = meta.title || "Verified Production Resolution Fix";
                                                    document.getElementById('diffAuthor').textContent = `@${meta.author || "sre-core"}`;
                                                    document.getElementById('diffState').textContent = `● ${(meta.state || 'MERGED').toUpperCase()}`;
                                                    document.getElementById('diffAdditions').textContent = `+${meta.additions || 14} lines`;
                                                    document.getElementById('diffDeletions').textContent = `-${meta.deletions || 3} lines`;
                                                    document.getElementById('diffExternalLink').href = data.prUrl || "#";

                                                    activeDiffText = meta.diffSnippet || "No diff output available.";

                                                    // Render with authentic GitHub Dark Diff Engine
                                                    document.getElementById('diffContent').innerHTML = renderGitHubStyleDiff(activeDiffText);
                                                } else {
                                                    document.getElementById('diffContent').innerHTML = '<div style="padding: 20px; color: #F85149; text-align: center;">⚠️ Could not load commit patch telemetry.</div>';
                                                }
                                            })
                                            .catch(err => {
                                                document.getElementById('diffContent').innerHTML = '<div style="padding: 20px; color: #F85149; text-align: center;">⚠️ Network error loading diff telemetry.</div>';
                                            });
                                    }

                                    // Authentic GitHub Dark Dimmed 2-Column Diff Rendering Engine
                                    function renderGitHubStyleDiff(diffText) {
                                        const lines = diffText.split('\n');
                                        let html = '';
                                        let currentFile = 'src/resolution_patch.c';
                                        let oldLineNo = 1;
                                        let newLineNo = 1;

                                        lines.forEach((line, index) => {
                                            // 1. File Header (--- a/... and +++ b/...)
                                            if (line.startsWith('--- ')) return;
                                            if (line.startsWith('+++ ')) {
                                                currentFile = line.replace(/^\+\+\+ (b\/)?/, '').trim();
                                                html += `
                        <div style="background: #161B22; border-bottom: 1px solid #30363D; border-top: ${index > 1 ? '1px' : '0'} solid #30363D; padding: 10px 16px; display: flex; align-items: center; justify-content: space-between; font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 600; color: #E6EDF3;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="#8B949E"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073Z"></path></svg>
                                <span>${escapeHtml(currentFile)}</span>
                            </div>
                            <div style="font-size: 11px; color: #8B949E; border: 1px solid #30363D; padding: 2px 8px; border-radius: 6px; background: #0D1117;">View file patch</div>
                        </div>`;
                                                return;
                                            }

                                            // 2. Hunk Coordinates (@@ -208,12 +208,23 @@)
                                            if (line.startsWith('@@ ')) {
                                                const match = line.match(/@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/);
                                                if (match) {
                                                    oldLineNo = parseInt(match[1], 10);
                                                    newLineNo = parseInt(match[2], 10);
                                                }
                                                html += `
                        <div style="display: flex; background: rgba(56, 139, 253, 0.1); color: #79C0FF; border-bottom: 1px solid #21262D; font-size: 12px; font-family: 'JetBrains Mono', monospace;">
                            <div style="width: 50px; min-width: 50px; background: rgba(56, 139, 253, 0.15); color: #79C0FF; border-right: 1px solid #21262D; display: flex; align-items: center; justify-content: center; user-select: none;">•••</div>
                            <div style="width: 50px; min-width: 50px; background: rgba(56, 139, 253, 0.15); color: #79C0FF; border-right: 1px solid #30363D; display: flex; align-items: center; justify-content: center; user-select: none;">•••</div>
                            <div style="padding: 3px 16px; flex-grow: 1; overflow-x: auto; white-space: pre;">${escapeHtml(line)}</div>
                        </div>`;
                                                return;
                                            }

                                            // 3. Render Dual Gutter Line Numbers and Code
                                            let bg = "#0D1117";
                                            let gutterBg = "#0D1117";
                                            let color = "#E6EDF3";
                                            let oldDisplay = oldLineNo;
                                            let newDisplay = newLineNo;

                                            if (line.startsWith('+')) {
                                                bg = "rgba(46, 160, 67, 0.15)";
                                                gutterBg = "rgba(46, 160, 67, 0.25)";
                                                color = "#7EE787";
                                                oldDisplay = "";
                                                newDisplay = newLineNo++;
                                            } else if (line.startsWith('-')) {
                                                bg = "rgba(248, 81, 73, 0.15)";
                                                gutterBg = "rgba(248, 81, 73, 0.25)";
                                                color = "#FFA198";
                                                oldDisplay = oldLineNo++;
                                                newDisplay = "";
                                            } else {
                                                oldDisplay = oldLineNo++;
                                                newDisplay = newLineNo++;
                                            }

                                            html += `
                    <div style="display: flex; background: ${bg}; color: ${color}; border-bottom: 1px solid rgba(255,255,255,0.02); font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 13px;">
                        <!-- Old File Line Number Column -->
                        <div style="width: 50px; min-width: 50px; padding: 2px 10px; text-align: right; color: #6E7681; background: ${gutterBg}; border-right: 1px solid #21262D; user-select: none; font-size: 12px; display: flex; align-items: center; justify-content: flex-end;">${oldDisplay}</div>
                        <!-- New File Line Number Column -->
                        <div style="width: 50px; min-width: 50px; padding: 2px 10px; text-align: right; color: #6E7681; background: ${gutterBg}; border-right: 1px solid #30363D; user-select: none; font-size: 12px; display: flex; align-items: center; justify-content: flex-end;">${newDisplay}</div>
                        <!-- Verified Code Text -->
                        <div style="padding: 2px 16px; flex-grow: 1; overflow-x: auto; white-space: pre; line-height: 1.6;">${escapeHtml(line)}</div>
                    </div>`;
                                        });

                                        return html || '<div style="padding: 20px; color: #8B949E; text-align: center;">No commit diff patch contents to display.</div>';
                                    }

                                    function closeDiffModal() {
                                        const modal = document.getElementById('prDiffModal');
                                        if (modal) modal.style.display = 'none';
                                    }

                                    function copyDiffSnippet() {
                                        if (!activeDiffText) return;
                                        navigator.clipboard.writeText(activeDiffText).then(() => {
                                            alert("📋 Verified patch code copied to clipboard!");
                                        });
                                    }

                                    function escapeHtml(text) {
                                        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
                                        return String(text).replace(/[&<>"']/g, function (m) { return map[m]; });
                                    }

                                    window.addEventListener('keydown', function (e) {
                                        if (e.key === 'Escape') closeDiffModal();
                                    });

                                    document.addEventListener('DOMContentLoaded', () => {
                                        if (typeof lucide !== 'undefined') lucide.createIcons();
                                    });
                                    if (typeof lucide !== 'undefined') lucide.createIcons();
                                </script>
                                <script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
                                <script>
                                    if (typeof mermaid !== 'undefined') {
                                        mermaid.initialize({ startOnLoad: true, theme: 'dark', securityLevel: 'loose' });
                                    }
                                </script>
</body>

</html>