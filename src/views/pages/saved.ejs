<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <style>
            :root {
                --bg-base: #000000;
                --bg-surface: #0E0E12;
                --bg-surface-elevated: #16161C;
                --bg-hover: rgba(255, 255, 255, 0.05);
                --border-faint: #27272A;
                --border-hover: #3F3F46;
                --text-primary: #FFFFFF;
                --text-secondary: #A1A1AA;
                --text-muted: #71717A;
                --accent-success: #10B981;
                --accent-warning: #F59E0B;
                --accent-blue: #3B82F6;
                --accent-rose: #EF4444;
                --font-mono: 'JetBrains Mono', monospace;
                --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-sans);
                background: var(--bg-base);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
                min-height: 100vh;
                overflow-x: hidden;
            }

            .saved-layout {
                display: grid;
                grid-template-columns: 290px minmax(0, 1fr);
                gap: 0;
                max-width: 1440px;
                margin: 0 auto;
                min-height: calc(100vh - 65px);
            }

            /* ── Sidebar & Filter Navigation ── */
            .sidebar {
                border-right: 1px solid var(--border-faint);
                padding: 44px 24px 80px;
                display: flex;
                flex-direction: column;
                gap: 6px;
                position: sticky;
                top: 65px;
                height: calc(100vh - 65px);
                overflow-y: auto;
                background: var(--bg-base);
            }

            .sidebar::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: var(--border-faint);
                border-radius: 4px;
            }

            .sidebar-section-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--text-muted);
                letter-spacing: 0.8px;
                padding: 18px 12px 10px;
                font-family: var(--font-mono);
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .sidebar-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 14px;
                border-radius: 10px;
                cursor: pointer;
                color: var(--text-secondary);
                font-size: 14px;
                font-weight: 600;
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                border: 1px solid transparent;
                background: transparent;
                text-align: left;
                width: 100%;
                font-family: var(--font-sans);
                outline: none;
            }

            .sidebar-item i {
                transition: transform 0.2s;
            }

            .sidebar-item:hover {
                background: var(--bg-hover);
                color: var(--text-primary);
                transform: translateX(3px);
            }

            .sidebar-item:hover i {
                transform: scale(1.15);
            }

            .sidebar-item.active {
                background: rgba(255, 255, 255, 0.08);
                color: var(--text-primary);
                border-color: rgba(255, 255, 255, 0.15);
                font-weight: 700;
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            }

            .sidebar-item.active i {
                color: #FFFFFF !important;
                transform: scale(1.1);
            }

            .sidebar-count {
                margin-left: auto;
                font-size: 11px;
                font-family: var(--font-mono);
                background: rgba(255, 255, 255, 0.08);
                padding: 2px 8px;
                border-radius: 12px;
                color: var(--text-muted);
                transition: all 0.2s;
            }

            .sidebar-item.active .sidebar-count {
                background: #FFFFFF;
                color: #000000;
                font-weight: 800;
            }

            /* ── Main Content Area ── */
            .main-content {
                padding: 48px 52px 140px;
            }

            .content-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 36px;
                padding-bottom: 24px;
                border-bottom: 1px solid var(--border-faint);
                gap: 20px;
                flex-wrap: wrap;
            }

            .header-title-group {
                display: flex;
                align-items: center;
                gap: 16px;
                flex-wrap: wrap;
            }

            .content-title {
                font-size: 32px;
                font-weight: 900;
                letter-spacing: -1.2px;
                color: #FFFFFF;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .clear-filter-btn {
                display: none;
                align-items: center;
                gap: 6px;
                background: rgba(239, 68, 68, 0.15);
                color: var(--accent-rose);
                border: 1px solid rgba(239, 68, 68, 0.3);
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s;
                font-family: var(--font-mono);
            }

            .clear-filter-btn:hover {
                background: var(--accent-rose);
                color: #FFFFFF;
                transform: scale(1.04);
            }

            .clear-filter-btn.visible {
                display: inline-flex;
            }

            /* Sort Dropdown Toggle */
            .sort-dropdown-wrap {
                position: relative;
            }

            .sort-btn {
                background: var(--bg-surface-elevated);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                padding: 10px 18px;
                border-radius: 24px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 10px;
                font-family: var(--font-sans);
                transition: all 0.2s;
            }

            .sort-btn:hover {
                border-color: var(--border-hover);
                color: #FFFFFF;
                background: #202028;
            }

            .sort-menu {
                position: absolute;
                right: 0;
                top: calc(100% + 8px);
                background: var(--bg-surface-elevated);
                border: 1px solid var(--border-hover);
                border-radius: 12px;
                width: 200px;
                padding: 6px;
                box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8);
                z-index: 100;
                display: none;
                flex-direction: column;
                gap: 2px;
            }

            .sort-menu.show {
                display: flex;
                animation: fadeInMenu 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @keyframes fadeInMenu {
                from {
                    opacity: 0;
                    transform: translateY(-8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .sort-item {
                padding: 10px 14px;
                font-size: 13px;
                color: var(--text-secondary);
                border-radius: 8px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: transparent;
                border: none;
                text-align: left;
                width: 100%;
                font-family: var(--font-sans);
                font-weight: 500;
            }

            .sort-item:hover {
                background: rgba(255, 255, 255, 0.06);
                color: #FFFFFF;
            }

            .sort-item.active {
                color: var(--accent-blue);
                font-weight: 700;
            }

            /* ── Saved Posts Grid & Card Styling ── */
            .posts-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
                gap: 28px;
                position: relative;
                min-height: 400px;
            }

            @keyframes cardCascade {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(0.97);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            .post-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 20px;
                overflow: hidden;
                text-decoration: none;
                display: flex;
                flex-direction: column;
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                position: relative;
                animation: cardCascade 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                opacity: 0;
                box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
            }

            .post-card:hover {
                border-color: var(--border-hover);
                transform: translateY(-6px) scale(1.01);
                background: var(--bg-surface-elevated);
                box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.8), 0 0 20px -5px rgba(255, 255, 255, 0.08);
                z-index: 2;
            }

            .card-cover-wrapper {
                position: relative;
                width: 100%;
                height: 180px;
                overflow: hidden;
                border-bottom: 1px solid var(--border-faint);
            }

            .card-cover {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .post-card:hover .card-cover {
                transform: scale(1.06);
            }

            .card-cover-overlay {
                position: absolute;
                inset: 0;
                background: linear-gradient(to top, rgba(14, 14, 18, 0.95) 0%, rgba(14, 14, 18, 0.2) 60%, transparent 100%);
            }

            .card-body {
                padding: 24px 26px 20px;
                flex: 1;
                display: flex;
                flex-direction: column;
                gap: 14px;
                position: relative;
            }

            .card-status {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }

            .status-badge {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                font-family: var(--font-mono);
                padding: 4px 12px;
                border-radius: 20px;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid var(--border-faint);
            }

            .status-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
            }

            .status-dot.resolved {
                background: var(--accent-success);
                box-shadow: 0 0 10px var(--accent-success);
            }

            .status-dot.investigating {
                background: var(--accent-warning);
                box-shadow: 0 0 10px var(--accent-warning);
            }

            .status-badge.resolved {
                color: var(--accent-success);
                border-color: rgba(16, 185, 129, 0.3);
                background: rgba(16, 185, 129, 0.1);
            }

            .status-badge.investigating {
                color: var(--accent-warning);
                border-color: rgba(245, 158, 11, 0.3);
                background: rgba(245, 158, 11, 0.1);
            }

            /* Author pill inside card */
            .author-pill {
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
                transition: color 0.2s;
            }

            .author-avatar {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                object-fit: cover;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }

            .author-pill:hover {
                color: #FFFFFF;
            }

            .card-title {
                font-size: 19px;
                font-weight: 800;
                color: var(--text-primary);
                letter-spacing: -0.5px;
                line-height: 1.35;
                transition: color 0.2s;
            }

            .post-card:hover .card-title {
                color: #FFFFFF;
                text-decoration: underline;
                text-underline-offset: 4px;
            }

            .card-excerpt {
                font-size: 14px;
                color: var(--text-secondary);
                line-height: 1.6;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
                flex: 1;
            }

            .card-tags {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
                margin-top: 2px;
            }

            .tag {
                font-family: var(--font-mono);
                font-size: 11px;
                padding: 4px 10px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.04);
                color: var(--text-secondary);
                border: 1px solid rgba(255, 255, 255, 0.08);
                transition: all 0.2s;
                font-weight: 500;
                cursor: pointer;
            }

            .tag:hover {
                background: rgba(59, 130, 246, 0.15);
                border-color: var(--accent-blue);
                color: #FFFFFF;
                transform: translateY(-1px);
            }

            .card-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 26px;
                background: rgba(0, 0, 0, 0.4);
                border-top: 1px solid var(--border-faint);
                margin-top: auto;
            }

            .metrics {
                display: flex;
                gap: 18px;
                font-size: 12px;
                color: var(--text-muted);
                font-family: var(--font-mono);
                font-weight: 600;
            }

            .metric {
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .metric i {
                transition: transform 0.2s, color 0.2s;
            }

            .post-card:hover .metric i {
                color: var(--text-secondary);
                transform: scale(1.1);
            }

            .remove-btn {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                cursor: pointer;
                padding: 8px 12px;
                border-radius: 14px;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 12px;
                font-weight: 600;
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
                font-family: var(--font-sans);
                z-index: 10;
            }

            .remove-btn:hover {
                background: var(--accent-rose);
                border-color: var(--accent-rose);
                color: #FFFFFF;
                transform: scale(1.05);
                box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
            }

            .remove-btn:active {
                transform: scale(0.96);
            }

            @keyframes spin {
                100% {
                    transform: rotate(360deg);
                }
            }

            .spinner-icon {
                animation: spin 1s linear infinite;
                display: inline-block;
                width: 14px;
                height: 14px;
                border: 2px solid rgba(255, 255, 255, 0.3);
                border-top-color: #FFFFFF;
                border-radius: 50%;
            }

            .empty-state {
                text-align: center;
                padding: 100px 24px;
                grid-column: 1/-1;
                background: var(--bg-surface);
                border: 1px dashed var(--border-faint);
                border-radius: 20px;
            }

            .empty-state-icon {
                width: 72px;
                height: 72px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--border-faint);
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 24px;
            }

            .empty-state h3 {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-primary);
                margin-bottom: 12px;
                letter-spacing: -0.5px;
            }

            .empty-state p {
                color: var(--text-secondary);
                max-width: 420px;
                margin: 0 auto 32px;
                font-size: 15px;
                line-height: 1.6;
            }

            .btn-primary {
                background: #FFFFFF;
                color: #000000;
                border: none;
                padding: 12px 24px;
                border-radius: 24px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
                font-family: var(--font-sans);
                transition: all 0.25s;
                box-shadow: 0 4px 20px rgba(255, 255, 255, 0.15);
            }

            .btn-primary:hover {
                transform: scale(1.05);
                box-shadow: 0 6px 25px rgba(255, 255, 255, 0.3);
                background: #F3F4F6;
            }

            .mobile-filter-bar {
                display: none;
                gap: 8px;
                overflow-x: auto;
                padding-bottom: 12px;
                margin-bottom: 24px;
                scrollbar-width: none;
            }
            .mobile-filter-bar::-webkit-scrollbar { display: none; }
            .mobile-filter-pill {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 8px 16px;
                border-radius: 999px;
                background: var(--bg-surface-elevated);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
                white-space: nowrap;
                cursor: pointer;
                transition: all 0.2s;
            }
            .mobile-filter-pill.active {
                background: #FFFFFF;
                color: #000000;
                border-color: #FFFFFF;
                font-weight: 700;
            }
            @media (max-width: 900px) {
                .mobile-filter-bar {
                    display: flex;
                }
                .saved-layout {
                    grid-template-columns: 1fr;
                }
                .sidebar {
                    display: none;
                }
                .main-content {
                    padding: 36px 20px 100px;
                }
                .posts-grid {
                    grid-template-columns: 1fr;
                }
                .content-title {
                    font-size: 26px;
                }
            }
        </style>
</head>

<body>
    <%- include('../partials/header') %>

        <div class="saved-layout">
            <nav class="sidebar" id="saved-sidebar">
                <span class="sidebar-section-title">
                    <span>Collections</span>
                    <i data-lucide="folder" style="width:14px; color:var(--text-muted);"></i>
                </span>
                <button class="sidebar-item active" data-filter-type="collection" data-filter-value="all">
                    <i data-lucide="bookmark-check" style="color: #60A5FA;"></i> All Saved
                    <span class="sidebar-count" id="count-all">
                        <%= savedPosts.length %>
                    </span>
                </button>
                <button class="sidebar-item" data-filter-type="collection" data-filter-value="resolved">
                    <i data-lucide="check-circle" style="color: var(--accent-success);"></i> Resolved
                    <span class="sidebar-count" id="count-resolved">
                        <%= savedPosts.filter(p=> p.status === 'resolved' || p.githubPrUrl).length %>
                    </span>
                </button>
                <button class="sidebar-item" data-filter-type="collection" data-filter-value="investigating">
                    <i data-lucide="alert-triangle" style="color: var(--accent-warning);"></i> Investigating
                    <span class="sidebar-count" id="count-investigating">
                        <%= savedPosts.filter(p=> p.status !== 'resolved' && !p.githubPrUrl).length %>
                    </span>
                </button>

                <span class="sidebar-section-title" style="margin-top:24px;">
                    <span>Tags</span>
                    <i data-lucide="tag" style="width:14px; color:var(--text-muted);"></i>
                </span>
                <% const savedTagCounts={}; savedPosts.forEach(p=> {
                    (p.tags || []).forEach(t => {
                    const tName = (t.name || t).replace(/^#/, '').toLowerCase();
                    savedTagCounts[tName] = (savedTagCounts[tName] || 0) + 1;
                    });
                    });
                    const sortedTags = Object.entries(savedTagCounts).sort((a, b) => b[1] - a[1]).slice(0, 8);
                    %>
                    <% if (sortedTags.length> 0) { %>
                        <% sortedTags.forEach(([tag, count])=> { %>
                            <button class="sidebar-item" data-filter-type="tag" data-filter-value="<%= tag %>">
                                <i data-lucide="hash" style="color:#A1A1AA;"></i>
                                <%= tag %>
                                    <span class="sidebar-count">
                                        <%= count %>
                                    </span>
                            </button>
                            <% }) %>
                                <% } else { %>
                                    <div
                                        style="color:var(--text-muted); font-size:12px; padding: 12px 14px; font-family:var(--font-mono);">
                                        No tags in saved items</div>
                                    <% } %>
            </nav>

            <main class="main-content">
                <div class="mobile-filter-bar" id="mobile-filter-bar">
                    <button class="mobile-filter-pill active" data-filter-type="collection" data-filter-value="all">
                        <i data-lucide="bookmark-check" style="width:14px;"></i> All (<%= savedPosts.length %>)
                    </button>
                    <button class="mobile-filter-pill" data-filter-type="collection" data-filter-value="resolved">
                        <i data-lucide="check-circle" style="width:14px;"></i> Resolved (<%= savedPosts.filter(p=> p.status === 'resolved' || p.githubPrUrl).length %>)
                    </button>
                    <button class="mobile-filter-pill" data-filter-type="collection" data-filter-value="investigating">
                        <i data-lucide="alert-triangle" style="width:14px;"></i> Investigating (<%= savedPosts.filter(p=> p.status !== 'resolved' && !p.githubPrUrl).length %>)
                    </button>
                    <% if (typeof sortedTags !== 'undefined' && sortedTags.length > 0) { %>
                        <% sortedTags.forEach(([tag, count]) => { %>
                            <button class="mobile-filter-pill" data-filter-type="tag" data-filter-value="<%= tag %>">
                                #<%= tag %> (<%= count %>)
                            </button>
                        <% }) %>
                    <% } %>
                </div>

                <div class="content-header">
                    <div class="header-title-group">
                        <h1 class="content-title" id="active-view-title">
                            <i data-lucide="bookmark-check" style="color:#60A5FA; width:32px; height:32px;"></i>
                            All Saved Items
                        </h1>
                        <button class="clear-filter-btn" id="btn-clear-filter" title="Reset view to all saved items">
                            <span>Reset Filter</span> <i data-lucide="x" style="width:14px;"></i>
                        </button>
                    </div>

                    <div class="sort-dropdown-wrap">
                        <button class="sort-btn" id="sort-toggle-btn">
                            <i data-lucide="arrow-down-up" style="width:15px; color:var(--accent-blue);"></i>
                            <span id="sort-current-label">Newest First</span>
                            <i data-lucide="chevron-down" style="width:15px;"></i>
                        </button>
                        <div class="sort-menu" id="sort-menu">
                            <button class="sort-item active" data-sort="newest">Newest First <i data-lucide="check" style="width:14px;"></i></button>
                            <button class="sort-item" data-sort="oldest">Oldest First</button>
                            <button class="sort-item" data-sort="upvotes">Most Upvoted <i data-lucide="trending-up" style="width:14px; display:inline-block; margin-left:4px;"></i></button>
                            <button class="sort-item" data-sort="views">Most Viewed <i data-lucide="eye" style="width:14px; display:inline-block; margin-left:4px;"></i></button>
                        </div>
                    </div>
                </div>

                <div class="posts-grid" id="saved-cards-grid">
                    <!-- Javascript will render and animate filtered/sorted cards here -->
                </div>
                <div id="saved-posts-data" style="display:none;" data-json="<%= encodeURIComponent(JSON.stringify(typeof savedPosts !== 'undefined' ? savedPosts : [])) %>"></div>
            </main>
        </div>

        <%- include('../partials/footer') %>
            <script>
                if (typeof lucide !== 'undefined') lucide.createIcons();

                // ── Client-Side Interactive Data Store ──
                let allSavedPosts = [];
                try {
                    const dataEl = document.getElementById('saved-posts-data');
                    if (dataEl && dataEl.getAttribute('data-json')) {
                        allSavedPosts = JSON.parse(decodeURIComponent(dataEl.getAttribute('data-json')));
                    }
                } catch (e) {
                    console.error('Error loading saved investigations:', e);
                }
                let currentFilterType = 'collection';
                let currentFilterValue = 'all';
                let currentSort = 'newest';

                const gridContainer = document.getElementById('saved-cards-grid');
                const viewTitleEl = document.getElementById('active-view-title');
                const clearBtn = document.getElementById('btn-clear-filter');

                // ── Render & Animation Engine ──
                function renderSavedCards() {
                    // 1. Filter Posts
                    let filtered = allSavedPosts.filter(post => {
                        if (currentFilterType === 'collection') {
                            if (currentFilterValue === 'all') return true;
                            if (currentFilterValue === 'resolved') return post.status === 'resolved' || post.githubPrUrl;
                            if (currentFilterValue === 'investigating') return post.status !== 'resolved' && !post.githubPrUrl;
                        } else if (currentFilterType === 'tag') {
                            const postTags = (post.tags || []).map(t => (t.name || t).replace(/^#/, '').toLowerCase());
                            return postTags.includes(currentFilterValue);
                        }
                        return true;
                    });

                    // 2. Sort Posts
                    filtered.sort((a, b) => {
                        if (currentSort === 'newest') {
                            return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
                        } else if (currentSort === 'oldest') {
                            return new Date(a.createdAt || 0) - new Date(b.createdAt || 0);
                        } else if (currentSort === 'upvotes') {
                            return (b.upvotes || 0) - (a.upvotes || 0);
                        } else if (currentSort === 'views') {
                            return (b.views || 0) - (a.views || 0);
                        }
                    });

                    // 3. Update Title and Clear Button
                    if (currentFilterType === 'collection' && currentFilterValue === 'all') {
                        viewTitleEl.innerHTML = `<i data-lucide="bookmark-check" style="color:#60A5FA; width:32px; height:32px;"></i> All Saved Items (${filtered.length})`;
                        clearBtn.classList.remove('visible');
                    } else if (currentFilterType === 'collection') {
                        const icon = currentFilterValue === 'resolved' ? 'check-circle' : 'alert-triangle';
                        const color = currentFilterValue === 'resolved' ? '#10B981' : '#F59E0B';
                        const name = currentFilterValue.charAt(0).toUpperCase() + currentFilterValue.slice(1);
                        viewTitleEl.innerHTML = `<i data-lucide="${icon}" style="color:${color}; width:32px; height:32px;"></i> ${name} Collection (${filtered.length})`;
                        clearBtn.classList.add('visible');
                    } else if (currentFilterType === 'tag') {
                        viewTitleEl.innerHTML = `<i data-lucide="hash" style="color:#A1A1AA; width:32px; height:32px;"></i> Tag: #${currentFilterValue} (${filtered.length})`;
                        clearBtn.classList.add('visible');
                    }

                    // 4. Render Grid HTML
                    if (filtered.length === 0) {
                        gridContainer.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">
                            <i data-lucide="bookmark-x" style="width:36px;height:36px;color:var(--text-muted);"></i>
                        </div>
                        <h3>No matching saved items found</h3>
                        <p>There are no investigations matching this filter criteria in your saved library.</p>
                        ${currentFilterValue !== 'all' ? `<button class="btn-primary" onclick="resetFilter()">View All Saved (${allSavedPosts.length})</button>` : `<a href="/" class="btn-primary"><i data-lucide="compass" style="width:16px;"></i> Explore Feed</a>`}
                    </div>
                `;
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                        return;
                    }

                    gridContainer.innerHTML = filtered.map((post, idx) => {
                        const isResolved = post.status === 'resolved' || post.githubPrUrl;
                        const statusClass = isResolved ? 'resolved' : 'investigating';
                        const statusText = isResolved ? 'Resolved' : (post.status || 'Investigating');
                        const coverHtml = post.coverImage ? `
                    <div class="card-cover-wrapper">
                        <img src="${post.coverImage}" alt="${post.title}" class="card-cover" loading="lazy" />
                        <div class="card-cover-overlay"></div>
                    </div>
                ` : '';

                        const author = post.author || {};
                        const authorUsername = author.username || 'developer';
                        const authorDisplayName = author.displayName || authorUsername;
                        const authorAvatar = author.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(authorDisplayName)}&background=27272A&color=fff`;

                        const tagsHtml = (post.tags || []).slice(0, 4).map(t => {
                            const tName = (t.name || t).replace(/^#/, '');
                            return `<span class="tag" onclick="filterByTag('${tName.toLowerCase()}', event)">#${tName}</span>`;
                        }).join('');

                        return `
                    <a href="/incidents/${post.slug || post._id}" class="post-card" style="animation-delay: ${idx * 0.06}s;" id="card-${post._id}">
                        ${coverHtml}
                        <div class="card-body">
                            <div class="card-status">
                                <div class="status-badge ${statusClass}">
                                    <span class="status-dot ${statusClass}"></span>
                                    <span>${statusText}</span>
                                </div>
                                <div class="author-pill" onclick="event.stopPropagation()">
                                    <img src="${authorAvatar}" alt="@${authorUsername}" class="author-avatar" />
                                    <span>@${authorUsername}</span>
                                </div>
                            </div>
                            <h2 class="card-title">${post.title}</h2>
                            <p class="card-excerpt">${post.excerpt || (post.content ? post.content.substring(0, 140) + '...' : 'Investigation log...')}</p>
                            <div class="card-tags">${tagsHtml}</div>
                        </div>
                        <div class="card-footer">
                            <div class="metrics">
                                <span class="metric" title="Upvotes"><i data-lucide="arrow-up" style="width:14px; color:var(--accent-success);"></i> ${post.upvotes || 0}</span>
                                <span class="metric" title="Views"><i data-lucide="eye" style="width:14px;"></i> ${(post.views || 0).toLocaleString()}</span>
                            </div>
                            <button type="button" class="remove-btn" onclick="removeBookmark('${post._id}', this, event)" title="Remove from your saved bookmarks">
                                <i data-lucide="trash-2" style="width:14px;"></i> Remove
                            </button>
                        </div>
                    </a>
                `;
                    }).join('');

                    if (typeof lucide !== 'undefined') lucide.createIcons();
                }

                // ── Universal Filter & Sidebar Click Handlers ──
                function setFilter(type, value) {
                    currentFilterType = type;
                    currentFilterValue = value;
                    
                    document.querySelectorAll('#saved-sidebar .sidebar-item').forEach(b => {
                        b.classList.toggle('active', b.getAttribute('data-filter-type') === type && b.getAttribute('data-filter-value') === value);
                    });
                    document.querySelectorAll('#mobile-filter-bar .mobile-filter-pill').forEach(p => {
                        p.classList.toggle('active', p.getAttribute('data-filter-type') === type && p.getAttribute('data-filter-value') === value);
                    });
                    
                    renderSavedCards();
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }

                document.querySelectorAll('#saved-sidebar .sidebar-item, #mobile-filter-bar .mobile-filter-pill').forEach(btn => {
                    btn.addEventListener('click', () => {
                        setFilter(btn.getAttribute('data-filter-type'), btn.getAttribute('data-filter-value'));
                    });
                });

                function filterByTag(tag, e) {
                    if (e) { e.preventDefault(); e.stopPropagation(); }
                    setFilter('tag', tag.toLowerCase());
                }

                function resetFilter() {
                    setFilter('collection', 'all');
                }

                if (clearBtn) clearBtn.addEventListener('click', resetFilter);

                // ── Sort Dropdown Handlers ──
                const sortToggleBtn = document.getElementById('sort-toggle-btn');
                const sortMenu = document.getElementById('sort-menu');
                const sortLabel = document.getElementById('sort-current-label');

                if (sortToggleBtn && sortMenu) {
                    sortToggleBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        sortMenu.classList.toggle('show');
                    });

                    document.addEventListener('click', () => sortMenu.classList.remove('show'));

                    sortMenu.querySelectorAll('.sort-item').forEach(item => {
                        item.addEventListener('click', () => {
                            sortMenu.querySelectorAll('.sort-item').forEach(i => {
                                i.classList.remove('active');
                                const checkIcon = i.querySelector('i');
                                if (checkIcon) checkIcon.remove();
                            });
                            item.classList.add('active');
                            item.innerHTML += ' <i data-lucide="check" style="width:14px;"></i>';
                            currentSort = item.getAttribute('data-sort');
                            sortLabel.innerText = item.innerText.trim();
                            renderSavedCards();
                        });
                    });
                }

                // ── High-Fidelity Bookmark Removal via API ──
                async function removeBookmark(postId, btn, event) {
                    if (event) { event.preventDefault(); event.stopPropagation(); }

                    // Show loading spinner
                    btn.innerHTML = `<span class="spinner-icon"></span> Removing...`;
                    btn.style.pointerEvents = 'none';
                    btn.style.background = 'rgba(239, 68, 68, 0.2)';
                    btn.style.borderColor = '#EF4444';
                    btn.style.color = '#EF4444';

                    try {
                        const res = await fetch(`/api/posts/${postId}/save`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        });
                        const data = await res.json();

                        if (data.success) {
                            const card = document.getElementById(`card-${postId}`);
                            if (card) {
                                card.style.transition = 'all 0.35s cubic-bezier(0.16, 1, 0.3, 1)';
                                card.style.transform = 'scale(0.85) translateY(20px)';
                                card.style.opacity = '0';

                                setTimeout(() => {
                                    // Update client store & counts
                                    allSavedPosts = allSavedPosts.filter(p => String(p._id) !== String(postId));
                                    document.getElementById('count-all').innerText = allSavedPosts.length;
                                    const resCountEl = document.getElementById('count-resolved');
                                    if (resCountEl) resCountEl.innerText = allSavedPosts.filter(p => p.status === 'resolved' || p.githubPrUrl).length;
                                    const invCountEl = document.getElementById('count-investigating');
                                    if (invCountEl) invCountEl.innerText = allSavedPosts.filter(p => p.status !== 'resolved' && !p.githubPrUrl).length;

                                    if (typeof showToast === 'function') showToast('Removed from saved investigations.', 'success');
                                    renderSavedCards();
                                }, 350);
                            }
                        } else {
                            btn.innerHTML = `<i data-lucide="trash-2" style="width:14px;"></i> Remove`;
                            btn.style.pointerEvents = 'auto';
                            alert(data.message || 'Failed to remove bookmark.');
                        }
                    } catch (err) {
                        console.error('Failed to remove saved post:', err);
                        btn.innerHTML = `<i data-lucide="trash-2" style="width:14px;"></i> Remove`;
                        btn.style.pointerEvents = 'auto';
                        alert('Network error while updating saved investigations.');
                    }
                }

                // Initial Render on Load
                document.addEventListener('DOMContentLoaded', renderSavedCards);
                renderSavedCards();
            </script>
</body>

</html>