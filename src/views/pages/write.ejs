        // --- DYNAMIC STEP ADDERS & MERMAID RENDERER ---
        function addWhyStep(btn) {
            const container = btn.previousElementSibling;
            const idx = container.children.length + 1;
            const div = document.createElement('div');
            div.className = 'why-card-row';
            div.innerHTML = `
                <div class="why-num-node">${idx}</div>
                <div class="why-body-card">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <input type="text" class="why-q-input" value="WHY DID THIS OCCUR?" placeholder="WHY DID THIS OCCUR?">
                        <button type="button" class="step-delete-btn" onclick="removeWhyStep(this)" title="Delete step"><i data-lucide="x" style="width:14px;"></i></button>
                    </div>
                    <div class="why-ans-editable" contenteditable="true" data-placeholder="Explain the technical cause..."></div>
                </div>
            `;
            container.appendChild(div);
            lucide.createIcons();
            const editable = div.querySelector('.why-ans-editable');
            if (editable) editable.focus();
        }

        function removeWhyStep(btn) {
            const row = btn.closest('.why-card-row');
            const container = row.parentElement;
            row.remove();
            container.querySelectorAll('.why-num-node').forEach((el, i) => el.innerText = i + 1);
        }

        function addActionItem(btn) {
            const container = btn.previousElementSibling;
            const div = document.createElement('div');
            div.className = 'action-row';
            div.innerHTML = `
                <div class="action-checkbox" onclick="toggleActionCheck(this)" data-completed="false"></div>
                <select class="action-priority-select">
                    <option value="P0">P0 Blocker</option>
                    <option value="P1" selected>P1 High</option>
                    <option value="P2">P2 Medium</option>
                    <option value="P3">P3 Low</option>
                </select>
                <div class="action-text-editable" contenteditable="true" data-placeholder="Describe preventive engineering action item..."></div>
                <input type="text" class="action-owner-input" placeholder="@owner" value="@sre-team">
                <button type="button" class="step-delete-btn" onclick="this.closest('.action-row').remove()" title="Remove task"><i data-lucide="x" style="width:14px;"></i></button>
            `;
            container.appendChild(div);
            lucide.createIcons();
            const editable = div.querySelector('.action-text-editable');
            if (editable) editable.focus();
        }

        function toggleActionCheck(el) {
            const isCompleted = el.getAttribute('data-completed') === 'true';
            if (isCompleted) {
                el.setAttribute('data-completed', 'false');
                el.classList.remove('checked');
                el.innerHTML = '';
            } else {
                el.setAttribute('data-completed', 'true');
                el.classList.add('checked');
                el.innerHTML = `<i data-lucide="check" style="width:13px;height:13px;"></i>`;
                lucide.createIcons();
            }
        }

        async function renderMermaidPreview(btn) {
            const container = btn.closest('.mermaid-studio');
            const textarea = container.querySelector('.mermaid-editor-textarea');
            const previewBox = container.querySelector('.mermaid-preview-box');
            const code = textarea.value.trim();

            if (!code) {
                previewBox.innerHTML = '<div style="color:#EF4444; font-size:13px;">Please enter valid Mermaid diagram syntax above.</div>';
                return;
            }

            try {
                previewBox.innerHTML = `<div class="mermaid" id="m-${Math.random().toString(36).substring(7)}">${code}</div>`;
                if (typeof mermaid !== 'undefined') {
                    await mermaid.run({ nodes: [previewBox.querySelector('.mermaid')] });
                }
                showToast("Diagram Rendered", "Live architectural flowchart updated");
            } catch (err) {
                previewBox.innerHTML = `<div style="color:#F87171; font-family:'JetBrains Mono',monospace; font-size:12px;">Mermaid syntax error: Check nodes & directional arrows</div>`;
            }
        }

        function moveBlock(btn, direction) {
            const block = btn.closest('.editor-block');
            if (!block) return;
            if (direction === -1 && block.previousElementSibling) {
                canvas.insertBefore(block, block.previousElementSibling);
            } else if (direction === 1 && block.nextElementSibling) {
                canvas.insertBefore(block.nextElementSibling, block);
            }
        }

        function deleteBlock(btn) {
            const block = btn.closest('.editor-block');
            if (block && (canvas.children.length > 1 || confirm("Remove this block?"))) {
                block.style.transform = 'scale(0.95)';
                block.style.opacity = '0';
                setTimeout(() => {
                    block.remove();
                    if (canvas.children.length === 0) addBlock('paragraph');
                    updateStats();
                }, 180);
            }
        }

        function duplicateBlock(btn) {
            const block = btn.closest('.editor-block');
            if (!block) return;
            const clone = block.cloneNode(true);
            canvas.insertBefore(clone, block.nextSibling);
            lucide.createIcons();
            showToast("Block Duplicated", "Added directly below");
        }

        function addTimelineStep(btn) {
            const container = btn.previousElementSibling;
            const stepDiv = document.createElement('div');
            stepDiv.className = 'timeline-step-row';
            stepDiv.innerHTML = `
                <div class="timeline-node"></div>
                <div class="timeline-content-card">
                    <div class="timeline-meta-bar">
                        <input type="text" class="step-time-input" placeholder="14:15 UTC" value="${new Date().getUTCHours().toString().padStart(2,'0')}:${new Date().getUTCMinutes().toString().padStart(2,'0')} UTC">
                        <select class="step-status-select">
                            <option value="update">Update</option>
                            <option value="mitigation">Mitigation</option>
                            <option value="investigation">Investigation</option>
                            <option value="resolution">Resolution</option>
                        </select>
                        <input type="text" class="step-actor-input" placeholder="Actor (@engineer)" value="">
                        <button type="button" class="step-delete-btn" onclick="this.closest('.timeline-step-row').remove()" title="Delete Step"><i data-lucide="x" style="width:16px;height:16px;"></i></button>
                    </div>
                    <div class="step-desc-editable" contenteditable="true" data-placeholder="Describe architectural update or fix..."></div>
                </div>
            `;
            container.appendChild(stepDiv);
            lucide.createIcons();
            const editable = stepDiv.querySelector('.step-desc-editable');
