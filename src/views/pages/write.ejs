        function handleImageUpload(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const container = input.closest('.image-studio');
                    container.querySelector('.image-drop-zone').style.display = 'none';
                    const img = container.querySelector('.image-preview-el');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    showToast("Image Uploaded", "Ready for live rendering");
                }
                reader.readAsDataURL(file);
            }
        }

        // --- ICON PICKER LOGIC ---
        let currentIconButton = null;
        const availableIcons = [
            'hash', 'server', 'cloud', 'cpu', 'shield-alert', 'shield-check', 'database', 'terminal', 
            'activity', 'zap', 'alert-triangle', 'alert-circle', 'info', 'check-circle-2', 'file-text', 
            'lock', 'unlock', 'globe', 'layers', 'life-buoy', 'radio', 'wifi', 'settings', 'sliders', 
            'tool', 'wrench', 'flame', 'bug', 'code', 'git-branch', 'git-merge', 'hard-drive', 'monitor'
        ];

        function openIconPicker(btn) {
            currentIconButton = btn;
            const modal = document.getElementById('icon-modal');
            const grid = document.getElementById('icons-grid');
            grid.innerHTML = '';
            
            availableIcons.forEach(ic => {
                const b = document.createElement('button');
                b.type = 'button';
                b.className = 'icon-choice-btn';
                b.innerHTML = `<i data-lucide="${ic}" style="width: 22px;"></i>`;
                b.onclick = () => selectIcon(ic);
                grid.appendChild(b);
            });
            
            modal.classList.add('open');
            lucide.createIcons();
            setTimeout(() => document.getElementById('icon-search-input').focus(), 50);
        }

        function filterIcons(query) {
            const grid = document.getElementById('icons-grid');
            grid.querySelectorAll('.icon-choice-btn').forEach(btn => {
                const ic = btn.querySelector('svg')?.getAttribute('class') || '';
                btn.style.display = ic.toLowerCase().includes(query.toLowerCase()) ? 'flex' : 'none';
            });
        }

        function selectIcon(iconName) {
            if (currentIconButton) {
                currentIconButton.setAttribute('data-icon', iconName);
                currentIconButton.innerHTML = `<i data-lucide="${iconName}" style="width: 20px;"></i>`;
                lucide.createIcons();
            }
            closeIconPicker();
        }

        function closeIconPicker() {
            document.getElementById('icon-modal').classList.remove('open');
            currentIconButton = null;
        }

        // --- TOAST NOTIFICATION ---
        function showToast(title, msg = "", isError = false) {
            const t = document.getElementById('studio-toast');
            const txt = document.getElementById('toast-text');
            const icon = document.getElementById('toast-icon');
            
            txt.innerHTML = `<strong>${title}</strong>${msg ? ` &mdash; ${msg}` : ''}`;
            t.className = `studio-toast show ${isError ? 'error-toast' : ''}`;
            
            if (isError) {
                icon.setAttribute('data-lucide', 'alert-circle');
                icon.style.color = '#EF4444';
            } else {
                icon.setAttribute('data-lucide', 'check-circle');
                icon.style.color = '#10B981';
            }
            lucide.createIcons();
            
            setTimeout(() => t.classList.remove('show'), 3800);
        }

        // --- GATHER PAYLOAD (WITH ADVANCED BLOCKS & BLAST RADIUS) ---
        function getPostPayload(isDraft = false) {
            const title = document.getElementById('post-title').value.trim();
            const tags = currentTags;
            const severity = document.getElementById('post-severity').value;
            const status = document.getElementById('post-status').value;
            const investigationHours = parseFloat(document.getElementById('post-hours').value) || 0;
            const slaImpact = document.getElementById('post-sla-impact').value.trim();
            const affectedScale = document.getElementById('post-affected-scale').value.trim();
            let excerpt = document.getElementById('post-excerpt').value.trim();

            const blocksData = [];
            let coverImage = "";

            document.querySelectorAll('.editor-block').forEach((block) => {
                const type = block.getAttribute('data-type');
                let blockObj = { type: type };

                if (type === 'paragraph') {
                    blockObj.content = block.querySelector('.content-p')?.innerHTML || '';
                    if (!excerpt && blockObj.content) {
                        const div = document.createElement('div');
                        div.innerHTML = blockObj.content;
                        excerpt = div.innerText.substring(0, 180) + '...';
                    }
                }
                else if (type === 'custom-heading') {
                    blockObj.icon = block.querySelector('.heading-icon-btn')?.getAttribute('data-icon') || 'hash';
                    blockObj.heading = block.querySelector('.content-h2')?.innerHTML || '';
                    blockObj.content = blockObj.heading;
                }
                else if (type === 'list') {
                    const items = [];
                    block.querySelectorAll('.content-list li').forEach(li => {
                        if (li.innerText.trim() !== "") items.push(li.innerHTML);
                    });
                    blockObj.items = items;
                }
                else if (type === 'symptom' || type === 'investigation' || type === 'rootCause' || type === 'resolution') {
                    blockObj.content = block.querySelector('.pillar-body')?.innerHTML || '';
                }
                else if (type === 'quote' || type === 'alert' || type === 'info') {
                    blockObj.content = block.querySelector('.content-callout')?.innerHTML || '';
                    if (type === 'alert' || type === 'info') {
                        blockObj.icon = block.querySelector('button[data-icon]')?.getAttribute('data-icon') || type;
                    }
                }
                else if (type === 'image') {
                    const img = block.querySelector('.image-preview-el');
                    if (img && img.src && img.src !== "" && !img.src.includes('undefined')) {
                        blockObj.src = img.src;
                        blockObj.caption = block.querySelector('.image-caption-input')?.value || '';
                        if (!coverImage) coverImage = img.src;
                    }
                }
                else if (type === 'terminal') {
                    blockObj.content = block.querySelector('.content-terminal')?.innerText || '';
                }
                else if (type === 'code') {
                    blockObj.language = block.querySelector('.code-lang-select')?.value || 'javascript';
                    blockObj.content = block.querySelector('.content-code')?.innerText || '';
                }
                else if (type === 'divider') {
                    blockObj.content = "---";
                }
                else if (type === 'timeline') {
                    const steps = [];
                    block.querySelectorAll('.timeline-step-row').forEach(node => {
                        const content = node.querySelector('.step-desc-editable')?.innerHTML || '';
                        const time = node.querySelector('.step-time-input')?.value || 'Update';
                        const status = node.querySelector('.step-status-select')?.value || 'update';
                        const actor = node.querySelector('.step-actor-input')?.value || '';
                        if (content.trim() !== "") steps.push({ time, status, actor, content, description: content });
                    });
                    blockObj.steps = steps;
                }
                else if (type === 'five-whys') {
                    const whys = [];
                    block.querySelectorAll('.why-card-row').forEach(node => {
                        const q = node.querySelector('.why-q-input')?.value || 'WHY DID THIS OCCUR?';
                        const a = node.querySelector('.why-ans-editable')?.innerHTML || '';
                        if (a.trim() !== "" || q.trim() !== "") whys.push({ question: q, answer: a, content: a });
                    });
                    blockObj.whys = whys;
                }
                else if (type === 'action-items') {
                    const tasks = [];
                    block.querySelectorAll('.action-row').forEach(node => {
                        const completed = node.querySelector('.action-checkbox')?.getAttribute('data-completed') === 'true';
                        const priority = node.querySelector('.action-priority-select')?.value || 'P1';
                        const task = node.querySelector('.action-text-editable')?.innerHTML || '';
                        const owner = node.querySelector('.action-owner-input')?.value || '';
                        if (task.trim() !== "") tasks.push({ completed, priority, task, content: task, owner });
                    });
                    blockObj.items = tasks;
                }
                else if (type === 'mermaid') {
                    blockObj.code = block.querySelector('.mermaid-editor-textarea')?.value || '';
                    blockObj.content = blockObj.code;
                }

                if (isDraft || blockObj.content || (blockObj.items && blockObj.items.length) || (blockObj.steps && blockObj.steps.length) || (blockObj.whys && blockObj.whys.length) || blockObj.heading || blockObj.src || blockObj.code) {
                    blocksData.push(blockObj);
                }
            });

            if (!excerpt) excerpt = "Detailed engineering incident analysis and root cause investigation documented on DevSolved.";

            return {
                title, excerpt, tags, content: blocksData, coverImage,
                status: status || 'investigating',
                severity: severity || 'high',
                investigationHours, slaImpact, affectedScale, isDraft
            };
        }

        // --- LIVE HIGH-FIDELITY PREVIEW ENGINE (VIA incident.ejs) ---
        async function togglePreviewMode() {
            const btn = document.getElementById('preview-toggle');
            const studioWorkspace = document.getElementById('studio-main-workspace');
            const blueprintBar = document.getElementById('blueprint-bar');
            const previewBox = document.getElementById('live-preview-box');
            const dockWrap = document.getElementById('command-dock-wrap');
            const iframe = document.getElementById('live-preview-frame');

            if (!isPreviewMode) {
                btn.disabled = true;
                btn.innerHTML = `<i data-lucide="loader-2" class="animate-spin" style="width:16px;"></i> <span>Rendering EJS...</span>`;
                lucide.createIcons();

                const payload = getPostPayload(false);
                try {
                    const res = await fetch('/write/preview', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    const html = await res.text();
                    
                    const doc = iframe.contentDocument || iframe.contentWindow.document;
                    doc.open();
                    doc.write(html);
                    doc.close();

                    studioWorkspace.style.display = 'none';
                    if (blueprintBar) blueprintBar.style.display = 'none';
                    dockWrap.style.display = 'none';
                    previewBox.style.display = 'block';
                    
                    isPreviewMode = true;
                    btn.disabled = false;
                    btn.classList.add('active');
                    btn.innerHTML = `<i data-lucide="edit-3" style="width:16px;"></i> <span>Edit Studio</span>`;
                    showToast("Live Reader Preview", "Rendered directly via incident.ejs engine");
                } catch (err) {
                    btn.disabled = false;
                    btn.innerHTML = `<i data-lucide="eye" style="width:16px;"></i> <span>Preview</span>`;
                    showToast("Preview Error", "Could not connect to preview renderer.", true);
                }
            } else {
                previewBox.style.display = 'none';
                studioWorkspace.style.display = 'block';
                if (blueprintBar) blueprintBar.style.display = 'flex';
                dockWrap.style.display = 'flex';
                
                isPreviewMode = false;
                btn.classList.remove('active');
                btn.innerHTML = `<i data-lucide="eye" style="width:16px;"></i> <span>Preview</span>`;
                showToast("Studio Edit Mode", "Editing active");
            }
            lucide.createIcons();
        }

        // --- SUBMIT / SAVE ACTION ---
        async function submitPost(isDraft = false) {
            if (isPreviewMode) {
                togglePreviewMode();
            }

            const publishBtn = document.getElementById('publish-btn');
            const draftBtn = document.getElementById('draft-btn');
            
            if (isDraft) {
                draftBtn.disabled = true;
                draftBtn.innerHTML = `<i data-lucide="loader-2" class="animate-spin" style="width:15px;"></i> <span>Saving...</span>`;
            } else {
                publishBtn.disabled = true;
                publishBtn.innerHTML = `<i data-lucide="loader-2" class="animate-spin" style="width:15px;"></i> <span>Publishing...</span>`;
            }
            lucide.createIcons();

            const payload = getPostPayload(isDraft);

            if (!payload.title) {
                showToast("Title Required", "Please enter an incident report title before saving.", true);
                resetButtons();
                return;
            }

            try {
                const url = '/api/posts';
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await res.json();

                if (res.ok) {
                    showToast(isDraft ? "Draft Saved Successfully!" : "Incident Published Live!", "Redirecting to incident feed...");
                    setTimeout(() => {
                        window.location.href = data.redirect || '/incidents';
                    }, 1200);
                } else {
                    showToast("Save Failed", data.error || "Could not publish incident report.", true);
                    resetButtons();
                }
            } catch (err) {
                showToast("Network Error", "Failed to communicate with API server.", true);
                resetButtons();
            }
        }

        function resetButtons() {
            const publishBtn = document.getElementById('publish-btn');
            const draftBtn = document.getElementById('draft-btn');
            draftBtn.disabled = false;
            draftBtn.innerHTML = `<i data-lucide="save" style="width: 15px;"></i> <span>Save Draft</span>`;
            publishBtn.disabled = false;
            publishBtn.innerHTML = `<i data-lucide="send" style="width: 15px;"></i> <span>Publish Incident</span>`;
            lucide.createIcons();
        }

        // --- INIT DEFAULT STUDIO TEMPLATE ---
        document.addEventListener('DOMContentLoaded', () => {
            canvas.innerHTML = '';
            addBlock('symptom');
            addBlock('investigation');
            addBlock('rootCause');
            addBlock('resolution');
            renderTags();
            updateStats();
        });
    </script>
</body>

</html>