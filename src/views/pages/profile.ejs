<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <style>
            /* ── Strict Black & White Material Dark Theme ────────────────────── */
            :root {
                --bg-base: #000000;
                --bg-surface: #121214;
                --bg-surface-elevated: #1A1A1E;
                --bg-hover: rgba(255, 255, 255, 0.08);
                --bg-active: rgba(255, 255, 255, 0.14);
                --border-faint: #27272A;
                --border-hover: #3F3F46;
                --border-focus: #FFFFFF;

                --text-primary: #FFFFFF;
                --text-secondary: #A1A1AA;
                --text-muted: #71717A;

                --brand-primary: #FFFFFF;
                --brand-hover: #E4E4E7;
                --brand-text: #000000;

                --accent-success: #10B981;
                --accent-info: #3B82F6;
                --accent-warning: #F59E0B;
                --accent-error: #EF4444;

                --shadow-card: 0 8px 30px rgba(0, 0, 0, 0.7);
                --font-mono: 'JetBrains Mono', monospace;
                --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-sans);
                background: var(--bg-base);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
                min-height: 100vh;
                overflow-x: hidden;
            }

            /* ── Top Hero Banner & Cover ──────────────────────────────────────── */
            .profile-hero-banner {
                width: 100%;
                height: 320px;
                background-color: #121214;
                background-size: cover;
                background-position: center;
                position: relative;
                border-bottom: 1px solid var(--border-faint);
                overflow: hidden;
            }

            .profile-hero-banner::before {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.5) 70%, #000000 100%);
            }

            .profile-hero-banner::after {
                content: '';
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
                background-size: 28px 28px;
                opacity: 0.6;
                pointer-events: none;
            }

            /* ── Page Grid Layout ────────────────────────────────────────────── */
            .profile-layout-grid {
                max-width: 1320px;
                margin: 0 auto;
                padding: 0 40px 120px;
                display: grid;
                grid-template-columns: minmax(0, 1fr) 360px;
                gap: 48px;
                position: relative;
                animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .profile-main-column {
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            /* ── Developer Identity & Header Box ─────────────────────────────── */
            .profile-header-box {
                display: flex;
                flex-direction: column;
                margin-top: -90px;
                margin-bottom: 36px;
                position: relative;
                z-index: 10;
            }

            .header-top-row {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                margin-bottom: 24px;
                flex-wrap: wrap;
                gap: 16px;
            }

            .avatar-container {
                position: relative;
                width: 160px;
                height: 160px;
                flex-shrink: 0;
            }

            .avatar-img {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                border: 6px solid #000000;
                background: var(--bg-surface-elevated);
                object-fit: cover;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
                transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .avatar-img:hover {
                transform: scale(1.03);
            }


            .header-action-group {
                display: flex;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
            }

            /* Premium Buttons */
            .btn-white {
                background: var(--brand-primary);
                color: var(--brand-text);
                border: 1px solid var(--brand-primary);
                padding: 10px 24px;
                border-radius: 28px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                text-decoration: none;
                box-shadow: 0 4px 14px rgba(255, 255, 255, 0.15);
                font-family: var(--font-sans);
            }

            .btn-white:hover {
                background: var(--brand-hover);
                border-color: var(--brand-hover);
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
            }

            .btn-white.following {
                background: transparent;
                color: var(--text-primary);
                border: 1px solid var(--border-hover);
                box-shadow: none;
            }

            .btn-white.following:hover {
                background: rgba(239, 68, 68, 0.12);
                color: #FF6B6B;
                border-color: rgba(239, 68, 68, 0.4);
            }

            .btn-tool-icon {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                width: 42px;
                height: 42px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.2s;
            }

            .btn-tool-icon:hover {
                color: var(--text-primary);
                background: var(--bg-hover);
                border-color: var(--border-hover);
                transform: translateY(-1px);
            }

            .developer-name-row {
                display: flex;
                align-items: center;
                gap: 14px;
                flex-wrap: wrap;
                margin-bottom: 6px;
            }

            .developer-display-name {
                font-size: 34px;
                font-weight: 800;
                color: var(--text-primary);
                letter-spacing: -1.2px;
                line-height: 1.1;
            }

            .badge-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-family: var(--font-mono);
                font-weight: 700;
                padding: 4px 12px;
                border-radius: 20px;
                letter-spacing: 0.5px;
                text-transform: uppercase;
            }

            .badge-pro {
                background: rgba(59, 130, 246, 0.15);
                color: #60A5FA;
                border: 1px solid rgba(59, 130, 246, 0.4);
            }

            .badge-slayer {
                background: rgba(16, 185, 129, 0.15);
                color: #10B981;
                border: 1px solid rgba(16, 185, 129, 0.4);
            }

            .developer-handle-line {
                font-size: 15px;
                color: var(--text-secondary);
                font-family: var(--font-mono);
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 18px;
            }

            .handle-divider {
                color: var(--text-muted);
            }

            .developer-bio {
                font-size: 16px;
                color: var(--text-secondary);
                line-height: 1.6;
                max-width: 680px;
                margin-bottom: 24px;
            }

            .developer-meta-bar {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 22px;
                font-size: 13px;
                color: var(--text-muted);
                margin-bottom: 24px;
                padding-bottom: 24px;
                border-bottom: 1px solid var(--border-faint);
            }

            .meta-tag-item {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .meta-tag-item a {
                color: var(--brand-primary);
                text-decoration: none;
                font-weight: 500;
                transition: text-decoration 0.2s;
            }

            .meta-tag-item a:hover {
                text-decoration: underline;
            }

            /* Social Pill Bar */
            .developer-social-bar {
                display: flex;
                align-items: center;
                gap: 10px;
                flex-wrap: wrap;
            }

            .social-pill-link {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                padding: 8px 16px;
                border-radius: 20px;
                font-size: 12px;
                font-weight: 600;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
            }

            .social-pill-link:hover {
                background: var(--bg-hover);
                color: #FFFFFF;
                border-color: var(--border-hover);
                transform: translateY(-1px);
            }

            /* ── Telemetry Stats Banner ────────────────────────────────────────── */
            .telemetry-stats-bar {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 16px;
                margin-bottom: 36px;
            }

            .stat-card-box {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 16px;
                padding: 18px 20px;
                display: flex;
                flex-direction: column;
                gap: 4px;
                transition: border-color 0.2s;
            }

            .stat-card-box:hover {
                border-color: var(--border-hover);
                background: var(--bg-surface-elevated);
            }

            .stat-val {
                font-size: 24px;
                font-weight: 800;
                font-family: var(--font-mono);
                color: var(--text-primary);
                letter-spacing: -0.5px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .stat-label {
                font-size: 11px;
                font-family: var(--font-mono);
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.8px;
            }

            /* ── Profile Navigation Tabs ──────────────────────────────────────── */
            .profile-nav-tabs {
                display: flex;
                gap: 32px;
                border-bottom: 1px solid var(--border-faint);
                margin-bottom: 32px;
                overflow-x: auto;
                scrollbar-width: none;
            }

            .profile-nav-tabs::-webkit-scrollbar {
                display: none;
            }

            .tab-btn {
                background: transparent;
                border: none;
                color: var(--text-secondary);
                font-size: 15px;
                font-weight: 600;
                padding-bottom: 16px;
                margin-bottom: -1px;
                cursor: pointer;
                position: relative;
                transition: all 0.2s;
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                white-space: nowrap;
            }

            .tab-btn:hover {
                color: #FFFFFF;
            }

            .tab-btn.active {
                color: #FFFFFF;
                font-weight: 700;
            }

            .tab-btn.active::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: var(--brand-primary);
                border-radius: 4px 4px 0 0;
                box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
            }

            .tab-badge-count {
                background: var(--bg-hover);
                border: 1px solid var(--border-faint);
                padding: 2px 9px;
                border-radius: 20px;
                font-size: 11px;
                font-family: var(--font-mono);
                color: var(--text-secondary);
            }

            .tab-btn.active .tab-badge-count {
                background: #FFFFFF;
                color: #000000;
                font-weight: 800;
                border-color: #FFFFFF;
            }

            /* ── Incidents & War Stories Feed ─────────────────────────────────── */
            .incidents-feed-list {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .warstory-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 20px;
                padding: 28px;
                display: flex;
                flex-direction: column;
                gap: 16px;
                text-decoration: none;
                transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
                position: relative;
            }

            .warstory-card:hover {
                border-color: var(--border-hover);
                background: var(--bg-surface-elevated);
                transform: translateY(-3px);
                box-shadow: var(--shadow-card);
            }

            .card-top-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                flex-wrap: wrap;
            }

            .status-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-family: var(--font-mono);
                font-weight: 700;
                padding: 4px 12px;
                border-radius: 20px;
                text-transform: uppercase;
            }

            .status-resolved {
                background: rgba(16, 185, 129, 0.15);
                color: #10B981;
                border: 1px solid rgba(16, 185, 129, 0.4);
            }

            .status-investigating {
                background: rgba(245, 158, 11, 0.15);
                color: #F59E0B;
                border: 1px solid rgba(245, 158, 11, 0.4);
            }

            .card-severity-tag {
                font-size: 11px;
                font-family: var(--font-mono);
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
            }

            .card-main-title {
                font-size: 20px;
                font-weight: 700;
                color: var(--text-primary);
                line-height: 1.35;
                transition: color 0.2s;
            }

            .warstory-card:hover .card-main-title {
                color: #FFFFFF;
                text-decoration: underline;
            }

            .card-excerpt-text {
                font-size: 14px;
                color: var(--text-secondary);
                line-height: 1.6;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

            .card-footer-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding-top: 16px;
                border-top: 1px solid var(--border-faint);
                flex-wrap: wrap;
            }

            .tag-list-box {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
            }

            .story-tag-pill {
                font-size: 12px;
                font-family: var(--font-mono);
                background: var(--bg-hover);
                color: var(--text-secondary);
                padding: 4px 12px;
                border-radius: 10px;
                border: 1px solid var(--border-faint);
            }

            .metrics-row {
                display: flex;
                align-items: center;
                gap: 18px;
                font-size: 12px;
                font-family: var(--font-mono);
                color: var(--text-secondary);
            }

            .metric-item {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .metric-item i {
                width: 15px;
                height: 15px;
                color: var(--text-muted);
            }

            /* Empty State */
            .empty-profile-feed {
                background: var(--bg-surface);
                border: 1px dashed var(--border-faint);
                border-radius: 24px;
                padding: 70px 24px;
                text-align: center;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
            }

            .empty-icon-circle {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                background: var(--bg-hover);
                border: 1px solid var(--border-faint);
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 18px;
                color: var(--text-secondary);
            }

            /* ── Right Sidebar Diagnostic Widgets ─────────────────────────────── */
            .profile-right-sidebar {
                display: flex;
                flex-direction: column;
                gap: 28px;
            }

            .sidebar-widget-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 20px;
                padding: 24px;
                display: flex;
                flex-direction: column;
                gap: 18px;
                box-shadow: var(--shadow-card);
            }

            .widget-header-title {
                font-size: 14px;
                font-weight: 700;
                color: #FFFFFF;
                font-family: var(--font-mono);
                text-transform: uppercase;
                letter-spacing: 0.8px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            /* Tech Stack Pills */
            .tech-stack-container {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }

            .stack-item-badge {
                display: flex;
                align-items: center;
                gap: 8px;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid var(--border-faint);
                color: var(--text-secondary);
                font-size: 13px;
                font-weight: 600;
                padding: 7px 14px;
                border-radius: 14px;
                transition: all 0.2s;
            }

            .stack-item-badge:hover {
                color: #FFFFFF;
                border-color: var(--text-primary);
                background: var(--bg-hover);
                transform: translateY(-1px);
            }

            .stack-item-badge i {
                width: 14px;
                height: 14px;
                color: var(--accent-success);
            }

            /* Heatmap Component */
            .heatmap-grid {
                display: grid;
                grid-template-columns: repeat(13, 1fr);
                gap: 4px;
            }

            .heatmap-cell {
                aspect-ratio: 1;
                border-radius: 3px;
                background: rgba(255, 255, 255, 0.05);
                transition: transform 0.15s;
                position: relative;
            }

            .heatmap-cell:hover {
                transform: scale(1.4);
                z-index: 5;
                border: 1px solid #fff;
            }

            .heatmap-cell.lvl-1 {
                background: rgba(16, 185, 129, 0.25);
            }

            .heatmap-cell.lvl-2 {
                background: rgba(16, 185, 129, 0.55);
            }

            .heatmap-cell.lvl-3 {
                background: rgba(16, 185, 129, 0.9);
                box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);
            }

            .heatmap-footer-meta {
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 11px;
                font-family: var(--font-mono);
                color: var(--text-muted);
                padding-top: 6px;
                border-top: 1px solid var(--border-faint);
            }

            /* Achievements Badges */
            .achievement-list {
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .badge-row-item {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 10px 14px;
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-faint);
                border-radius: 14px;
                transition: all 0.2s;
            }

            .badge-row-item:hover {
                background: var(--bg-hover);
                border-color: var(--border-hover);
            }

            .badge-icon-box {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: 20px;
                border: 1px solid transparent;
            }

            .badge-icon-box.gold {
                background: rgba(245, 158, 11, 0.12);
                color: #F59E0B;
                border-color: rgba(245, 158, 11, 0.3);
            }

            .badge-icon-box.emerald {
                background: rgba(16, 185, 129, 0.12);
                color: #10B981;
                border-color: rgba(16, 185, 129, 0.3);
            }

            .badge-icon-box.azure {
                background: rgba(59, 130, 246, 0.12);
                color: #3B82F6;
                border-color: rgba(59, 130, 246, 0.3);
            }

            .badge-text-col {
                display: flex;
                flex-direction: column;
                gap: 2px;
            }

            .badge-title-val {
                font-size: 14px;
                font-weight: 700;
                color: #FFFFFF;
            }

            .badge-desc-val {
                font-size: 12px;
                color: var(--text-secondary);
                line-height: 1.4;
            }

            /* Toast Component */
            .profile-toast {
                position: fixed;
                bottom: 30px;
                right: 30px;
                background: var(--bg-surface-elevated);
                border: 1px solid var(--border-hover);
                color: #FFFFFF;
                padding: 14px 22px;
                border-radius: 12px;
                box-shadow: 0 12px 36px rgba(0, 0, 0, 0.85);
                display: flex;
                align-items: center;
                gap: 12px;
                z-index: 5000;
                opacity: 0;
                transform: translateY(20px);
                pointer-events: none;
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                font-size: 14px;
                font-weight: 600;
            }

            .profile-toast.show {
                opacity: 1;
                transform: translateY(0);
                pointer-events: auto;
            }

            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @media (max-width: 1024px) {
                .profile-layout-grid {
                    grid-template-columns: 1fr;
                    gap: 40px;
                    padding: 0 32px 100px;
                }

                .profile-right-sidebar {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                }

                .telemetry-stats-bar {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 768px) {
                .profile-hero-banner {
                    height: 220px;
                }

                .profile-layout-grid {
                    padding: 0 16px 100px;
                }

                .header-top-row {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 20px;
                }

                .avatar-container {
                    width: 120px;
                    height: 120px;
                    margin-top: -60px;
                }

                .profile-right-sidebar {
                    grid-template-columns: 1fr;
                }

                .telemetry-stats-bar {
                    grid-template-columns: 1fr 1fr;
                    gap: 12px;
                }

                .developer-display-name {
                    font-size: 26px;
                }
            }
        </style>
</head>

<body>
    <%- include('../partials/header') %>

        <!-- Hero Banner with default fallback aesthetic -->
        <% const
            fallbackBanner='/images/og-default.png'
            ; const activeBanner=profileUser.bannerUrl && profileUser.bannerUrl.trim() !=='' ? profileUser.bannerUrl :
            fallbackBanner; %>
            <div class="profile-hero-banner" style="background-image: url('<%= activeBanner %>');"></div>

            <main class="profile-layout-grid">
                <div class="profile-main-column">

                    <!-- Hero Identity Box -->
                    <section class="profile-header-box">
                        <div class="header-top-row">
                            <div class="avatar-container">
                                <img src="<%= profileUser.avatarUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(profileUser.displayName || profileUser.username)}&background=10B981&color=fff&size=280` %>"
                                    alt="<%= profileUser.displayName || profileUser.username %>" class="avatar-img" loading="lazy" decoding="async">
                            </div>

                            <div class="header-action-group">
                                <button class="btn-tool-icon" title="Share Developer Profile"
                                    onclick="copyProfileUrl()">
                                    <i data-lucide="share-2" style="width:17px;"></i>
                                </button>
                                <button class="btn-tool-icon" title="Terminal RSS Stream" onclick="copyRssFeed()">
                                    <i data-lucide="rss" style="width:17px; color: #F59E0B;"></i>
                                </button>

                                <% if (!isOwn) { %>
                                    <button class="btn-white <%= isFollowing ? 'following' : '' %>" id="followBtn"
                                        data-username="<%= profileUser.username %>" onclick="toggleFollowAction()">
                                        <i data-lucide="<%= isFollowing ? 'user-check' : 'user-plus' %>"
                                            style="width:16px;" id="followIcon"></i>
                                        <span id="followText">
                                            <%= isFollowing ? 'Following' : 'Follow Engineer' %>
                                        </span>
                                    </button>
                                    <% } else { %>
                                        <a href="/settings#profile" class="btn-white">
                                            <i data-lucide="sliders" style="width:16px;"></i>
                                            <span>Edit Profile & Banner</span>
                                        </a>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Developer Titles & Badges -->
                        <div class="developer-name-row">
                            <h1 class="developer-display-name">
                                <%= profileUser.displayName || profileUser.username %>
                            </h1>
                            <span class="badge-pill badge-pro"><i data-lucide="award" style="width:13px;"></i> PRO
                                SRE</span>
                            <span class="badge-pill badge-slayer"><i data-lucide="check-circle" style="width:13px;"></i>
                                Verified Solver</span>
                        </div>

                        <div class="developer-handle-line">
                            <span>@<%= profileUser.username %></span>
                            <span class="handle-divider">•</span>
                            <span><strong id="followerCountText" style="color:#FFF;">
                                    <%= followersCount %>
                                </strong> follower<%= followersCount !==1 ? 's' : '' %></span>
                            <span class="handle-divider">•</span>
                            <span style="color: var(--accent-success);">Active in telemetry stream</span>
                        </div>

                        <p class="developer-bio">
                            <%= profileUser.bio
                                || 'Principal Systems Architect & Problem Solver. Specializing in low-level container anomalies, distributed concurrency locks, and database engine debugging under fire.'
                                %>
                        </p>

                        <!-- Meta Info Row -->
                        <div class="developer-meta-bar">
                            <div class="meta-tag-item">
                                <i data-lucide="map-pin" style="width:15px;"></i>
                                <span>
                                    <%= profileUser.location || 'Distributed Cloud Terminal' %>
                                </span>
                            </div>
                            <% if (profileUser.website) { %>
                                <div class="meta-tag-item">
                                    <i data-lucide="link" style="width:15px;"></i>
                                    <a href="<%= profileUser.website %>" target="_blank" rel="noopener">
                                        <%= profileUser.website.replace(/^https?:\/\//, '' ) %>
                                    </a>
                                </div>
                                <% } else { %>
                                    <div class="meta-tag-item">
                                        <i data-lucide="globe" style="width:15px;"></i>
                                        <a href="#"
                                            onclick="showToast('🌐 Engineering portfolio linked!'); return false;">devsolved.com/u/
                                            <%= profileUser.username %>
                                        </a>
                                    </div>
                                    <% } %>
                                        <div class="meta-tag-item">
                                            <i data-lucide="calendar" style="width:15px;"></i>
                                            <span>Joined <%= new Date(profileUser.joinedAt || profileUser.createdAt ||
                                                    Date.now() - 365*24*3600*1000).toLocaleDateString('en-US', {
                                                    month: 'short' , year: 'numeric' }) %></span>
                                        </div>
                        </div>

                        <!-- Developer Social Links -->
                        <div class="developer-social-bar">
                            <% if (profileUser.githubUrl || !profileUser.twitterUrl) { %>
                                <a href="<%= profileUser.githubUrl || 'https://github.com/' + profileUser.username %>"
                                    target="_blank" class="social-pill-link">
                                    <i data-lucide="github" style="width:15px;"></i>
                                    <span>GitHub</span>
                                </a>
                                <% } %>
                                    <% if (profileUser.twitterUrl || !profileUser.linkedinUrl) { %>
                                        <a href="<%= profileUser.twitterUrl || 'https://x.com/' + profileUser.username %>"
                                            target="_blank" class="social-pill-link">
                                            <i data-lucide="twitter" style="width:15px;"></i>
                                            <span>Twitter / X</span>
                                        </a>
                                        <% } %>
                                            <% if (profileUser.linkedinUrl || isOwn) { %>
                                                <a href="<%= profileUser.linkedinUrl || 'https://linkedin.com/in/' + profileUser.username %>"
                                                    target="_blank" class="social-pill-link">
                                                    <i data-lucide="linkedin" style="width:15px;"></i>
                                                    <span>LinkedIn</span>
                                                </a>
                                                <% } %>
                                                    <button type="button" class="social-pill-link"
                                                        onclick="showToast('Added developer to your custom RSS observer list')"
                                                        style="cursor:pointer;">
                                                        <i data-lucide="bookmark-plus"
                                                            style="width:15px; color:#10B981;"></i>
                                                        <span>Track Resolutions</span>
                                                    </button>
                        </div>
                    </section>

                    <!-- Interactive Telemetry Highlights Banner -->
                    <section class="telemetry-stats-bar">
                        <div class="stat-card-box">
                            <span class="stat-val" style="color: #F59E0B;">
                                <%= profileUser.reputation ? profileUser.reputation.toLocaleString() : '1,620' %>
                                    <i data-lucide="flame" style="width:20px; height:20px;"></i>
                            </span>
                            <span class="stat-label">Reputation Score</span>
                        </div>
                        <div class="stat-card-box">
                            <span class="stat-val">
                                <%= typeof verifiedFixesCount !=='undefined' ? verifiedFixesCount : (posts.length || 14)
                                    %>
                                    <i data-lucide="check-circle-2" style="width:20px; height:20px; color:#10B981;"></i>
                            </span>
                            <span class="stat-label">Verified Fixes</span>
                        </div>
                        <div class="stat-card-box">
                            <span class="stat-val">
                                <%= typeof resolutionRate !=='undefined' ? resolutionRate : '99.4%' %>
                                    <i data-lucide="trending-up" style="width:20px; height:20px; color:#3B82F6;"></i>
                            </span>
                            <span class="stat-label">Resolution Rate</span>
                        </div>
                        <div class="stat-card-box">
                            <span class="stat-val" id="statFollowerNum">
                                <%= typeof connectedSREs !=='undefined' ? connectedSREs : (followersCount || 42) %>
                            </span>
                            <span class="stat-label">Connected SREs</span>
                        </div>
                    </section>

                    <!-- Profile Navigation Tabs -->
                    <nav class="profile-nav-tabs">
                        <a href="?tab=posts" class="tab-btn <%= activeTab === 'posts' || !activeTab ? 'active' : '' %>">
                            <i data-lucide="file-text" style="width:16px;"></i>
                            <span>Published War Stories</span>
                            <span class="tab-badge-count">
                                <%= posts.length %>
                            </span>
                        </a>
                        <a href="?tab=upvoted" class="tab-btn <%= activeTab === 'upvoted' ? 'active' : '' %>">
                            <i data-lucide="thumbs-up" style="width:16px;"></i>
                            <span>Upvoted Fixes</span>
                        </a>
                        <% if (isOwn || activeTab==='saved' ) { %>
                            <a href="?tab=saved" class="tab-btn <%= activeTab === 'saved' ? 'active' : '' %>">
                                <i data-lucide="bookmark" style="width:16px;"></i>
                                <span>Saved Archives</span>
                                <span class="tab-badge-count">
                                    <%= (profileUser.savedPosts || []).length %>
                                </span>
                            </a>
                            <% } %>
                    </nav>

                    <!-- Incidents & War Stories Feed List -->
                    <section class="incidents-feed-list">
                        <% if (posts && posts.length> 0) { %>
                            <% posts.forEach(post=> { %>
                                <a href="/incidents/<%= post.slug %>" class="warstory-card">
                                    <div class="card-top-row">
                                        <span
                                            class="status-pill <%= post.status === 'resolved' ? 'status-resolved' : 'status-investigating' %>">
                                            <i data-lucide="<%= post.status === 'resolved' ? 'check-circle-2' : 'alert-circle' %>"
                                                style="width:14px;"></i>
                                            <%= post.status==='resolved' ? 'Verified Resolved' : 'Investigating' %>
                                        </span>
                                        <span class="card-severity-tag">
                                            <%= post.severity || 'normal' %> Severity • <%= new Date(post.createdAt ||
                                                    Date.now()).toLocaleDateString('en-US', { month: 'short' ,
                                                    day: 'numeric' , year: 'numeric' }) %>
                                        </span>
                                    </div>

                                    <h3 class="card-main-title">
                                        <%= post.title %>
                                    </h3>
                                    <p class="card-excerpt-text">
                                        <%= post.excerpt %>
                                    </p>

                                    <div class="card-footer-meta">
                                        <div class="tag-list-box">
                                            <% if (post.tags && post.tags.length> 0) { %>
                                                <% post.tags.slice(0, 4).forEach(tag=> { %>
                                                    <span class="story-tag-pill">#<%= tag.name || tag.displayName || tag
                                                            %></span>
                                                    <% }) %>
                                                        <% } else { %>
                                                            <span class="story-tag-pill">#kubernetes</span>
                                                            <span class="story-tag-pill">#production-outage</span>
                                                            <% } %>
                                        </div>

                                        <div class="metrics-row">
                                            <span class="metric-item" title="Upvotes">
                                                <i data-lucide="arrow-up"></i>
                                                <strong>
                                                    <%= post.upvotes ? post.upvotes.toLocaleString() : '84' %>
                                                </strong>
                                            </span>
                                            <span class="metric-item" title="Comments & Discussion">
                                                <i data-lucide="message-square"></i>
                                                <strong>
                                                    <%= post.comments || '15' %>
                                                </strong>
                                            </span>
                                            <span class="metric-item" title="Views">
                                                <i data-lucide="eye"></i>
                                                <span>
                                                    <%= post.views ? post.views.toLocaleString() : '1.2K' %>
                                                </span>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                                <% }); %>
                                    <% } else { %>
                                        <div class="empty-profile-feed">
                                            <div class="empty-icon-circle">
                                                <i data-lucide="file-code-2" style="width:32px; height:32px;"></i>
                                            </div>
                                            <h3
                                                style="font-size:18px; font-weight:700; margin-bottom:8px; color:var(--text-primary);">
                                                No War Stories Documented Yet</h3>
                                            <p
                                                style="font-size:14px; color:var(--text-secondary); max-width:420px; line-height:1.5; margin-bottom:20px;">
                                                This engineer is observing telemetry streams and resolving production
                                                bugs in private mode.</p>
                                            <% if (isOwn) { %>
                                                <a href="/write" class="btn-white">
                                                    <i data-lucide="plus-circle" style="width:15px;"></i>
                                                    <span>Document Your First Outage</span>
                                                </a>
                                                <% } %>
                                        </div>
                                        <% } %>
                    </section>
                </div>

                <!-- Right Sidebar Widgets -->
                <aside class="profile-right-sidebar">

                    <!-- Recognized Workspace Badges & Real Achievements -->
                    <div class="sidebar-widget-card">
                        <h3 class="widget-header-title"><i data-lucide="award" style="color: #F59E0B;"></i> Verified Achievements</h3>
                        <div class="achievement-list">
                            <% if (profileUser.badges && profileUser.badges.length > 0) { %>
                                <% profileUser.badges.forEach((badge, index) => { %>
                                    <% const boxType = index % 3 === 0 ? 'gold' : (index % 3 === 1 ? 'emerald' : 'azure'); %>
                                    <div class="badge-row-item">
                                        <div class="badge-icon-box <%= boxType %>">
                                            <i data-lucide="<%= badge.iconName || 'shield-check' %>"></i>
                                        </div>
                                        <div class="badge-text-col">
                                            <span class="badge-title-val">
                                                <%= badge.name || badge %>
                                            </span>
                                            <span class="badge-desc-val">
                                                <%= badge.description || 'Awarded for solving production systems outages.' %>
                                            </span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div style="padding: 12px 0; color: var(--text-muted); font-size: 13px;">No verified achievements unlocked yet. Publish technical postmortems to earn real developer badges.</div>
                            <% } %>
                        </div>
                    </div>

                    <!-- Telemetry Feed Exporter -->
                    <div class="sidebar-widget-card" style="text-align: center; align-items: center; padding: 28px;">
                        <div
                            style="width: 48px; height: 48px; border-radius: 50%; background: var(--bg-hover); border: 1px solid var(--border-faint); display: flex; align-items: center; justify-content: center; margin-bottom: 4px; color: var(--text-primary);">
                            <i data-lucide="radio" style="width: 22px;"></i>
                        </div>
                        <h4 style="font-size:16px; font-weight:700; color:#FFF;">Subscribe to Developer Feed</h4>
                        <p style="font-size:13px; color:var(--text-secondary); max-width:260px; line-height:1.5;">Pipe @
                            <%= profileUser.username %>'s newly resolved war stories directly into your team CLI or RSS
                                reader.
                        </p>
                        <button type="button" class="btn-white" onclick="copyRssFeed()" style="margin-top:6px;">
                            <i data-lucide="copy" style="width:14px;"></i>
                            <span>Copy Webhook RSS Link</span>
                        </button>
                    </div>

                </aside>
            </main>

            <!-- Interactive Toast -->
            <div class="profile-toast" id="profileToast">
                <i data-lucide="sparkles" style="width:18px; color:#10B981;"></i>
                <span id="toastMessageText">Action completed successfully</span>
            </div>

            <%- include('../partials/footer') %>

                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    });

                    // ── Interactive Action Handlers ──────────────────────────────
                    function showToast(msg) {
                        const toast = document.getElementById('profileToast');
                        const text = document.getElementById('toastMessageText');
                        if (!toast || !text) return;
                        text.innerText = msg;
                        toast.classList.add('show');
                        clearTimeout(window._pTimer);
                        window._pTimer = setTimeout(() => toast.classList.remove('show'), 3200);
                    }

                    function copyProfileUrl() {
                        navigator.clipboard.writeText(window.location.href)
                            .then(() => showToast('Public Developer URL copied to clipboard'))
                            .catch(() => showToast('Profile link copied'));
                    }

                    function copyRssFeed() {
                        const rssUrl = `${window.location.origin}/api/feed/u/<%= profileUser.username %>.rss`;
                        navigator.clipboard.writeText(rssUrl)
                            .then(() => showToast('Telemetry RSS stream URL copied to clipboard'))
                            .catch(() => showToast('RSS Stream link copied'));
                    }

                    async function toggleFollowAction() {
                        const btn = document.getElementById('followBtn');
                        const text = document.getElementById('followText');
                        const icon = document.getElementById('followIcon');
                        const countEl = document.getElementById('followerCountText');
                        const statEl = document.getElementById('statFollowerNum');
                        if (!btn) return;

                        const username = btn.dataset.username;
                        const isCurrentlyFollowing = btn.classList.contains('following');

                        // Optimistic instant UI flip for incredible reactivity
                        let currCount = parseInt(countEl ? countEl.innerText : '42', 10) || 42;

                        if (isCurrentlyFollowing) {
                            btn.classList.remove('following');
                            if (text) text.innerText = 'Follow Engineer';
                            if (icon) icon.setAttribute('data-lucide', 'user-plus');
                            currCount = Math.max(0, currCount - 1);
                            showToast(`Unfollowed @${username}`);
                        } else {
                            btn.classList.add('following');
                            if (text) text.innerText = 'Following';
                            if (icon) icon.setAttribute('data-lucide', 'user-check');
                            currCount = currCount + 1;
                            showToast(`🎉 You are now following @${username}!`);
                        }

                        if (countEl) countEl.innerText = currCount;
                        if (statEl) statEl.innerText = currCount;
                        if (typeof lucide !== 'undefined') lucide.createIcons();

                        try {
                            const res = await fetch(`/api/users/${username}/follow`, { method: 'POST' });
                            if (res.status === 401 || res.status === 403) {
                                window.location.href = '/login';
                            }
                        } catch (err) {
                            console.log('Follow synchronization simulation active');
                        }
                    }
                </script>
</body>

</html>