<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
        <style>
            /* ── Strict Black & White Material Dark Theme ────────────────────── */
            :root {
                --bg-base: #000000;
                --bg-surface: #121214;
                --bg-surface-elevated: #18181B;
                --bg-hover: rgba(255, 255, 255, 0.08);
                --bg-active: rgba(255, 255, 255, 0.14);
                --border-faint: #27272A;
                --border-hover: #3F3F46;
                --border-focus: #FFFFFF;

                --text-primary: #FFFFFF;
                --text-secondary: #A1A1AA;
                --text-muted: #71717A;

                --brand-primary: #FFFFFF;
                --brand-hover: #E4E4E7;
                --brand-text: #000000;

                --accent-success: #10B981;
                --accent-info: #3B82F6;
                --accent-warning: #F59E0B;
                --accent-error: #EF4444;

                --shadow-card: 0 8px 30px rgba(0, 0, 0, 0.6);
                --font-mono: 'JetBrains Mono', monospace;
                --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: var(--font-sans);
                background: var(--bg-base);
                color: var(--text-primary);
                -webkit-font-smoothing: antialiased;
                min-height: 100vh;
                overflow-x: hidden;
            }

            /* ── Main Layout & Fixed Grid ──────────────────────────────────────── */
            .settings-page-wrapper {
                max-width: 1380px;
                margin: 0 auto;
                padding: 40px 48px 120px;
                min-height: calc(100vh - 64px);
            }

            .settings-top-header {
                margin-bottom: 32px;
                padding-bottom: 24px;
                border-bottom: 1px solid var(--border-faint);
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 16px;
            }

            .header-title-box {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .settings-main-title {
                font-size: 32px;
                font-weight: 800;
                letter-spacing: -1px;
                display: flex;
                align-items: center;
                gap: 14px;
                color: var(--text-primary);
            }

            .settings-main-subtitle {
                font-size: 15px;
                color: var(--text-secondary);
                max-width: 600px;
            }

            .workspace-badge {
                font-family: var(--font-mono);
                font-size: 12px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid var(--border-faint);
                padding: 6px 14px;
                border-radius: 20px;
                color: #FFFFFF;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .workspace-badge .pulse-dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--accent-success);
                box-shadow: 0 0 8px var(--accent-success);
            }

            .settings-grid {
                display: grid;
                grid-template-columns: 280px minmax(0, 1fr);
                gap: 44px;
                align-items: start;
            }

            /* ── Fixed / Sticky Left Sidebar ───────────────────────────────────── */
            .settings-sidebar {
                position: sticky;
                top: 88px;
                display: flex;
                flex-direction: column;
                gap: 6px;
                max-height: calc(100vh - 120px);
                overflow-y: auto;
                padding-right: 6px;
                scrollbar-width: none;
            }

            .settings-sidebar::-webkit-scrollbar {
                display: none;
            }

            .sidebar-section-title {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--text-muted);
                letter-spacing: 1px;
                padding: 8px 14px 4px;
                font-family: var(--font-mono);
            }

            .nav-tab-btn {
                background: transparent;
                border: 1px solid transparent;
                color: var(--text-secondary);
                padding: 12px 16px;
                border-radius: 14px;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                display: flex;
                align-items: center;
                gap: 12px;
                text-align: left;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                font-family: var(--font-sans);
                width: 100%;
            }

            .nav-tab-btn:hover {
                background: var(--bg-hover);
                color: var(--text-primary);
                border-color: rgba(255, 255, 255, 0.04);
            }

            .nav-tab-btn.active {
                background: var(--bg-surface-elevated);
                color: var(--brand-primary);
                font-weight: 700;
                border-color: var(--border-hover);
                box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
            }

            .nav-tab-btn i {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
            }

            .nav-tab-btn.danger-btn {
                color: var(--accent-error);
            }

            .nav-tab-btn.danger-btn:hover {
                background: rgba(239, 68, 68, 0.1);
                border-color: rgba(239, 68, 68, 0.2);
            }

            .nav-tab-btn.danger-btn.active {
                background: rgba(239, 68, 68, 0.15);
                border-color: rgba(239, 68, 68, 0.4);
                color: #FF6B6B;
            }

            .sidebar-status-card {
                margin-top: 24px;
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 16px;
                padding: 18px;
                font-size: 13px;
            }

            .sidebar-status-card h4 {
                font-weight: 700;
                color: #FFFFFF;
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 6px;
            }

            .sidebar-status-card p {
                color: var(--text-secondary);
                font-size: 12px;
                line-height: 1.5;
                margin-bottom: 12px;
            }

            /* ── Main Content Sections ─────────────────────────────────────────── */
            .settings-content-area {
                min-width: 0;
                position: relative;
            }

            .settings-section {
                display: none;
                flex-direction: column;
                gap: 32px;
                animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .settings-section.active {
                display: flex;
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .section-header-row {
                display: flex;
                flex-direction: column;
                gap: 6px;
                border-bottom: 1px solid var(--border-faint);
                padding-bottom: 18px;
                margin-bottom: 4px;
            }

            .section-title {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .section-desc {
                font-size: 14px;
                color: var(--text-secondary);
                line-height: 1.5;
            }

            /* ── Cards & Containers ────────────────────────────────────────────── */
            .settings-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-faint);
                border-radius: 20px;
                padding: 28px;
                display: flex;
                flex-direction: column;
                gap: 22px;
                box-shadow: var(--shadow-card);
                position: relative;
                overflow: hidden;
                transition: border-color 0.2s;
            }

            .settings-card:hover {
                border-color: var(--border-hover);
            }

            .settings-card.danger-card {
                border-color: rgba(239, 68, 68, 0.3);
                background: rgba(239, 68, 68, 0.03);
            }

            .card-header {
                display: flex;
                align-items: flex-start;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
            }

            .card-header-titles h3 {
                font-size: 17px;
                font-weight: 700;
                color: var(--text-primary);
                margin-bottom: 4px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .card-header-titles p {
                font-size: 13px;
                color: var(--text-secondary);
                line-height: 1.5;
                max-width: 540px;
            }

            /* ── Live Banner Preview Component ─────────────────────────────────── */
            .live-preview-box {
                background: var(--bg-base);
                border: 1px solid var(--border-faint);
                border-radius: 18px;
                overflow: hidden;
                position: relative;
                margin-bottom: 8px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
            }

            .preview-banner {
                width: 100%;
                height: 180px;
                object-fit: cover;
                background: #18181B;
                transition: all 0.3s ease;
                position: relative;
            }

            .preview-overlay {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 180px;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.2) 0%, rgba(0, 0, 0, 0.8) 100%);
            }

            .preview-content {
                padding: 0 28px 24px;
                margin-top: -44px;
                position: relative;
                z-index: 2;
                display: flex;
                align-items: flex-end;
                justify-content: space-between;
                gap: 20px;
                flex-wrap: wrap;
            }

            .preview-identity {
                display: flex;
                align-items: flex-end;
                gap: 18px;
            }

            .preview-avatar-wrapper {
                position: relative;
                width: 88px;
                height: 88px;
                flex-shrink: 0;
            }

            .preview-avatar {
                width: 100%;
                height: 100%;
                border-radius: 50%;
                object-fit: cover;
                border: 4px solid var(--bg-surface);
                background: #27272A;
                box-shadow: 0 6px 20px rgba(0, 0, 0, 0.8);
            }

            .online-status {
                position: absolute;
                bottom: 4px;
                right: 4px;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: var(--accent-success);
                border: 3px solid var(--bg-surface);
            }

            .preview-text {
                display: flex;
                flex-direction: column;
                gap: 4px;
                padding-bottom: 4px;
            }

            .preview-name {
                font-size: 22px;
                font-weight: 800;
                color: #FFFFFF;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .preview-handle {
                font-family: var(--font-mono);
                font-size: 13px;
                color: var(--text-secondary);
            }

            .preview-bio {
                font-size: 13px;
                color: var(--text-secondary);
                max-width: 520px;
                margin-top: 6px;
                line-height: 1.5;
            }

            /* Curated Preset Banner Selector */
            .preset-banners-row {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 12px;
                margin-top: 6px;
            }

            .preset-banner-btn {
                background: var(--bg-base);
                border: 2px solid var(--border-faint);
                border-radius: 12px;
                height: 64px;
                overflow: hidden;
                cursor: pointer;
                position: relative;
                transition: all 0.2s;
            }

            .preset-banner-btn:hover {
                border-color: var(--text-primary);
                transform: scale(1.02);
            }

            .preset-banner-btn.selected {
                border-color: var(--brand-primary);
                box-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
            }

            .preset-banner-btn img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .preset-label {
                position: absolute;
                bottom: 0;
                left: 0;
                width: 100%;
                background: rgba(0, 0, 0, 0.75);
                backdrop-filter: blur(4px);
                color: #fff;
                font-size: 10px;
                font-family: var(--font-mono);
                font-weight: 700;
                text-align: center;
                padding: 4px;
                text-transform: uppercase;
            }

            /* ── Forms & Inputs ────────────────────────────────────────────────── */
            .form-grid-2 {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 20px;
            }

            .form-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
            }

            .form-label {
                font-size: 13px;
                font-weight: 700;
                color: var(--text-primary);
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-family: var(--font-sans);
            }

            .form-label-hint {
                font-size: 11px;
                font-weight: 500;
                font-family: var(--font-mono);
                color: var(--text-muted);
            }

            .form-input {
                background: var(--bg-base);
                border: 1px solid var(--border-faint);
                border-radius: 12px;
                padding: 12px 16px;
                color: var(--text-primary);
                font-size: 14px;
                font-family: var(--font-sans);
                outline: none;
                transition: all 0.2s;
                width: 100%;
            }

            .form-input:focus {
                border-color: var(--border-focus);
                box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
                background: #000000;
            }

            .form-input::placeholder {
                color: var(--text-muted);
            }

            .form-input.font-mono {
                font-family: var(--font-mono);
                font-size: 13px;
            }

            textarea.form-input {
                min-height: 100px;
                resize: vertical;
                line-height: 1.6;
            }

            /* Premium Buttons */
            .btn-white {
                background: var(--brand-primary);
                color: var(--brand-text);
                border: 1px solid var(--brand-primary);
                padding: 11px 22px;
                border-radius: 24px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                transition: all 0.2s;
                text-decoration: none;
                box-shadow: 0 2px 10px rgba(255, 255, 255, 0.15);
                font-family: var(--font-sans);
                width: fit-content;
            }

            .btn-white:hover {
                background: var(--brand-hover);
                border-color: var(--brand-hover);
                transform: translateY(-1px);
                box-shadow: 0 4px 16px rgba(255, 255, 255, 0.25);
            }

            .btn-outline {
                background: transparent;
                color: var(--text-primary);
                border: 1px solid var(--border-faint);
                padding: 10px 20px;
                border-radius: 24px;
                font-size: 13px;
                font-weight: 600;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
                text-decoration: none;
                width: fit-content;
                font-family: var(--font-sans);
            }

            .btn-outline:hover {
                background: var(--bg-hover);
                border-color: var(--border-hover);
            }

            .btn-danger {
                background: rgba(239, 68, 68, 0.15);
                color: #FF6B6B;
                border: 1px solid rgba(239, 68, 68, 0.4);
                padding: 10px 20px;
                border-radius: 24px;
                font-size: 13px;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
                width: fit-content;
            }

            .btn-danger:hover {
                background: rgba(239, 68, 68, 0.25);
                border-color: #FF6B6B;
            }

            .form-footer-row {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 14px;
                margin-top: 10px;
                padding-top: 18px;
                border-top: 1px solid var(--border-faint);
            }

            /* ── Toggle Switch Component ───────────────────────────────────────── */
            .toggle-card-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 20px;
                padding: 16px 20px;
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-faint);
                border-radius: 14px;
                transition: all 0.2s;
            }

            .toggle-card-item:hover {
                background: var(--bg-hover);
                border-color: var(--border-hover);
            }

            .toggle-label h4 {
                font-size: 15px;
                font-weight: 600;
                color: var(--text-primary);
                margin-bottom: 4px;
            }

            .toggle-label p {
                font-size: 13px;
                color: var(--text-secondary);
            }

            .custom-switch {
                position: relative;
                display: inline-block;
                width: 48px;
                height: 26px;
                flex-shrink: 0;
            }

            .custom-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

            .slider {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: var(--border-faint);
                transition: .25s;
                border-radius: 30px;
            }

            .slider:before {
                position: absolute;
                content: "";
                height: 18px;
                width: 18px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .25s;
                border-radius: 50%;
            }

            input:checked+.slider {
                background-color: #FFFFFF;
            }

            input:checked+.slider:before {
                transform: translateX(22px);
                background-color: #000000;
            }

            /* ── Interactive Circle Loader & Toggle Status Badges ─────────────── */
            .circle-loader-spin {
                width: 16px;
                height: 16px;
                border: 2px solid rgba(245, 158, 11, 0.2);
                border-top-color: #F59E0B;
                border-radius: 50%;
                animation: rotateCircle 0.6s linear infinite;
                display: inline-block;
                flex-shrink: 0;
            }

            @keyframes rotateCircle {
                to {
                    transform: rotate(360deg);
                }
            }

            .toggle-status-badge {
                display: flex;
                align-items: center;
                gap: 7px;
                font-family: var(--font-mono);
                font-size: 11px;
                font-weight: 700;
                padding: 5px 12px;
                border-radius: 20px;
                border: 1px solid var(--border-faint);
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                user-select: none;
            }

            .toggle-status-badge.enabled {
                background: rgba(16, 185, 129, 0.1);
                border-color: rgba(16, 185, 129, 0.3);
                color: #10B981;
            }

            .toggle-status-badge.muted {
                background: rgba(255, 255, 255, 0.03);
                border-color: var(--border-faint);
                color: var(--text-muted);
            }

            .toggle-status-badge.updating {
                background: rgba(245, 158, 11, 0.12);
                border-color: rgba(245, 158, 11, 0.4);
                color: #F59E0B;
                box-shadow: 0 0 12px rgba(245, 158, 11, 0.2);
            }

            .toggle-status-badge.saved {
                background: rgba(16, 185, 129, 0.18);
                border-color: rgba(16, 185, 129, 0.6);
                color: #10B981;
                box-shadow: 0 0 14px rgba(16, 185, 129, 0.3);
                transform: scale(1.05);
            }

            .toggle-status-badge.error-badge {
                background: rgba(239, 68, 68, 0.15);
                border-color: rgba(239, 68, 68, 0.6);
                color: #EF4444;
                box-shadow: 0 0 14px rgba(239, 68, 68, 0.3);
            }

            /* ── Tables & Lists (Sessions, Tokens, OAuth) ──────────────────────── */
            .settings-table {
                width: 100%;
                border-collapse: collapse;
                text-align: left;
            }

            .settings-table th {
                font-size: 11px;
                font-family: var(--font-mono);
                color: var(--text-muted);
                text-transform: uppercase;
                padding: 12px 16px;
                border-bottom: 1px solid var(--border-faint);
                font-weight: 700;
            }

            .settings-table td {
                padding: 16px;
                border-bottom: 1px solid var(--border-faint);
                font-size: 14px;
                color: var(--text-primary);
                vertical-align: middle;
            }

            .settings-table tr:last-child td {
                border-bottom: none;
            }

            .session-info-box {
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .session-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                background: var(--bg-base);
                border: 1px solid var(--border-faint);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--text-secondary);
                flex-shrink: 0;
            }

            .badge-tag {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11px;
                font-family: var(--font-mono);
                font-weight: 700;
                padding: 3px 10px;
                border-radius: 12px;
            }

            .badge-success {
                background: rgba(16, 185, 129, 0.15);
                color: #10B981;
                border: 1px solid rgba(16, 185, 129, 0.3);
            }

            .badge-neutral {
                background: rgba(255, 255, 255, 0.08);
                color: var(--text-secondary);
                border: 1px solid var(--border-faint);
            }

            .api-token-box {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: #000000;
                border: 1px solid var(--border-faint);
                border-radius: 12px;
                padding: 12px 18px;
                font-family: var(--font-mono);
                font-size: 14px;
                color: #10B981;
                gap: 12px;
            }

            .theme-selector-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
            }

            .theme-card {
                background: var(--bg-base);
                border: 2px solid var(--border-faint);
                border-radius: 16px;
                padding: 18px;
                cursor: pointer;
                transition: all 0.2s;
                text-align: left;
            }

            .theme-card:hover {
                border-color: var(--border-hover);
            }

            .theme-card.selected {
                border-color: #FFFFFF;
                background: var(--bg-surface-elevated);
                box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
            }

            .theme-card-preview {
                height: 60px;
                border-radius: 8px;
                background: #0A0A0A;
                border: 1px solid var(--border-faint);
                margin-bottom: 12px;
                padding: 8px;
                font-family: var(--font-mono);
                font-size: 10px;
                color: #89B4FA;
                display: flex;
                flex-direction: column;
                gap: 4px;
                overflow: hidden;
            }

            /* Alert Notifications */
            .alert-banner {
                padding: 16px 20px;
                border-radius: 14px;
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 24px;
                font-weight: 600;
                font-size: 14px;
                animation: fadeIn 0.3s ease;
            }

            .alert-success {
                background: rgba(16, 185, 129, 0.12);
                color: #10B981;
                border: 1px solid rgba(16, 185, 129, 0.3);
            }

            .alert-error {
                background: rgba(239, 68, 68, 0.12);
                color: #EF4444;
                border: 1px solid rgba(239, 68, 68, 0.3);
            }

            /* Toast Component */
            .settings-toast {
                position: fixed;
                bottom: 30px;
                right: 30px;
                background: #18181B;
                border: 1px solid #3F3F46;
                color: #fff;
                padding: 14px 22px;
                border-radius: 12px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
                display: flex;
                align-items: center;
                gap: 12px;
                z-index: 5000;
                opacity: 0;
                pointer-events: none;
                transform: translateY(20px);
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                font-size: 14px;
                font-weight: 600;
            }

            .settings-toast.show {
                opacity: 1;
                pointer-events: auto;
                transform: translateY(0);
            }

            /* Responsive Breakpoints */
            @media (max-width: 1024px) {
                .settings-grid {
                    grid-template-columns: 240px minmax(0, 1fr);
                    gap: 28px;
                }

                .preset-banners-row {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 768px) {
                .settings-page-wrapper {
                    padding: 24px 16px 100px;
                }

                .settings-grid {
                    grid-template-columns: 1fr;
                    gap: 24px;
                }

                .settings-sidebar {
                    position: static;
                    max-height: none;
                    flex-direction: row;
                    overflow-x: auto;
                    padding-bottom: 8px;
                }

                .nav-tab-btn {
                    white-space: nowrap;
                    width: auto;
                    padding: 10px 16px;
                }

                .sidebar-status-card,
                .sidebar-section-title {
                    display: none;
                }

                .form-grid-2,
                .theme-selector-grid {
                    grid-template-columns: 1fr;
                }

                .preview-content {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 14px;
                }
            }
        </style>
</head>

<body>
    <%- include('../partials/header') %>

        <div class="settings-page-wrapper">
            <!-- Top Title Bar -->
            <div class="settings-top-header">
                <div class="header-title-box">
                    <h1 class="settings-main-title">
                        <i data-lucide="sliders" style="color: #FFFFFF;"></i>
                        <span>Workspace & Developer Settings</span>
                    </h1>
                    <p class="settings-main-subtitle">Configure your developer identity, security keys, war story
                        telemetry, and IDE appearance.</p>
                </div>
                <div class="workspace-badge" title="Workspace Connected">
                    <span class="pulse-dot"></span>
                    <span>PRO SRE TERMINAL</span>
                </div>
            </div>

            <!-- Alerts -->
            <% if (error) { %>
                <div class="alert-banner alert-error">
                    <i data-lucide="alert-circle" style="width: 20px; flex-shrink:0;"></i>
                    <span>
                        <%= error %>
                    </span>
                </div>
                <% } %>
                    <% if (success==='profile' ) { %>
                        <div class="alert-banner alert-success">
                            <i data-lucide="check-circle-2" style="width: 20px; flex-shrink:0;"></i>
                            <span>Developer profile identity and default banner updated successfully.</span>
                        </div>
                        <% } else if (success==='password' ) { %>
                            <div class="alert-banner alert-success">
                                <i data-lucide="check-circle-2" style="width: 20px; flex-shrink:0;"></i>
                                <span>Workspace security password changed successfully. All old tokens refreshed.</span>
                            </div>
                            <% } %>

                                <!-- Main Responsive 2-Column Grid -->
                                <div class="settings-grid">

                                    <!-- Sticky Fixed Left Sidebar Navigation -->
                                    <aside class="settings-sidebar">
                                        <span class="sidebar-section-title">Developer Identity</span>
                                        <button class="nav-tab-btn active" data-tab="profile">
                                            <i data-lucide="user"></i> Profile & Banner
                                        </button>
                                        <button class="nav-tab-btn" data-tab="account">
                                            <i data-lucide="shield"></i> Account & Role
                                        </button>

                                        <span class="sidebar-section-title" style="margin-top: 12px;">Telemetry &
                                            Alerts</span>
                                        <button class="nav-tab-btn" data-tab="notifications">
                                            <i data-lucide="bell"></i> Notifications & Dispatches
                                        </button>
                                        <button class="nav-tab-btn" data-tab="api">
                                            <i data-lucide="code-2"></i> API Keys & Webhooks
                                        </button>

                                        <span class="sidebar-section-title" style="margin-top: 12px;">Workspace &
                                            Security</span>
                                        <button class="nav-tab-btn" data-tab="security">
                                            <i data-lucide="key-round"></i> Security & Sessions
                                        </button>
                                        <button class="nav-tab-btn" data-tab="appearance">
                                            <i data-lucide="layout-template"></i> Appearance & Editor
                                        </button>
                                        <button class="nav-tab-btn danger-btn" data-tab="danger"
                                            style="margin-top: 8px;">
                                            <i data-lucide="alert-triangle"></i> Danger Zone
                                        </button>

                                        <!-- Status Sidebar Card -->
                                        <div class="sidebar-status-card">
                                            <h4><i data-lucide="cpu" style="width:16px; color:#10B981;"></i> Telemetry
                                                Active</h4>
                                            <p>Your workspace is synchronized with 14 background diagnostic observers
                                                and semantic feeds.</p>
                                            <div
                                                style="display:flex; align-items:center; justify-content:space-between; font-size:12px; font-family:var(--font-mono); color:#fff; border-top:1px solid var(--border-faint); padding-top:10px;">
                                                <span>Reputation Score</span>
                                                <span style="color:#F59E0B; font-weight:800;">1,620 Rep 🔥</span>
                                            </div>
                                        </div>
                                    </aside>

                                    <!-- Right Content Sections -->
                                    <main class="settings-content-area">

                                        <!-- SECTION 1: Profile & Banner (#profile) -->
                                        <section class="settings-section active" id="sec-profile">
                                            <div class="section-header-row">
                                                <h2 class="section-title"><i data-lucide="user-check"
                                                        style="color: #3B82F6;"></i> Profile Identity & Best Default
                                                    Banner</h2>
                                                <p class="section-desc">Customize your public developer persona, war
                                                    story authorship signature, and profile cover aesthetic.</p>
                                            </div>

                                            <form action="/settings/profile" method="POST">
                                                <div class="settings-card">
                                                    <div class="card-header">
                                                        <div class="card-header-titles">
                                                            <h3>Live Profile Banner & Avatar Preview</h3>
                                                            <p>Select from our high-resolution developer preset banners
                                                                or supply your custom image link.</p>
                                                        </div>
                                                        <a href="/u/<%= user ? user.username : 'developer' %>"
                                                            target="_blank" class="btn-outline"
                                                            style="padding: 7px 14px; font-size:12px;">
                                                            <span>View Public Profile</span>
                                                            <i data-lucide="external-link" style="width:13px;"></i>
                                                        </a>
                                                    </div>

                                                    <!-- Live Profile Preview Card -->
                                                    <div class="live-preview-box">
                                                        <img src="<%= user && user.bannerUrl ? user.bannerUrl : defaultBanner %>"
                                                            alt="Banner Preview" class="preview-banner"
                                                            id="bannerPreviewImg">
                                                        <div class="preview-overlay"></div>
                                                        <div class="preview-content">
                                                            <div class="preview-identity">
                                                                <div class="preview-avatar-wrapper">
                                                                    <img src="<%= user && user.avatarUrl ? user.avatarUrl : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(user ? user.displayName || user.username : 'You') + '&background=FFFFFF&color=000&size=200' %>"
                                                                        alt="Avatar" class="preview-avatar"
                                                                        id="avatarPreviewImg">
                                                                    <span class="online-status"
                                                                        title="Online Developer"></span>
                                                                </div>
                                                                <div class="preview-text">
                                                                    <div class="preview-name" id="prevDisplayName">
                                                                        <%= user ? user.displayName || user.username
                                                                            : 'Developer' %>
                                                                            <span class="badge-tag badge-success">PRO
                                                                                SRE</span>
                                                                    </div>
                                                                    <div class="preview-handle">@<%= user ?
                                                                            user.username : 'developer' %> • <span
                                                                                id="prevLocation">
                                                                                <%= user && user.location ?
                                                                                    user.location : 'Distributed Cloud'
                                                                                    %>
                                                                            </span></div>
                                                                </div>
                                                            </div>
                                                            <span class="badge-tag"
                                                                style="background:#000; color:#fff; border:1px solid #3F3F46;">Bug
                                                                Slayer 🔥</span>
                                                        </div>
                                                        <p class="preview-bio" style="padding: 0 28px 18px;"
                                                            id="prevBio">
                                                            <%= user && user.bio ? user.bio
                                                                : 'Full Stack Systems Architect solving high-concurrency anomalies under fire.'
                                                                %>
                                                        </p>
                                                    </div>

                                                    <!-- Quick Select Preset Banners -->
                                                    <div class="form-group">
                                                        <label class="form-label">
                                                            <span>Quick Select Developer Preset Banners</span>
                                                            <span class="form-label-hint">One-click aesthetic
                                                                switch</span>
                                                        </label>
                                                        <div class="preset-banners-row">
                                                            <div class="preset-banner-btn selected"
                                                                onclick="selectPresetBanner('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80', this)">
                                                                <img src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=400&q=80"
                                                                    alt="Midnight Geometric">
                                                                <span class="preset-label">Midnight Matrix</span>
                                                            </div>
                                                            <div class="preset-banner-btn"
                                                                onclick="selectPresetBanner('https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=1200&q=80', this)">
                                                                <img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=400&q=80"
                                                                    alt="Cyber Circuitry">
                                                                <span class="preset-label">Cyber Circuitry</span>
                                                            </div>
                                                            <div class="preset-banner-btn"
                                                                onclick="selectPresetBanner('https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=1200&q=80', this)">
                                                                <img src="https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=400&q=80"
                                                                    alt="Monochrome Carbon">
                                                                <span class="preset-label">Carbon Dark</span>
                                                            </div>
                                                            <div class="preset-banner-btn"
                                                                onclick="selectPresetBanner('https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=1200&q=80', this)">
                                                                <img src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?auto=format&fit=crop&w=400&q=80"
                                                                    alt="Deep Coding Matrix">
                                                                <span class="preset-label">Neon Coding</span>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="form-grid-2">
                                                        <div class="form-group">
                                                            <label class="form-label">Banner Image URL</label>
                                                            <input type="text" name="bannerUrl" id="bannerUrlInput"
                                                                class="form-input font-mono"
                                                                value="<%= user ? user.bannerUrl || defaultBanner : defaultBanner %>"
                                                                placeholder="https://...">
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label">Avatar Image URL</label>
                                                            <input type="text" name="avatarUrl" id="avatarUrlInput"
                                                                class="form-input font-mono"
                                                                value="<%= user ? user.avatarUrl || '' : '' %>"
                                                                placeholder="https://ui-avatars.com/api/?name=...">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="settings-card">
                                                    <div class="card-header">
                                                        <div class="card-header-titles">
                                                            <h3>Personal Identity Details</h3>
                                                            <p>Update your workspace display handle and developer bio
                                                                displayed on your war stories.</p>
                                                        </div>
                                                    </div>

                                                    <div class="form-grid-2">
                                                        <div class="form-group">
                                                            <label class="form-label">Display Name *</label>
                                                            <input type="text" name="displayName" id="inputDisplayName"
                                                                class="form-input" required
                                                                value="<%= user ? user.displayName || user.username : '' %>"
                                                                maxlength="60">
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label">Username (Handle) * <span
                                                                    class="form-label-hint">devsolved.com/u/handle</span></label>
                                                            <input type="text" name="username"
                                                                class="form-input font-mono" required
                                                                value="<%= user ? user.username : '' %>"
                                                                pattern="^[a-zA-Z0-9_-]+$" maxlength="30">
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="form-label">
                                                            <span>Developer Bio</span>
                                                            <span class="form-label-hint" id="bioCount">
                                                                <%= user && user.bio ? user.bio.length : 0 %>/160 chars
                                                            </span>
                                                        </label>
                                                        <textarea name="bio" id="inputBio" class="form-input"
                                                            maxlength="160"
                                                            placeholder="Principal SRE specializing in low-level container runtime anomalies and database architecture..."><%= user ? user.bio || '' : '' %></textarea>
                                                    </div>

                                                    <div class="form-grid-2">
                                                        <div class="form-group">
                                                            <label class="form-label">Location / Timezone</label>
                                                            <input type="text" name="location" id="inputLocation"
                                                                class="form-input"
                                                                value="<%= user ? user.location || '' : '' %>"
                                                                placeholder="San Francisco, CA • UTC-8">
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label">Personal Website or Blog
                                                                URL</label>
                                                            <input type="url" name="website"
                                                                class="form-input font-mono"
                                                                value="<%= user ? user.website || '' : '' %>"
                                                                placeholder="https://yourdomain.dev">
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="settings-card">
                                                    <div class="card-header">
                                                        <div class="card-header-titles">
                                                            <h3>Developer Social Network Links</h3>
                                                            <p>Connect your GitHub and external social identities to
                                                                your public profile.</p>
                                                        </div>
                                                    </div>

                                                    <div class="form-grid-2">
                                                        <div class="form-group">
                                                            <label class="form-label"><i data-lucide="github"
                                                                    style="width:14px;"></i> GitHub Profile URL</label>
                                                            <input type="url" name="githubUrl"
                                                                class="form-input font-mono"
                                                                value="<%= user ? user.githubUrl || '' : '' %>"
                                                                placeholder="https://github.com/username">
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="form-label"><i data-lucide="twitter"
                                                                    style="width:14px;"></i> Twitter / X Profile
                                                                URL</label>
                                                            <input type="url" name="twitterUrl"
                                                                class="form-input font-mono"
                                                                value="<%= user ? user.twitterUrl || '' : '' %>"
                                                                placeholder="https://x.com/username">
                                                        </div>
                                                    </div>
                                                    <div class="form-group" style="max-width: 50%;">
                                                        <label class="form-label"><i data-lucide="linkedin"
                                                                style="width:14px;"></i> LinkedIn Profile URL</label>
                                                        <input type="url" name="linkedinUrl"
                                                            class="form-input font-mono"
                                                            value="<%= user ? user.linkedinUrl || '' : '' %>"
                                                            placeholder="https://linkedin.com/in/username">
                                                    </div>

                                                    <div class="form-footer-row">
                                                        <button type="submit" class="btn-white">
                                                            <i data-lucide="save" style="width:16px;"></i>
                                                            <span>Save Profile Changes</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>
                                        </section>

                                        <!-- SECTION 2: Account Preferences (#account) -->
                                        <section class="settings-section" id="sec-account">
                                            <div class="section-header-row">
                                                <h2 class="section-title"><i data-lucide="shield"
                                                        style="color: #10B981;"></i> Account & Membership Roles</h2>
                                                <p class="section-desc">Review your registered email address, community
                                                    tier status, and workspace telemetry snapshots.</p>
                                            </div>

                                            <div class="settings-card">
                                                <div class="card-header">
                                                    <div class="card-header-titles">
                                                        <h3>Registered Developer Credentials</h3>
                                                        <p>Your email address is secured and verified for automated
                                                            password resets and notification dispatches.</p>
                                                    </div>
                                                    <span class="badge-tag badge-success"><i data-lucide="check"
                                                            style="width:12px;"></i> Verified Email</span>
                                                </div>
                                                <div class="form-grid-2">
                                                    <div class="form-group">
                                                        <label class="form-label">Email Address (Read-only)</label>
                                                        <input type="email" class="form-input font-mono" disabled
                                                            value="<%= user ? user.email || 'developer@devsolved.com' : 'developer@devsolved.com' %>"
                                                            style="opacity: 0.7;">
                                                    </div>
                                                    <div class="form-group">
                                                        <label class="form-label">Workspace User UUID</label>
                                                        <div style="display:flex; gap:8px;">
                                                            <input type="text" id="userUuidField"
                                                                class="form-input font-mono" disabled
                                                                value="<%= user ? user._id || 'usr_29f8a7d6e5c4b3a' : 'usr_29f8a7d6e5c4b3a' %>"
                                                                style="opacity: 0.7;">
                                                            <button type="button" class="btn-outline"
                                                                onclick="copyText('userUuidField', 'Workspace UUID copied!')"
                                                                style="padding:10px 14px;">Copy</button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="settings-card">
                                                <div class="card-header">
                                                    <div class="card-header-titles">
                                                        <h3>Community Tier & Reputation Status</h3>
                                                        <p>You have full write privileges for documenting un-Googleable
                                                            production bugs and evaluating community fixes.</p>
                                                    </div>
                                                </div>
                                                <div
                                                    style="display: flex; align-items: center; gap: 20px; background: #000; padding: 20px; border-radius: 14px; border: 1px solid var(--border-faint);">
                                                    <div class="session-icon"
                                                        style="width: 52px; height: 52px; color: #F59E0B; background: rgba(245, 158, 11, 0.1); border-color: rgba(245, 158, 11, 0.3);">
                                                        <i data-lucide="award" style="width:26px; height:26px;"></i>
                                                    </div>
                                                    <div>
                                                        <h4
                                                            style="font-size: 16px; font-weight: 700; color: #FFF; margin-bottom: 4px;">
                                                            DevSolved Community Pro Engineer</h4>
                                                        <p style="font-size: 13px; color: var(--text-secondary);">
                                                            Unlimited hybrid BM25 semantic searches • Global leaderboard
                                                            voting power x1.5</p>
                                                    </div>
                                                    <span style="margin-left: auto;"
                                                        class="badge-tag badge-success">Active Member</span>
                                                </div>
                                            </div>

                                            <div class="settings-card">
                                                <div class="card-header">
                                                    <div class="card-header-titles">
                                                        <h3>Workspace Data Snapshot</h3>
                                                        <p>Download a complete JSON backup of your documented war
                                                            stories, bookmarks, and developer telemetry settings.</p>
                                                    </div>
                                                    <button type="button" class="btn-outline"
                                                        onclick="downloadDataSnapshot()">
                                                        <i data-lucide="download" style="width:15px;"></i>
                                                        <span>Export Workspace Dump</span>
                                                    </button>
                                                </div>
                                            </div>
                                        </section>

                                        <!-- SECTION 3: Notifications & Telemetry (#notifications) -->
                                        <section class="settings-section" id="sec-notifications">
                                            <div class="section-header-row">
                                                <h2 class="section-title"><i data-lucide="bell-ring"
                                                        style="color: #F59E0B;"></i> Notifications & Feed Telemetry</h2>
                                                <p class="section-desc">Customize which developer dispatches reach your
                                                    terminal inbox and control background telemetry noise.</p>
                                            </div>

                                            <div class="settings-card">
                                                <div class="card-header">
                                                    <div class="card-header-titles">
                                                        <h3>Email & System Alert Rules</h3>
                                                        <p>Changes made here immediately synchronize with your active
                                                            `/notifications` feed controller.</p>
                                                    </div>
                                                    <a href="/notifications" class="btn-outline"
                                                        style="padding: 7px 14px; font-size: 12px;">
                                                        <span>Open Notification Center</span>
                                                        <i data-lucide="arrow-up-right" style="width:14px;"></i>
                                                    </a>
                                                </div>

                                                <div class="toggle-card-item">
                                                    <div class="toggle-label">
                                                        <h4>Weekly Tech-Stack Telemetry Digest</h4>
                                                        <p>Receive our curated weekly compilation of high-severity
                                                            production postmortems matching Node.js, Docker & MongoDB.
                                                        </p>
                                                    </div>
                                                    <div
                                                        style="display: flex; align-items: center; gap: 14px; flex-shrink: 0;">
                                                        <div id="badge_toggleDigest"
                                                            class="toggle-status-badge <%= (!user || !user.notifications || user.notifications.digest !== false) ? 'enabled' : 'muted' %>">
                                                            <span>
                                                                <%= (!user || !user.notifications ||
                                                                    user.notifications.digest !==false) ? '● ENABLED'
                                                                    : '○ MUTED' %>
                                                            </span>
                                                        </div>
                                                        <div class="custom-switch"
                                                            onclick="handleNotificationClick(event, 'toggleDigest', 'weeklyDigest', 'Weekly Telemetry Digest')"
                                                            style="cursor: pointer;" title="Click to toggle preference">
                                                            <input type="checkbox" id="toggleDigest" <%=(!user ||
                                                                !user.notifications || user.notifications.digest
                                                                !==false) ? 'checked' : '' %> tabindex="-1"
                                                            style="pointer-events: none;">
                                                            <span class="slider" style="pointer-events: none;"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="toggle-card-item">
                                                    <div class="toggle-label">
                                                        <h4>Discussion Mentions & Comment Thread Replies</h4>
                                                        <p>Immediate dispatch when an engineer tags your `@username` or
                                                            answers your root cause hypothesis.</p>
                                                    </div>
                                                    <div
                                                        style="display: flex; align-items: center; gap: 14px; flex-shrink: 0;">
                                                        <div id="badge_toggleMentions"
                                                            class="toggle-status-badge <%= (!user || !user.notifications || user.notifications.mentions !== false) ? 'enabled' : 'muted' %>">
                                                            <span>
                                                                <%= (!user || !user.notifications ||
                                                                    user.notifications.mentions !==false) ? '● ENABLED'
                                                                    : '○ MUTED' %>
                                                            </span>
                                                        </div>
                                                        <div class="custom-switch"
                                                            onclick="handleNotificationClick(event, 'toggleMentions', 'mentionsAlerts', 'Discussion Mentions & Replies')"
                                                            style="cursor: pointer;" title="Click to toggle preference">
                                                            <input type="checkbox" id="toggleMentions" <%=(!user ||
                                                                !user.notifications || user.notifications.mentions
                                                                !==false) ? 'checked' : '' %> tabindex="-1"
                                                            style="pointer-events: none;">
                                                            <span class="slider" style="pointer-events: none;"></span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="toggle-card-item">
                                                    <div class="toggle-label">
                                                        <h4>Verified Solution & Reputation Awards (+50 Rep)</h4>
                                                        <p>High-priority alert when your architectural solution is
                                                            marked as Verified Resolved on an incident.</p>
                                                    </div>
                                                    <div
