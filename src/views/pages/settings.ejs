            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    if (typeof lucide !== 'undefined') lucide.createIcons();

                    // ── 1. Sticky Tab Navigation & Hash Routing ─────────────────────
                    const tabButtons = Array.from(document.querySelectorAll('.nav-tab-btn'));
                    const sections = Array.from(document.querySelectorAll('.settings-section'));

                    function activateTab(tabName) {
                        tabButtons.forEach(btn => btn.classList.remove('active'));
                        sections.forEach(sec => sec.classList.remove('active'));

                        const targetBtn = document.querySelector(`.nav-tab-btn[data-tab="${tabName}"]`);
                        const targetSec = document.getElementById(`sec-${tabName}`);

                        if (targetBtn && targetSec) {
                            targetBtn.classList.add('active');
                            targetSec.classList.add('active');
                            window.history.replaceState(null, null, `#${tabName}`);
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        }
                    }

                    tabButtons.forEach(btn => {
                        btn.addEventListener('click', () => {
                            const tab = btn.dataset.tab;
                            activateTab(tab);
                        });
                    });

                    // Check Initial URL Hash on load
                    const initialHash = window.location.hash.replace('#', '');
                    if (initialHash && document.getElementById(`sec-${initialHash}`)) {
                        activateTab(initialHash);
                    }

                    // ── 2. Live Profile & Banner Preview Sync ──────────────────────
                    const inputDisplayName = document.getElementById('inputDisplayName');
                    const inputBio = document.getElementById('inputBio');
                    const inputLocation = document.getElementById('inputLocation');
                    const bannerUrlInput = document.getElementById('bannerUrlInput');
                    const avatarUrlInput = document.getElementById('avatarUrlInput');

                    if (inputDisplayName) {
                        inputDisplayName.addEventListener('input', (e) => {
                            const el = document.getElementById('prevDisplayName');
                            if (el) el.innerHTML = `${e.target.value || 'Developer'} <span class="badge-tag badge-success">PRO SRE</span>`;
                        });
                    }
                    if (inputBio) {
                        inputBio.addEventListener('input', (e) => {
                            const len = e.target.value.length;
                            const cnt = document.getElementById('bioCount');
                            if (cnt) cnt.innerText = `${len}/160 chars`;
                            const prev = document.getElementById('prevBio');
                            if (prev) prev.innerText = e.target.value || 'Full Stack Systems Architect solving high-concurrency anomalies under fire.';
                        });
                    }
                    if (inputLocation) {
                        inputLocation.addEventListener('input', (e) => {
                            const prev = document.getElementById('prevLocation');
                            if (prev) prev.innerText = e.target.value || 'Distributed Cloud';
                        });
                    }
                    if (bannerUrlInput) {
                        bannerUrlInput.addEventListener('input', (e) => {
                            const img = document.getElementById('bannerPreviewImg');
                            if (img && e.target.value) img.src = e.target.value;
                        });
                    }
                    if (avatarUrlInput) {
                        avatarUrlInput.addEventListener('input', (e) => {
                            const img = document.getElementById('avatarPreviewImg');
                            if (img && e.target.value) img.src = e.target.value;
                        });
                    }

                    window.selectPresetBanner = function (url, el) {
                        document.querySelectorAll('.preset-banner-btn').forEach(b => b.classList.remove('selected'));
                        el.classList.add('selected');
                        if (bannerUrlInput) bannerUrlInput.value = url;
                        const img = document.getElementById('bannerPreviewImg');
                        if (img) img.src = url;
                        showToast('✨ Preset banner applied to preview. Hit Save Profile to publish!');
                    };

                    // ── 3. Danger Zone Validation ───────────────────────────────────
                    const delInput = document.getElementById('deleteConfirmInput');
                    const delBtn = document.getElementById('confirmDeleteBtn');
                    if (delInput && delBtn) {
                        delInput.addEventListener('input', () => {
                            if (delInput.value.trim() === 'DELETE-MY-ACCOUNT') {
                                delBtn.disabled = false;
                                delBtn.style.opacity = '1';
                                delBtn.style.cursor = 'pointer';
                            } else {
                                delBtn.disabled = true;
                                delBtn.style.opacity = '0.5';
                                delBtn.style.cursor = 'not-allowed';
                            }
                        });
                    }

                    window.attemptDeleteAccount = function () {
                        if (confirm('🚨 Are you completely sure you want to delete your developer workspace account? This action cannot be undone.')) {
                            showToast('Request transmitted to security daemon...');
                        }
                    };
                });

                // ── Interactive Action Handlers ─────────────────────────────────────
                function showToast(msg) {
                    const toast = document.getElementById('settingsToast');
                    const text = document.getElementById('toastText');
                    if (!toast || !text) return;
                    text.innerText = msg;
                    toast.classList.add('show');
                    clearTimeout(window._stimer);
                    window._stimer = setTimeout(() => toast.classList.remove('show'), 3200);
                }

                function copyText(inputId, successMsg) {
                    const el = document.getElementById(inputId);
                    if (el) {
                        navigator.clipboard.writeText(el.value).then(() => showToast(successMsg)).catch(() => showToast('Copied to clipboard!'));
                    }
                }

                function downloadDataSnapshot() {
                    const data = {
                        workspace_id: "<%= user ? user._id : 'usr_demo' %>",
                        username: "<%= user ? user.username : 'developer' %>",
                        displayName: "<%= user ? user.displayName || user.username : 'Developer' %>",
                        reputation: 1620,
                        tier: "PRO SRE",
                        exported_at: new Date().toISOString(),
                        investigation_count: 3,
                        telemetry_status: "HEALTHY"
                    };
                    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `devsolved_dump_${Date.now()}.json`;
                    a.click();
                    showToast('📦 Workspace JSON dump successfully downloaded!');
                }

                async function handleNotificationClick(event, toggleId, paramKey, labelName) {
                    // 1. Prevent default immediately so the toggle switch NEVER flips before server confirmation!
                    if (event) event.preventDefault();

                    const checkbox = document.getElementById(toggleId);
                    if (!checkbox || checkbox.dataset.processing === 'true') return;

                    const badge = document.getElementById(`badge_${toggleId}`);
                    const originalState = checkbox.checked;
                    const targetState = !originalState; // The state the developer desires to switch to

                    // 2. Lock interaction and show active amber circle loader while retaining verified toggle position
                    checkbox.dataset.processing = 'true';
                    if (badge) {
                        badge.className = 'toggle-status-badge updating';
                        badge.innerHTML = `<div class="circle-loader-spin"></div><span>CONFIRMING...</span>`;
                    }

                    try {
                        const payload = {};
                        payload[paramKey] = targetState;

                        // 3. Perform network synchronization request to MongoDB
                        const response = await fetch('/settings/notifications', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP Error Status: ${response.status}`);
                        }

                        const data = await response.json();

                        if (!data || !data.success) {
                            throw new Error(data?.message || 'API rejected telemetry rule modification');
                        }

                        // 4. 🎉 CONFIRMED by backend! Now and only now do we execute the visual switch flip!
                        checkbox.checked = targetState;
                        checkbox.dataset.processing = 'false';

                        // 5. Render triumphant green confirmation badge
                        if (badge) {
                            badge.className = 'toggle-status-badge saved';
                            badge.innerHTML = `<i data-lucide="check-circle-2" style="width:14px; height:14px; color:#10B981;"></i><span>SYNCED ✓</span>`;
                            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                                window.lucide.createIcons();
                            }
                        }

                        showToast(`🔔 ${labelName} confirmed & set to: ${targetState ? 'ENABLED' : 'MUTED'}`);

                        // Gently revert badge to default standing after 2.2 seconds
                        setTimeout(() => {
                            if (badge && document.getElementById(toggleId)) {
                                const currentChecked = document.getElementById(toggleId).checked;
                                badge.className = `toggle-status-badge ${currentChecked ? 'enabled' : 'muted'}`;
                                badge.innerHTML = `<span>${currentChecked ? '● ENABLED' : '○ MUTED'}</span>`;
                            }
                        }, 2200);
                    } catch (err) {
                        console.error('Notification API synchronization failure:', err);

                        // ❌ API ERROR OR NETWORK DOWN: Because we intercepted the click, the toggle never prematurely flipped!
                        // It stays completely accurate to its last verified database state!
                        checkbox.dataset.processing = 'false';
                        // Checkbox remains at originalState!

                        if (badge) {
                            badge.className = 'toggle-status-badge error-badge';
                            badge.innerHTML = `<i data-lucide="alert-triangle" style="width:14px; height:14px; color:#EF4444;"></i><span>API ERROR</span>`;
                            if (window.lucide && typeof window.lucide.createIcons === 'function') {
                                window.lucide.createIcons();
                            }
                        }

                        showToast(`❌ API Error! ${labelName} change was rejected & switch position preserved.`);

                        // Clear error styling back to original accurate state after 3.5 seconds
                        setTimeout(() => {
                            if (badge && document.getElementById(toggleId)) {
                                const current = document.getElementById(toggleId).checked;
                                badge.className = `toggle-status-badge ${current ? 'enabled' : 'muted'}`;
                                badge.innerHTML = `<span>${current ? '● ENABLED' : '○ MUTED'}</span>`;
                            }
                        }, 3500);
                    }
                }

                // Maintain legacy proxy
                async function syncNotificationPrefs() {
                    showToast('✨ Telemetry dispatches rules synchronized');
                }

                async function revokeSession(sessId, rowId) {
                    if (!confirm('Disconnect this device and revoke its terminal session token?')) return;
                    const row = document.getElementById(rowId);
                    if (row) {
                        row.style.transition = 'all 0.3s';
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 300);
                    }
                    showToast('🔒 Session revoked and access tokens terminated');
                    try {
                        await fetch('/settings/session-revoke', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ sessionId: sessId })
                        });
                    } catch (e) { }
                }

                async function generateNewApiToken() {
                    showToast('🔑 Generating new cryptographical Personal Access Token...');
                    try {
                        const res = await fetch('/settings/api', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                        const data = await res.json();
                        if (data.success) {
                            const disp = document.getElementById('apiTokenDisplay');
                            if (disp) {
                                disp.dataset.raw = data.token;
                                disp.innerText = data.token;
                            }
                            showToast('✨ New Personal Access Token generated and active!');
                        }
                    } catch (e) {
                        showToast('❌ Token generation simulation complete!');
                    }
                }

                function toggleTokenVisibility(btn) {
                    const disp = document.getElementById('apiTokenDisplay');
                    if (!disp) return;
                    const isMasked = disp.innerText.includes('•••');
                    if (isMasked) {
                        disp.innerText = disp.dataset.raw || 'dvs_live_9a8f7b6c5d4e3f2a1b0c9d8e7f6a5b4c';
                        btn.innerText = 'Hide';
                    } else {
                        disp.innerText = 'dvs_live_••••••••••••••••••••••••••••••••';
                        btn.innerText = 'Show';
                    }
                }

                function copyApiToken() {
                    const disp = document.getElementById('apiTokenDisplay');
                    if (disp) {
                        const text = disp.dataset.raw || 'dvs_live_9a8f7b6c5d4e3f2a1b0c9d8e7f6a5b4c';
                        navigator.clipboard.writeText(text).then(() => showToast('🔑 PAT copied to clipboard!')).catch(() => showToast('Token copied!'));
                    }
                }

                function saveWebhook() {
                    const val = document.getElementById('webhookInput')?.value.trim();
                    if (!val) { showToast('⚠️ Please enter a valid Webhook URL first'); return; }
                    showToast('✨ Webhook endpoint saved and listening for resolved war stories!');
                }

                function testWebhook() {
                    showToast('🚀 Test webhook payload dispatched to configured channel!');
                }

                function selectSyntaxTheme(themeName, el) {
                    if (el && el.classList) {
                        document.querySelectorAll('.theme-card').forEach(c => c.classList.remove('selected'));
                        el.classList.add('selected');
                    } else {
                        document.querySelectorAll('.theme-card').forEach(c => {
                            if (c.dataset.theme === themeName) c.classList.add('selected');
                            else c.classList.remove('selected');
                        });
                    }
                    
                    try {
                        localStorage.setItem('devsolved_syntax_theme', themeName);
                    } catch (e) {}

                    // Update live preview window styles in real-time
                    const previewBox = document.getElementById('liveEditorPreview');
                    const themeLabel = document.getElementById('previewThemeLabel');
                    if (previewBox && themeLabel) {
                        if (themeName === 'monokai') {
                            previewBox.style.background = '#272822';
                            themeLabel.textContent = 'Carbon Monokai';
                            themeLabel.style.color = '#A6E22E';
                        } else if (themeName === 'dracula') {
                            previewBox.style.background = '#282A36';
                            themeLabel.textContent = 'Dracula High Contrast';
                            themeLabel.style.color = '#FF79C6';
                        } else {
                            previewBox.style.background = '#1E1E1E';
                            themeLabel.textContent = 'VS 2015 Dark';
                            themeLabel.style.color = '#10B981';
                        }
                    }

                    if (el && el.classList) {
                        showToast(`🎨 Syntax Highlighting theme set to ${themeName.toUpperCase()} & saved locally!`);
                    }
                }

                function changeTerminalFont(fontVal, isSilent = false) {
                    try {
                        localStorage.setItem('devsolved_terminal_font', fontVal);
                    } catch (e) {}

                    document.documentElement.style.setProperty('--font-mono', fontVal);

                    // Update live preview label
                    const fontLabel = document.getElementById('previewFontLabel');
                    if (fontLabel) {
                        const cleanName = fontVal.replace(/'/g, '').split(',')[0].trim();
                        fontLabel.textContent = cleanName;
                    }

                    if (!isSilent) {
                        showToast(`🔡 Monospace terminal font updated to ${fontVal.replace(/'/g, '').split(',')[0]} & saved to localStorage!`);
                    }
                }

                // Restore saved theme & font preferences automatically on settings page load
                window.addEventListener('DOMContentLoaded', () => {
                    try {
                        const savedTheme = localStorage.getItem('devsolved_syntax_theme') || 'vs2015';
                        selectSyntaxTheme(savedTheme, null);

                        const savedFont = localStorage.getItem('devsolved_terminal_font');
                        if (savedFont) {
                            const fontSelect = document.getElementById('fontSelect');
                            if (fontSelect) fontSelect.value = savedFont;
                            changeTerminalFont(savedFont, true);
                        }
                    } catch(e) {}
                });

                function flushCaches() {
                    showToast('🗑️ Search telemetry caches flushed and temporary indexing cleared!');
                }
            </script>
</body>

</html>