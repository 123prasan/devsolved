<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head', { useLottie: true }) %>
        <style>
            :root {
                --bg-base: #000000;
                --bg-surface: #0A0A0C;
                --border-color: rgba(255, 255, 255, 0.08);
                --border-hover: rgba(255, 255, 255, 0.15);
                --border-focus: rgba(255, 255, 255, 0.3);
                --text-primary: #FFFFFF;
                --text-secondary: #A1A1AA;
                --text-muted: #62626C;
                --accent-success: #10B981;
                --accent-error: #EF4444;
                --accent-info: #3B82F6;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Inter', sans-serif;
                background-color: var(--bg-base);
                color: var(--text-primary);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                overflow: hidden;
                height: 100vh;
            }

            .auth-layout {
                overflow-y: auto;
                height: 100vh;
                width: 100vw;
            }

            .auth-side-form {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 40px 24px;
                overflow-y: auto;
                position: relative;
                background: var(--bg-base);
            }

            .auth-side-hero {
                position: relative;
                background: #030305;
                border-left: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 64px;
                overflow: hidden;
            }

            .hero-glow-orb {
                position: absolute;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.15) 40%, transparent 70%);
                filter: blur(60px);
                border-radius: 50%;
                z-index: 0;
                animation: pulseGlow 6s ease-in-out infinite alternate;
            }

            @keyframes pulseGlow {
                0% {
                    transform: scale(0.9) translate(0, 0);
                    opacity: 0.6;
                }

                100% {
                    transform: scale(1.1) translate(-20px, 20px);
                    opacity: 1;
                }
            }

            .hero-content {
                position: relative;
                z-index: 10;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            .hero-text {
                margin-top: 40px;
                max-width: 480px;
                animation: fadeUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
                animation-delay: 0.2s;
                opacity: 0;
            }

            .hero-text h2 {
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -1px;
                margin-bottom: 16px;
                background: linear-gradient(135deg, #FFFFFF 0%, #A1A1AA 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .hero-text p {
                font-size: 16px;
                color: var(--text-secondary);
            }

            .auth-wrapper {
                width: 100%;
                max-width: 420px;
                margin: auto;
                animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }

            .brand-header {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                font-weight: 700;
                font-size: 20px;
                color: var(--text-primary);
                letter-spacing: -0.5px;
                text-decoration: none;
                margin-bottom: 32px;
            }

            .brand-logo-img {
                width: 36px;
                height: 36px;
                object-fit: contain;
                display: block;
                transition: transform 0.2s ease;
                filter: drop-shadow(0 4px 12px rgba(255, 255, 255, 0.1));
            }

            .brand-header:hover .brand-logo-img {
                transform: scale(1.05);
            }

            .auth-card {
                background: rgba(10, 10, 12, 0.8);
                backdrop-filter: blur(24px);
                border: 1px solid var(--border-color);
                border-radius: 24px;
                padding: 40px 32px;
                box-shadow: 0 24px 80px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.05);
                position: relative;
            }

            .auth-title {
                font-size: 26px;
                font-weight: 600;
                letter-spacing: -0.8px;
                margin-bottom: 6px;
                text-align: center;
            }

            .auth-subtitle {
                font-size: 14px;
                color: var(--text-secondary);
                text-align: center;
                margin-bottom: 32px;
            }

            .error-alert {
                background: rgba(239, 68, 68, 0.08);
                border: 1px solid rgba(239, 68, 68, 0.2);
                color: #FCA5A5;
                font-size: 13px;
                padding: 10px 14px;
                border-radius: 10px;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .oauth-group {
                display: flex;
                flex-direction: column;
                gap: 12px;
                margin-bottom: 24px;
            }

            .btn-oauth {
                background: transparent;
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 12px 16px;
                border-radius: 999px;
                font-size: 14px;
                font-weight: 500;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 12px;
                cursor: pointer;
                transition: all 0.2s;
                width: 100%;
                font-family: 'Inter', sans-serif;
            }

            .btn-oauth:hover {
                background: rgba(255, 255, 255, 0.03);
                border-color: var(--border-hover);
                transform: translateY(-1px);
            }

            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                color: var(--text-muted);
                font-size: 12px;
                font-family: 'JetBrains Mono', monospace;
                text-transform: uppercase;
                margin-bottom: 24px;
            }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid var(--border-color);
            }

            .divider::before {
                margin-right: 12px;
            }

            .divider::after {
                margin-left: 12px;
            }

            .auth-form {
                display: flex;
                flex-direction: column;
            }

            .input-group {
                display: flex;
                flex-direction: column;
                gap: 8px;
                padding-bottom: 16px;
            }

            .input-label {
                font-size: 13px;
                font-weight: 500;
                color: var(--text-secondary);
                margin-left: 4px;
            }

            .input-wrapper {
                position: relative;
                width: 100%;
            }

            .input-icon-left {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                width: 18px;
                height: 18px;
                pointer-events: none;
            }

            .input-field {
                width: 100%;
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-color);
                color: var(--text-primary);
                padding: 12px 16px 12px 44px;
                border-radius: 12px;
                font-family: inherit;
                font-size: 14px;
                outline: none;
                transition: all 0.2s ease;
            }

            .input-field::placeholder {
                color: var(--text-muted);
            }

            .input-field:focus {
                background: rgba(255, 255, 255, 0.06);
                border-color: var(--border-focus);
                box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.05);
            }

            .btn-primary {
                background: var(--text-primary);
                color: var(--bg-base);
                border: none;
                padding: 14px;
                border-radius: 999px;
                font-size: 15px;
                font-weight: 600;
                cursor: pointer;
                width: 100%;
                margin-top: 8px;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: 0 4px 14px rgba(255, 255, 255, 0.15);
                display: flex;
                align-items: center;
                justify-content: center;
                height: 50px;
                font-family: 'Inter', sans-serif;
            }

            .btn-primary:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(255, 255, 255, 0.25);
            }

            .auth-footer {
                text-align: center;
                margin-top: 24px;
                font-size: 14px;
                color: var(--text-secondary);
            }

            .auth-footer a {
                color: var(--text-primary);
                font-weight: 500;
                text-decoration: none;
            }

            .auth-footer a:hover {
                text-decoration: underline;
            }

            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            @media (max-width: 960px) {
                .auth-layout {}

                .auth-side-hero {
                    display: none;
                }

                body {
                    height: auto;
                    min-height: 100vh;
                    overflow: auto;
                }

                .auth-side-form {
                    height: 100vh;
                }
            }

            @media (max-width: 480px) {
                .auth-side-form {
                    padding: 32px 16px;
                }

                .auth-card {
                    padding: 32px 20px;
                    border-radius: 20px;
                }
            }
        </style>
</head>

<body>
    <div class="auth-layout">
        <!-- Left: Form -->
        <div class="auth-side-form">
            <div class="auth-wrapper">
                <a href="/" class="brand-header" aria-label="DevSolved Home">
                    <img src="/images/devsolved.svg" alt="DevSolved Logo" class="brand-logo-img">
                    <span>DevSolved</span>
                </a>
                <div class="auth-card">
                    <% const isSignup=typeof mode !=='undefined' && mode==='signup' ; %>
                        <h1 class="auth-title" id="authTitle">
                            <%= isSignup ? 'Create an account' : 'Welcome back' %>
                        </h1>
                        <p class="auth-subtitle">
                            <%= isSignup ? 'Join the developer community' : 'Log in to your account to continue' %>
                        </p>

                        <% if (typeof error !=='undefined' && error) { %>
                            <% if (error.toLowerCase().includes('successful') || error.toLowerCase().includes('verify'))
                                { %>
                                <div class="error-alert"
                                    style="background: rgba(16, 185, 129, 0.1); border-color: rgba(16, 185, 129, 0.3); color: #10B981;">
                                    <i data-lucide="check-circle" style="width:16px; flex-shrink:0;"></i>
                                    <%= error %>
                                </div>
                                <% } else { %>
                                    <div class="error-alert">
                                        <i data-lucide="alert-triangle" style="width:16px; flex-shrink:0;"></i>
                                        <%= error %>
                                    </div>
                                    <% } %>
                                        <% } %>

                                            <!-- OAuth -->
                                            <div class="oauth-group">
                                                <a href="/auth/google" class="btn-oauth" style="text-decoration:none;">
                                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
                                                        style="width:18px;height:18px;">
                                                        <path
                                                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                                                            fill="#4285F4" />
                                                        <path
                                                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                                                            fill="#34A853" />
                                                        <path
                                                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                                                            fill="#FBBC05" />
                                                        <path
                                                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                                                            fill="#EA4335" />
                                                    </svg>
                                                    Continue with Google
                                                </a>
                                                <a href="/auth/github" class="btn-oauth" style="text-decoration:none;">
                                                    <i data-lucide="github" style="width:18px;"></i>
                                                    Continue with GitHub
                                                </a>
                                            </div>
                                            <div class="divider">or continue with email</div>

                                            <!-- Form -->
                                            <form class="auth-form" method="POST"
                                                action="<%= isSignup ? '/signup' : '/login' %>">
                                                <input type="hidden" name="next"
                                                    value="<%= typeof next !== 'undefined' ? next : '/' %>">
                                                <% if (isSignup) { %>
                                                    <div class="input-group">
                                                        <label class="input-label">Full Name</label>
                                                        <div class="input-wrapper">
                                                            <input type="text" class="input-field" name="displayName"
                                                                placeholder="John Doe" required>
                                                            <i data-lucide="user" class="input-icon-left"></i>
                                                        </div>
                                                    </div>
                                                    <div class="input-group">
                                                        <label class="input-label">Username</label>
                                                        <div class="input-wrapper">
                                                            <input type="text" class="input-field" name="username"
                                                                placeholder="johndoe" required
                                                                style="padding-left: 44px;">
                                                            <i data-lucide="at-sign" class="input-icon-left"></i>
                                                        </div>
                                                    </div>
                                                    <% } %>
                                                        <div class="input-group">
                                                            <label class="input-label">Email Address</label>
                                                            <div class="input-wrapper">
                                                                <input type="email" class="input-field" name="email"
                                                                    placeholder="you@example.com" required>
                                                                <i data-lucide="mail" class="input-icon-left"></i>
                                                            </div>
                                                        </div>
                                                        <div class="input-group">
                                                            <label class="input-label">Password</label>
                                                            <div class="input-wrapper">
                                                                <input type="password" class="input-field"
                                                                    name="password" placeholder="••••••••" required
                                                                    minlength="<%= isSignup ? 8 : 1 %>">
                                                                <i data-lucide="lock" class="input-icon-left"></i>
                                                            </div>
                                                        </div>
                                                        <button type="submit" class="btn-primary">
                                                            <%= isSignup ? 'Create Account' : 'Log In' %>
                                                        </button>
                                            </form>
                                            <div class="auth-footer">
                                                <% if (isSignup) { %>
                                                    Already have an account? <a href="/login">Log in</a>
                                                    <% } else { %>
                                                        Don't have an account? <a href="/signup">Sign up</a>
                                                        <% } %>
                                            </div>
                </div>
            </div>
        </div>
        <!-- Right: Hero -->

    </div>
    <script>lucide.createIcons();</script>
</body>

</html>